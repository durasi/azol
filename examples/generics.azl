// Structs and functions with type parameters: written once, compiled
// for each combination of types they are used with.

struct Stack[T] {
    items: List[T]
}

struct Pair[A, B] {
    first: A
    second: B
}

fn push[T](stack: mut Stack[T], item: T) {
    stack.items.push(item)
}

fn pop[T](stack: mut Stack[T]) -> Option[T] {
    if stack.items.len() == 0 { return None }
    return Some(stack.items.pop())
}

fn zip[A, B](left: List[A], right: List[B]) -> List[Pair[A, B]] {
    var pairs: List[Pair[A, B]] = []
    for i, item in left {
        if i < right.len() { pairs.push(Pair { first: item, second: right[i] }) }
    }
    return pairs
}

fn main() {
    var undo: Stack[str] = Stack { items: [] }
    push(mut undo, "typed hello")
    push(mut undo, "deleted a line")
    match pop(mut undo) {
        Some(action) => print("undo: " + action)
        None => print("nothing to undo")
    }

    var depths = Stack { items: [3, 5] }
    push(mut depths, 8)
    print(depths.items.reversed().contains(8))

    for pair in zip(["ada", "grace", "linus"], [1815, 1906]) {
        print(pair.first + " was born in " + str(pair.second))
    }
}
