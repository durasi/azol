// Value semantics: `b` is a copy, changing it does not change `a`.
struct Point {
    x: f64
    y: f64
}

fn distance(a: Point, b: Point) -> f64 {
    let dx = a.x - b.x
    let dy = a.y - b.y
    return sqrt(dx * dx + dy * dy)
}

fn shift(p: mut Point, dx: f64) {
    p.x = p.x + dx
}

fn find(list: List[i32], wanted: i32) -> Option[i32] {
    for i, value in list {
        if value == wanted { return Some(i) }
    }
    return None
}

fn main() {
    let a = Point { x: 1.0, y: 2.0 }
    var b = a
    shift(mut b, 3.0)
    print(distance(a, b))

    let numbers = [3, 7, 9]
    match find(numbers, 7) {
        Some(i) => print(i)
        None => print("not found")
    }
}
