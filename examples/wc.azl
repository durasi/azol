// Counts the lines, words and bytes of the files named on the command
// line, like the Unix tool `wc`.
//
//     azol build examples/wc.azl
//     ./examples/wc README.md src/main.rs

struct Counts {
    lines: i64
    words: i64
    bytes: i64
}

fn count(text: str) -> Counts {
    var counts = Counts { lines: 0, words: 0, bytes: text.len() }
    var in_word = false
    var i = 0
    while i < text.len() {
        let c = text[i]
        if c == 10 {
            counts.lines = counts.lines + 1
        }
        if c == 32 || c == 9 || c == 10 || c == 13 {
            in_word = false
        } else if !in_word {
            in_word = true
            counts.words = counts.words + 1
        }
        i = i + 1
    }
    return counts
}

fn main() -> i64 {
    let arguments = args()
    if arguments.len() < 2 {
        eprint("usage: wc <file> ...")
        return 2
    }
    var failed = 0
    for i, path in arguments {
        if i == 0 {
            continue
        }
        match read_file(path) {
            Ok(text) => {
                let c = count(text)
                print(str(c.lines) + " " + str(c.words) + " " + str(c.bytes) + " " + path)
            }
            Err(problem) => {
                eprint("wc: " + path + ": " + problem)
                failed = 1
            }
        }
    }
    return failed
}
