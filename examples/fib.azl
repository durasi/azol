// The first program azoL compiles to a real executable.
//
//     azol build examples/fib.azl
//     ./examples/fib

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn main() {
    var i = 0
    while i <= 30 {
        print(fib(i))
        i = i + 5
    }
}
