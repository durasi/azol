// The functions imported from the system library, in the order of
// their slots.
fn art_imports() -> List[str] {
    return ["_write", "_exit", "_malloc", "_realloc", "_free", "_memcpy",
        "_memcmp", "_open", "_read", "_close", "___error", "_strerror",
        "_strlen", "__NSGetArgc", "__NSGetArgv", "_chmod", "_sigaltstack", "_sigaction",
        "__exit", "_unlink", "_rename", "_clock_gettime_nsec_np"]
}

// Where each item of the runtime's text starts in it.
fn art_data_offsets() -> List[i64] {
    return [0, 1, 5, 10, 33, 58, 87, 107, 132, 171, 427]
}

