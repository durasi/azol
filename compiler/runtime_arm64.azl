// Linux: address the executable file is mapped at.
const ALR_BASE = 4194304
// Where in the file, and so after `ALR_BASE`, the library starts.
const ALR_TEXT_OFFSET = 256
// Size of the library: the file `runtime/linux_arm64/runtime.bin`.
const ALR_TEXT_SIZE = 6448
// Offset in it of the code the system starts the process at.
const ALR_START = 16
// Address and size of the library's writable memory.
const ALR_MEMORY = 1073741824
const ALR_MEMORY_SIZE = 176
// The runtime's own writable memory follows the library's there:
// where it starts, and the size of the two together.
const ALR_RUNTIME_MEMORY = 1073742000
const ALR_MEMORY_TOTAL = 304

// Offset in the library of each imported function, in the order of
// `art_imports`.
fn alr_import_offsets() -> List[i64] {
    return [548, 596, 648, 728, 2108, 2164, 3044, 0, 3216, 3264, 3320, 3332,
        4564, 4588, 4600, 4612, 4848, 4880, 4892, 4672, 4732, 4792]
}
