// Binary output. A file being built is a `str` used as a buffer of
// bytes: `push` adds a byte, `set` replaces one and an index reads one,
// all of them in place, which the linkers need: instructions are
// completed after the code has been copied in, and the signature hashes
// the file it is appended to. The buffer is what `write_file` takes.

fn put8(out: mut str, value: i64) {
    out.push(value)
}

// Little-endian numbers: lowest byte first.
fn put16(out: mut str, value: i64) {
    out.push(value)
    out.push(value >> 8)
}

fn put32(out: mut str, value: i64) {
    out.push(value)
    out.push(value >> 8)
    out.push(value >> 16)
    out.push(value >> 24)
}

fn put64(out: mut str, value: i64) {
    put32(mut out, value)
    put32(mut out, value >> 32)
}

// Big-endian numbers: highest byte first.
fn put32_be(out: mut str, value: i64) {
    out.push(value >> 24)
    out.push(value >> 16)
    out.push(value >> 8)
    out.push(value)
}

fn put64_be(out: mut str, value: i64) {
    put32_be(mut out, value >> 32)
    put32_be(mut out, value)
}

// The bytes of a string.
fn put_text(out: mut str, text: str) {
    out = out + text
}

// Adds `byte` until the output is `length` bytes long.
fn pad_to(out: mut str, length: i64, byte: i64) {
    while out.len() < length {
        out.push(byte)
    }
}

// Replaces the four bytes at `at` with a little-endian number.
fn patch32(out: mut str, at: i64, value: i64) {
    out.set(at, value)
    out.set(at + 1, value >> 8)
    out.set(at + 2, value >> 16)
    out.set(at + 3, value >> 24)
}

// `value` rounded up to a multiple of `to`.
fn align_up(value: i64, to: i64) -> i64 {
    return (value + to - 1) / to * to
}

// Two lowercase hexadecimal digits per byte.
fn hex_text(bytes: str) -> str {
    let digits = "0123456789abcdef"
    var text = ""
    var i = 0
    while i < bytes.len() {
        text.push(digits[bytes[i] >> 4])
        text.push(digits[bytes[i] & 15])
        i = i + 1
    }
    return text
}
