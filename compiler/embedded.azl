arse_hex(s: str) -> Option[i64] {\n    if s.len() == 0 || s.len() > 16 {\n        return None\n    }\n    var value = 0\n    var i = 0\n    while i < s.len() {\n        let c = s[i]\n        var digit = -1\n        if c >= 48 && c <= 57 {\n            digit = c - 48\n        }\n        if c >= 97 && c <= 102 {\n            digit = c - 87\n        }\n        if c >= 65 && c <= 70 {\n            digit = c - 55\n        }\n        if digit < 0 {\n            return None\n        }\n        value = (value << 4) | digit\n        i = i + 1\n    }\n    return Some(value)\n}\n\n// The string whose bytes are `bytes`. Each must be from 0 to 255;\n// the program stops with an error otherwise.\nfn list_to_str(bytes: List[i64]) -> str {\n    var out = \"\"\n    for byte in bytes {\n        out = out + chr(byte)\n    }\n    return out\n}\n\n// The numbers of `items` added up; zero for an empty list.\nfn list_sum(items: List[i64]) -> i64 {\n    var total = 0\n    for item in items {\n        total = total + item\n    }\n    return total\n}\n\n// Whether `s` has no bytes.\nfn str_is_empty(s: str) -> bool {\n    return s.len() == 0\n}\n\n// Whether `items` has nothing in it.\nfn list_is_empty[T](items: List[T]) -> bool {\n    return items.len() == 0\n}\n\n// The position of the first item of `items` that equals `wanted`.\nfn list_index_of[T](items: List[T], wanted: T) -> Option[i64] {\n    for i, item in items {\n        if item == wanted {\n            return Some(i)\n        }\n    }\n    return None\n}\n\n// How many items of `items` equal `wanted`.\nfn list_count[T](items: List[T], wanted: T) -> i64 {\n    var found = 0\n    for item in items {\n        if item == wanted {\n            found = found + 1\n        }\n    }\n    return found\n}\n\n// The first `count` items of `items` as a new list; all of them when\n// there are fewer, none when `count` is zero or less.\nfn list_take[T](items: List[T], count: i64) -> List[T] {\n    var out: List[T] = []\n    var i = 0\n    while i