// What the compiler carries inside itself. Each is a file of the
// repository, read when the compiler is built:
//
// - the source of the part of the standard library that is written in
//   azoL, which is compiled together with every program;
// - the machine code of the Linux x86-64 runtime;
// - that of the library that stands in for the system's in Linux ARM64
//   programs;
// - the text of the ARM64 runtime, which comes first in the data of
//   every ARM64 program.
//
// The two `runtime.bin` files and `runtime_data.bin` are made from the
// sources next to them by the `gen_runtime.py` scripts in `runtime/`.

const PRELUDE = embed("../lib/prelude.azl")
const RUNTIME_X64 = embed("../runtime/linux_x64/runtime.bin")
const RUNTIME_ARM64_LINUX = embed("../runtime/linux_arm64/runtime.bin")
const RUNTIME_ARM64_DATA = embed("../runtime/runtime_data.bin")

// The Linux x86-64 runtime.
fn embedded_runtime() -> str {
    return RUNTIME_X64
}

// The library of Linux ARM64 programs.
fn embedded_runtime_arm64() -> str {
    return RUNTIME_ARM64_LINUX
}

// The text of the ARM64 runtime.
fn embedded_runtime_data() -> str {
    return RUNTIME_ARM64_DATA
}
