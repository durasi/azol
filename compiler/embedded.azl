1\n    }\n    return result\n}\n\n// The 64 bits of `n` in hexadecimal digits with small letters and no\n// zeros in front: 255 gives `ff`, -1 gives sixteen `f`.\nfn i64_to_hex(n: i64) -> str {\n    var out = \"\"\n    var shift = 60\n    while shift >= 0 {\n        let digit = (n >> shift) & 15\n        if digit != 0 || out.len() > 0 || shift == 0 {\n            if digit < 10 {\n                out = out + chr(48 + digit)\n            } else {\n                out = out + chr(87 + digit)\n            }\n        }\n        shift = shift - 4\n    }\n    return out\n}\n\n// Adds a copy of every item of `more` to the end of `items`.\nfn list_extend[T](items: mut List[T], more: List[T]) {\n    for item in more {\n        items.push(item)\n    }\n}\n\n// Keeps the first `count` items of `items` and drops the rest. Nothing\n// changes when the list is not longer than that; a `count` below zero\n// keeps nothing.\nfn list_truncate[T](items: mut List[T], count: i64) {\n    while items.len() > count && items.len() > 0 {\n        let dropped = items.pop()\n    }\n}\n\n// Puts `item` at position `at` of `items`, moving the items from there\n// on one place up. `at` may be the length of the list, which adds at the\n// end; the program stops with an error when it is outside 0 to length.\nfn list_insert[T](items: mut List[T], at: i64, item: T) {\n    items.push(item)\n    var i = items.len() - 1\n    while i > at {\n        items[i] = items[i - 1]\n        i = i - 1\n    }\n    items[at] = item\n}\n\n// Takes the item at position `at` out of `items` and returns it, moving\n// the items after it one place down. The program stops with an error\n// when `at` is out of range.\nfn list_remove_at[T](items: mut List[T], at: i64) -> T {\n    let out = items[at]\n    var i = at\n    while i + 1 < items.len() {\n        items[i] = items[i + 1]\n        i = i + 1\n    }\n    let dropped = items.pop()\n    return out\n}\n\n// The FNV-1a hash of the bytes of `s`; the multiplication wraps.\nfn str_hash(s: str) -> i64 {\n    var h = 0xcbf2_9ce4_8422_2325\n    var i = 0\n    while i < s.len() {\n        h = (h ^ s[i]) * 0x100_0000_01b3\n        i = i + 1\n    }\n    return h\n}\n\n// A map from text keys to values of one type: `var ages: Map[i64] =\n// new_map()`. Like every value it is copied when it is stored or passed\n// on, with all its keys and values, and the two maps are then\n// independent; `get` returns a copy of the value.\n//\n// The keys and values stand side by side in two lists with no gaps.\n// `table` is the hash table: each slot holds 0 when it was never used,\n// -1 when its key was removed, or the position of a key plus one.\n// `filled` counts the slots that are not 0.\nstruct Map[V] {\n    keys: List[str]\n    values: List[V]\n    table: List[i64]\n    filled: i64\n}\n\n// A map with nothing in it.\nfn new_map[V]() -> Map[V] {\n    return Map { keys: [], values: [], table: [0, 0, 0, 0, 0, 0, 0, 0], filled: 0 }\n}\n\n// How many keys `map` has.\nfn map_len[V](map: Map[V]) -> i64 {\n    return map.keys.len()\n}\n\n// The slot of the table that holds `key`, or -1 when the map does not\n// have it. The table always has a slot that was never used, so the\n// search ends.\nfn map_slot_of[V](map: Map[V], key: str) -> i64 {\n    let mask = map.table.len() - 1\n    var slot = key.hash() & mask\n    while map.table[slot] != 0 {\n        let entry = map.table[slot]\n        if entry > 0 && map.keys[entry - 1] == key {\n            return slot\n        }\n        slot = (slot + 1) & mask\n    }\n    return -1\n}\n\n// Builds the table again for the keys the map has now, at least twice\n// as large as their number. This also forgets the removed slots.\nfn map_rebuild[V](map: mut Map[V]) {\n    var size = 8\n    while size < (map.keys.len() + 1) * 2 {\n        size = size * 2\n    }\n    var table: List[i64] = []\n    var i = 0\n    while i < size {\n        table.push(0)\n        i = i + 1\n    }\n    let mask = size - 1\n    i = 0\n    while i < map.keys.len() {\n        var slot = map.keys[i].hash() & mask\n        while table[slot] != 0 {\n            slot = (slot + 1) & mask\n        }\n        table[slot] = i + 1\n        i = i + 1\n    }\n    map.table = table\n    map.filled = map.keys.len()\n}\n\n// Makes `key` stand for `value`, in place of any value it had.\nfn map_set[V](map: mut Map[V], key: str, value: V) {\n    let found = map.slot_of(key)\n    if found >= 0 {\n        map.values[map.table[found] - 1] = value\n        return\n    }\n    // At most three quarters of the slots may be in use.\n    if (map.filled + 1) * 4 > map.table.len() * 3 {\n        map.rebuild()\n    }\n    map.keys.push(key)\n    map.values.push(value)\n    let mask = map.table.len() - 1\n    var slot = key.hash() & mask\n    while map.table[slot] != 0 {\n        slot = (slot + 1) & mask\n    }\n    map.table[slot] = map.keys.len()\n    map.filled = map.filled + 1\n}\n\n// A copy of the value of `key`, or `None` when the map does not have it.\nfn map_get[V](map: Map[V], key: str) -> Option[V] {\n    let found = map.slot_of(key)\n    if found < 0 {\n        return None\n    }\n    return Some(map.values[map.table[found] - 1])\n}\n\n// Whether the map has `key`.\nfn map_has[V](map: Map[V], key: str) -> bool {\n    return map.slot_of(key) >= 0\n}\n\n// Takes `key` and its value out; false when the map did not have it.\n// The last key moves into the freed place, so `keys` does not keep the\n// order of insertion after a removal.\nfn map_remove[V](map: mut Map[V], key: str) -> bool {\n    let found = map.slot_of(key)\n    if found < 0 {\n        return false\n    }\n    let at = map.table[found] - 1\n    map.table[found] = -1\n    let last = map.keys.len() - 1\n    if at != last {\n        let moved = map.slot_of(map.keys[last])\n        map.table[moved] = at + 1\n        map.keys[at] = map.keys[last]\n        map.values[at] = map.values[last]\n    }\n    let key_out = map.keys.pop()\n    let value_out = map.values.pop()\n    return true\n}\n\n// A copy of the keys: in the order they were set, until a removal.\nfn map_keys[V](map: Map[V]) -> List[str] {\n    return map.keys\n}\n"

// The bytes of the runtime. Text grows by whole strings only, so every
// byte value is made into a string once and added from a table.
fn embedded_runtime() -> str {
    var singles: List[str] = []
    var b = 0
    while b < 256 {
        singles.push(chr(b))
        b = b + 1
    }
    let digits = RUNTIME_HEX
    var out = ""
    var at = 0
    let end = digits.len()
    while at < end {
        var high = digits[at] - '0'
        if high > 9 {
            high = high - 39
        }
        var low = digits[at + 1] - '0'
        if low > 9 {
            low = low - 39
        }
        out = out + singles[high * 16 + low]
        at = at + 2
    }
    return out
}

const RUNTIME_HEX = ""
