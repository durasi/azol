// From the allocated machine-level view of a function to x86-64 bytes:
// the frame, the moves the allocator asked for, every instruction of
// `sel_x64.azl`, and jumps in their short form where the distance
// allows. docs/design/optimizer.md sections 6.2 to 6.5.
//
// The frame, from the stack pointer up. There is no frame pointer:
// everything is reached from rsp, which does not move between the
// prologue and the epilogue.
//
//   [rsp + 0]          arguments beyond the eighth, and results beyond
//                      the fourth, of the calls this function makes
//   scratch            48 bytes for the string headers a runtime call
//                      needs, when the function has such a call
//   spill slots        8 bytes each
//   frame objects      the function's `frames`, each a multiple of 8
//   (padding)          so that rsp is a multiple of 16 at every call
//   saved registers    those of rbx, rbp, r12 to r15 the function uses
//   return address
//   [caller's rsp]     this function's own stack arguments and results
//
// A frame larger than a page is made one page at a time and every page
// is touched, so that running out of stack is always noticed at the
// guard page, where the runtime reports it.

struct Em {
    c: str
    scratch_at: i64
    slots_at: i64
    obj_at: List[i64]
    total: i64
    pushes: List[i64]
    argin_at: i64
    // The jumps between blocks, all in their long form at first.
    j_at: List[i64]
    j_cc: List[i64]
    j_blk: List[i64]
    blk_at: List[i64]
    // Calls of functions of the module: where the distance is, and the
    // function.
    call_at: List[i64]
    call_fn: List[i64]
    rt: List[Fixup]
    refs: List[Fixup]
    // Where in the data the message of each kind of trap is.
    trap_at: List[i64]
    // The memory operand that was prepared last.
    m_base: i64
    m_index: i64
    m_scale: i64
    m_disp: i64
    // The comparison the flags hold when `fl_ok`: of register `fl_a`
    // with register or slot `fl_b`, or with the number `fl_imm` when
    // `fl_b` is -1. A `select` that asks the same again right after
    // does not compare again.
    fl_ok: bool
    fl_a: i64
    fl_b: i64
    fl_imm: i64
    // For every block: where a jump to it really goes (through blocks
    // that are nothing but a jump), and the block that is emitted after
    // it. A block that only jumps on is not emitted at all.
    thru: List[i64]
    nxt: List[i64]
}

// The bytes of one function and what the linker must fill in.
struct EmFunc {
    code: str
    call_at: List[i64]
    call_fn: List[i64]
    rt: List[Fixup]
    refs: List[Fixup]
}

fn em_slot(e: Em, place: i64) -> i64 {
    return e.slots_at + (place - MF_SLOT0) * 8
}

// ---- the frame -------------------------------------------------------------------------

fn em_layout(e: mut Em, frames: List[i64], sx: SxFunc, result: RaResult) {
    var at = sx.out_bytes
    e.scratch_at = at
    if sx.scratch { at = at + SX_SCRATCH_BYTES }
    e.slots_at = at
    at = at + result.slots * 8
    for bytes in frames {
        e.obj_at.push(at)
        at = at + align_up(bytes, 8)
    }
    var reg = 0
    while reg < 16 {
        if (SX_CALLEE_SAVED >> reg) & 1 != 0 && (result.used >> reg) & 1 != 0 { e.pushes.push(reg) }
        reg = reg + 1
    }
    if sx.calls && (8 + e.pushes.len() * 8 + at) % 16 != 0 { at = at + 8 }
    e.total = at
    e.argin_at = at + e.pushes.len() * 8 + 8
}

fn em_prologue(e: mut Em) {
    for reg in e.pushes {
        ex_push(mut e.c, reg)
    }
    var left = e.total
    if left >= 4096 {
        let pages = left / 4096
        if pages <= 4 {
            var k = 0
            while k < pages {
                ex_alu_ri(mut e.c, EX_SUB, EX_RSP, 4096)
                ex_alu_mi(mut e.c, EX_OR, EX_RSP, 0, 0)
                k = k + 1
            }
        } else {
            // r11 is nobody's at the start of a function.
            ex_mov_imm(mut e.c, EX_R11, pages)
            let top = e.c.len()
            ex_alu_ri(mut e.c, EX_SUB, EX_RSP, 4096)
            ex_alu_mi(mut e.c, EX_OR, EX_RSP, 0, 0)
            ex_alu_ri(mut e.c, EX_SUB, EX_R11, 1)
            let back = ex_jcc_short(mut e.c, EX_CC_NE)
            e.c.set(back, top - (back + 1))
        }
        left = left - pages * 4096
    }
    if left > 0 { ex_alu_ri(mut e.c, EX_SUB, EX_RSP, left) }
}

fn em_epilogue(e: mut Em) {
    if e.total > 0 { ex_alu_ri(mut e.c, EX_ADD, EX_RSP, e.total) }
    var k = e.pushes.len()
    while k > 0 {
        k = k - 1
        ex_pop(mut e.c, e.pushes[k])
    }
    ex_ret(mut e.c)
}

// ---- moves -----------------------------------------------------------------------------

fn em_move(e: mut Em, m: MFunc, kind: i64, a: i64, b: i64) {
    if kind == RA_MV_RR {
        ex_mov_rr(mut e.c, b, a)
    } else if kind == RA_MV_LOAD {
        ex_load(mut e.c, b, EX_RSP, -1, 1, e.slots_at + a * 8)
    } else if kind == RA_MV_STORE {
        ex_store(mut e.c, EX_RSP, -1, 1, e.slots_at + b * 8, a)
    } else if kind == RA_MV_SLOTS {
        // rsp moves between the two, by as much in each direction as
        // the processor allows for: a push reads its operand before it
        // moves rsp, a pop writes its operand after.
        ex_push_mem(mut e.c, EX_RSP, e.slots_at + a * 8)
        ex_pop_mem(mut e.c, EX_RSP, e.slots_at + b * 8)
    } else if kind == RA_MV_CONST_R {
        ex_mov_imm(mut e.c, b, m.consts[a])
    } else {
        let value = m.consts[a]
        let at = e.slots_at + b * 8
        if ex_fits32(value) {
            ex_store_imm(mut e.c, 8, EX_RSP, -1, 1, at, value)
        } else {
            ex_store_imm(mut e.c, 4, EX_RSP, -1, 1, at, value)
            ex_store_imm(mut e.c, 4, EX_RSP, -1, 1, at + 4, value >> 32)
        }
    }
}

// ---- operands --------------------------------------------------------------------------

// Prepares the memory operand of instruction `i`, whose registers start
// at operand `k`.
fn em_mem(e: mut Em, m: MFunc, i: i64, k: i64) {
    let y = m.y[i]
    let kind = sx_y_kind(y)
    var next = k
    e.m_index = -1
    e.m_scale = sx_y_scale(y)
    e.m_disp = m.z[i]
    if kind == SX_M_REG {
        e.m_base = mf_reg(m, i, next)
        next = next + 1
    } else if kind == SX_M_DATA {
        // r11 belongs to the moves between instructions, so inside one
        // it is free.
        let field = ex_lea_rip(mut e.c, EX_R11)
        e.refs.push(Fixup { field: field, value: m.z[i] })
        e.m_base = EX_R11
        e.m_disp = 0
    } else {
        e.m_base = EX_RSP
        if kind == SX_M_FRAME {
            e.m_disp = e.m_disp + e.obj_at[sx_y_object(y)]
        } else if kind == SX_M_SCRATCH {
            e.m_disp = e.m_disp + e.scratch_at
        } else if kind == SX_M_ARGIN {
            e.m_disp = e.m_disp + e.argin_at
        }
    }
    if sx_y_has_index(y) { e.m_index = mf_reg(m, i, next) }
}

fn em_mov(e: mut Em, dst: i64, src: i64) {
    if dst != src { ex_mov_rr(mut e.c, dst, src) }
}

// `cmp a, b`, where b is a register, a slot, or `imm`.
fn em_cmp(e: mut Em, a: i64, b: i64, is_imm: bool, imm: i64) {
    if is_imm {
        if imm == 0 {
            ex_test_rr(mut e.c, a, a)
        } else {
            ex_alu_ri(mut e.c, EX_CMP, a, imm)
        }
    } else if b >= MF_SLOT0 {
        ex_alu_rm(mut e.c, EX_CMP, a, EX_RSP, e.slots_at + (b - MF_SLOT0) * 8)
    } else {
        ex_alu_rr(mut e.c, EX_CMP, a, b)
    }
}

fn em_jump(e: mut Em, cc: i64, block: i64) {
    e.j_at.push(e.c.len())
    e.j_cc.push(cc)
    e.j_blk.push(block)
    if cc < 0 {
        ex_jmp(mut e.c)
    } else {
        ex_jcc(mut e.c, cc)
    }
}

// ---- instructions ----------------------------------------------------------------------

fn em_alu(e: mut Em, m: MFunc, i: i64) {
    let d = mf_reg(m, i, 0)
    let a = mf_reg(m, i, 1)
    let b = mf_reg(m, i, 2)
    let kind = m.x[i]
    if b >= MF_SLOT0 {
        em_mov(mut e, d, a)
        if kind == SX_IMUL {
            ex_imul_rm(mut e.c, d, EX_RSP, e.slots_at + (b - MF_SLOT0) * 8)
        } else {
            ex_alu_rm(mut e.c, kind, d, EX_RSP, e.slots_at + (b - MF_SLOT0) * 8)
        }
        return
    }
    if d == b && d != a {
        // The operation turned round; never a subtraction.
        if kind == SX_IMUL {
            ex_imul_rr(mut e.c, d, a)
        } else {
            ex_alu_rr(mut e.c, kind, d, a)
        }
        return
    }
    if kind == EX_ADD && d != a {
        ex_lea(mut e.c, d, a, b, 1, 0)
        return
    }
    em_mov(mut e, d, a)
    if kind == SX_IMUL {
        ex_imul_rr(mut e.c, d, b)
    } else {
        ex_alu_rr(mut e.c, kind, d, b)
    }
}

fn em_alui(e: mut Em, m: MFunc, i: i64) {
    let d = mf_reg(m, i, 0)
    let a = mf_reg(m, i, 1)
    let kind = m.x[i]
    let value = m.imm[i]
    if kind == SX_IMUL {
        ex_imul_rri(mut e.c, d, a, value)
        return
    }
    if d != a && (kind == EX_ADD || kind == EX_SUB && value != -2147483648) {
        if kind == EX_ADD {
            ex_lea(mut e.c, d, a, -1, 1, value)
        } else {
            ex_lea(mut e.c, d, a, -1, 1, 0 - value)
        }
        return
    }
    em_mov(mut e, d, a)
    ex_alu_ri(mut e.c, kind, d, value)
}

fn em_div(e: mut Em, m: MFunc, i: i64) {
    let by = mf_reg(m, i, 1)
    if m.x[i] == 1 {
        ex_cqo(mut e.c)
        ex_group_r(mut e.c, 7, by)
        return
    }
    // By -1 the processor would stop the program for the one quotient
    // that does not fit; the language says it wraps.
    ex_alu_ri(mut e.c, EX_CMP, by, -1)
    let usual = ex_jcc_short(mut e.c, EX_CC_NE)
    ex_group_r(mut e.c, 3, EX_RAX)
    ex_mov_imm(mut e.c, EX_RDX, 0)
    let done = ex_jmp_short(mut e.c)
    ex_patch_short(mut e.c, usual)
    ex_cqo(mut e.c)
    ex_group_r(mut e.c, 7, by)
    ex_patch_short(mut e.c, done)
}

fn em_ext(e: mut Em, m: MFunc, i: i64) {
    let d = mf_reg(m, i, 0)
    let a = mf_reg(m, i, 1)
    let op = m.x[i]
    if op == IR_EXT8U || op == IR_TRUNC8 {
        ex_extend(mut e.c, 0, d, a)
    } else if op == IR_EXT8S {
        ex_extend(mut e.c, 1, d, a)
    } else if op == IR_EXT32U || op == IR_TRUNC32 {
        ex_extend(mut e.c, 2, d, a)
    } else {
        ex_extend(mut e.c, 3, d, a)
    }
}

fn em_load(e: mut Em, m: MFunc, i: i64) {
    let d = mf_reg(m, i, 0)
    em_mem(mut e, m, i, 1)
    let ty = m.x[i]
    ex_load_width(mut e.c, d, ir_type_bytes(ty), ty == IR_I8 || ty == IR_I32, e.m_base, e.m_index, e.m_scale, e.m_disp)
}

fn em_store(e: mut Em, m: MFunc, i: i64) {
    let bytes = ir_type_bytes(m.x[i])
    if m.y[i] & SX_Y_IMM != 0 {
        em_mem(mut e, m, i, 0)
        ex_store_imm(mut e.c, bytes, e.m_base, e.m_index, e.m_scale, e.m_disp, m.imm[i])
        return
    }
    em_mem(mut e, m, i, 1)
    ex_store_width(mut e.c, bytes, e.m_base, e.m_index, e.m_scale, e.m_disp, mf_reg(m, i, 0))
}

fn em_cmpset(e: mut Em, m: MFunc, i: i64) {
    let d = mf_reg(m, i, 0)
    let a = mf_reg(m, i, 1)
    if m.y[i] == 1 {
        em_cmp(mut e, a, -1, true, m.imm[i])
    } else {
        em_cmp(mut e, a, mf_reg(m, i, 2), false, 0)
    }
    ex_setcc(mut e.c, m.x[i], d)
    ex_extend(mut e.c, 0, d, d)
}

fn em_select(e: mut Em, m: MFunc, i: i64) {
    let d = mf_reg(m, i, 0)
    let a = mf_reg(m, i, 1)
    let flags = m.y[i]
    var k = 2
    var b = -1
    var imm = 0
    if flags & 1 != 0 {
        imm = m.imm[i]
    } else {
        b = mf_reg(m, i, 2)
        k = 3
    }
    if !(e.fl_ok && e.fl_a == a && e.fl_b == b && e.fl_imm == imm) {
        em_cmp(mut e, a, b, b == -1, imm)
    }
    // A `mov` and a `cmov` leave the flags as they are: they still
    // hold this comparison unless one of its operands is written.
    e.fl_ok = d != a && d != b
    e.fl_a = a
    e.fl_b = b
    e.fl_imm = imm
    if flags & 2 != 0 {
        ex_mov_imm(mut e.c, d, m.z[i])
    } else {
        em_mov(mut e, d, mf_reg(m, i, k))
        k = k + 1
    }
    let q = mf_reg(m, i, k)
    // The other value when the condition does not hold.
    let not = m.x[i] ^ 1
    if q >= MF_SLOT0 {
        ex_cmov_rm(mut e.c, not, d, EX_RSP, e.slots_at + (q - MF_SLOT0) * 8)
    } else {
        ex_cmov_rr(mut e.c, not, d, q)
    }
}

fn em_trap(e: mut Em, kind: i64) {
    let message = ir_trap_message(kind)
    ex_alu_ri(mut e.c, EX_AND, EX_RSP, -16)
    ex_alu_ri(mut e.c, EX_SUB, EX_RSP, 32)
    let field = ex_lea_rip(mut e.c, EX_RAX)
    e.refs.push(Fixup { field: field, value: e.trap_at[kind] })
    ex_store(mut e.c, EX_RSP, -1, 1, 0, EX_RAX)
    ex_store_imm(mut e.c, 8, EX_RSP, -1, 1, 8, message.len())
    ex_store_imm(mut e.c, 8, EX_RSP, -1, 1, 16, 0)
    ex_mov_rr(mut e.c, EX_RDI, EX_RSP)
    e.rt.push(Fixup { field: ex_call(mut e.c), value: RT_EPRINT_STR })
    ex_mov_imm(mut e.c, EX_RDI, 1)
    e.rt.push(Fixup { field: ex_call(mut e.c), value: RT_EXIT })
}

// Jumps for a comparison that was just made: to `yes` when `cc` holds
// and to `no` otherwise, from a place after which block `next` follows.
fn em_branch(e: mut Em, cc: i64, yes: i64, no: i64, next: i64) {
    if no == next {
        em_jump(mut e, cc, yes)
    } else if yes == next {
        em_jump(mut e, cc ^ 1, no)
    } else {
        em_jump(mut e, cc, yes)
        em_jump(mut e, -1, no)
    }
}

// Whether a jump back to block `to` is better replaced by a copy of the
// block: a short block that ends in a comparison, the test of a loop.
// The loop then has one jump a round instead of two.
fn em_copies(m: MFunc, from: i64, to: i64) -> bool {
    if to > from || m.b_last[to] - m.b_first[to] > 2 { return false }
    let op = m.op[m.b_last[to]]
    return op == SX_CMPBR || op == SX_CMPBRM
}

// Terminator `i`, which ends block `of`, at a place after which block
// `next` follows.
fn em_terminator(e: mut Em, m: MFunc, result: RaResult, of: i64, next: i64, i: i64) {
    let op = m.op[i]
    let ways = m.b_ss[of]
    if op == SX_JMP {
        let to = e.thru[m.s_blk[ways]]
        if to == next { return }
        if em_copies(m, of, to) {
            var k = m.b_first[to]
            while k <= m.b_last[to] {
                em_moves(mut e, m, result, k)
                if k == m.b_last[to] {
                    em_terminator(mut e, m, result, to, next, k)
                } else {
                    em_instruction(mut e, m, result, to, k)
                }
                k = k + 1
            }
            return
        }
        em_jump(mut e, -1, to)
    } else if op == SX_CMPBR {
        let a = mf_reg(m, i, 0)
        if m.y[i] == 1 {
            em_cmp(mut e, a, -1, true, m.imm[i])
        } else {
            em_cmp(mut e, a, mf_reg(m, i, 1), false, 0)
        }
        em_branch(mut e, m.x[i], e.thru[m.s_blk[ways]], e.thru[m.s_blk[ways + 1]], next)
    } else if op == SX_CMPBRM {
        if m.y[i] & SX_Y_IMM != 0 {
            em_mem(mut e, m, i, 0)
            ex_cmp_mi(mut e.c, e.m_base, e.m_index, e.m_scale, e.m_disp, m.imm[i])
        } else {
            em_mem(mut e, m, i, 1)
            ex_cmp_rm(mut e.c, mf_reg(m, i, 0), e.m_base, e.m_index, e.m_scale, e.m_disp)
        }
        em_branch(mut e, m.x[i], e.thru[m.s_blk[ways]], e.thru[m.s_blk[ways + 1]], next)
    } else if op == SX_SWITCH {
        let v = mf_reg(m, i, 0)
        var k = 0
        while k < m.x[i] {
            let key = m.consts[m.imm[i] + k]
            if ex_fits32(key) {
                ex_alu_ri(mut e.c, EX_CMP, v, key)
            } else {
                ex_mov_imm(mut e.c, EX_R11, key)
                ex_alu_rr(mut e.c, EX_CMP, v, EX_R11)
            }
            em_jump(mut e, EX_CC_E, e.thru[m.s_blk[ways + k]])
            k = k + 1
        }
        if e.thru[m.s_blk[ways + k]] != next { em_jump(mut e, -1, e.thru[m.s_blk[ways + k]]) }
    } else if op == SX_RET {
        em_epilogue(mut e)
    } else {
        em_trap(mut e, m.imm[i])
    }
}

// The moves the allocator wants before instruction `i`.
fn em_moves(e: mut Em, m: MFunc, result: RaResult, i: i64) {
    var k = result.mv_start[i]
    if k < result.mv_start[i + 1] { e.fl_ok = false }
    while k < result.mv_start[i + 1] {
        em_move(mut e, m, result.mv_kind[k], result.mv_a[k], result.mv_b[k])
        k = k + 1
    }
}

fn em_instruction(e: mut Em, m: MFunc, result: RaResult, b: i64, i: i64) {
    let op = m.op[i]
    if op == SX_ENTRY { return }
    if op == SX_MOVI || op == SX_LEA {
        // Neither changes the flags; the register it writes may be
        // one the comparison in the flags read.
        let d = mf_reg(m, i, 0)
        if d == e.fl_a || d == e.fl_b { e.fl_ok = false }
    } else if op != SX_SELECT {
        e.fl_ok = false
    }
    if op == SX_MOVI {
        ex_mov_imm(mut e.c, mf_reg(m, i, 0), m.imm[i])
    } else if op == SX_LEA {
        if sx_y_kind(m.y[i]) == SX_M_DATA && !sx_y_has_index(m.y[i]) {
            let field = ex_lea_rip(mut e.c, mf_reg(m, i, 0))
            e.refs.push(Fixup { field: field, value: m.z[i] })
        } else {
            em_mem(mut e, m, i, 1)
            ex_lea(mut e.c, mf_reg(m, i, 0), e.m_base, e.m_index, e.m_scale, e.m_disp)
        }
    } else if op == SX_COPY {
        let d = mf_reg(m, i, 0)
        let s = mf_reg(m, i, 1)
        if s >= MF_SLOT0 {
            ex_load(mut e.c, d, EX_RSP, -1, 1, e.slots_at + (s - MF_SLOT0) * 8)
        } else {
            em_mov(mut e, d, s)
        }
    } else if op == SX_ALU {
        em_alu(mut e, m, i)
    } else if op == SX_ALUI {
        em_alui(mut e, m, i)
    } else if op == SX_NEG {
        em_mov(mut e, mf_reg(m, i, 0), mf_reg(m, i, 1))
        ex_group_r(mut e.c, 3, mf_reg(m, i, 0))
    } else if op == SX_SHI {
        em_mov(mut e, mf_reg(m, i, 0), mf_reg(m, i, 1))
        if m.imm[i] != 0 { ex_shift_imm(mut e.c, m.x[i], mf_reg(m, i, 0), m.imm[i]) }
    } else if op == SX_SHC {
        em_mov(mut e, mf_reg(m, i, 0), mf_reg(m, i, 1))
        ex_shift_cl(mut e.c, m.x[i], mf_reg(m, i, 0))
    } else if op == SX_MULH {
        let by = mf_reg(m, i, 1)
        var n = 4
        if m.x[i] == 1 { n = 5 }
        if by >= MF_SLOT0 {
            ex_group_m(mut e.c, n, EX_RSP, e.slots_at + (by - MF_SLOT0) * 8)
        } else {
            ex_group_r(mut e.c, n, by)
        }
    } else if op == SX_DIV {
        em_div(mut e, m, i)
    } else if op == SX_EXT {
        em_ext(mut e, m, i)
    } else if op == SX_LOAD {
        em_load(mut e, m, i)
    } else if op == SX_STORE {
        em_store(mut e, m, i)
    } else if op == SX_CMPSET {
        em_cmpset(mut e, m, i)
    } else if op == SX_SELECT {
        em_select(mut e, m, i)
    } else if op == SX_CALL {
        e.call_at.push(ex_call(mut e.c))
        e.call_fn.push(m.imm[i])
    } else if op == SX_CALLRT {
        e.rt.push(Fixup { field: ex_call(mut e.c), value: m.imm[i] })
    } else {
        em_terminator(mut e, m, result, b, e.nxt[b], i)
    }
}

// ---- jumps -----------------------------------------------------------------------------

fn em_jump_size(cc: i64) -> i64 {
    if cc < 0 { return 5 }
    return 6
}

// Where each of the increasing positions `at` of the long code ends up
// when the jumps marked in `short` have their short form.
fn em_remap(e: Em, short: List[bool], at: List[i64]) -> List[i64] {
    var out: List[i64] = []
    var saved = 0
    var j = 0
    for position in at {
        while j < e.j_at.len() && e.j_at[j] < position {
            if short[j] { saved = saved + em_jump_size(e.j_cc[j]) - 2 }
            j = j + 1
        }
        out.push(position - saved)
    }
    return out
}

// Gives the jumps their final form and the function its final bytes.
fn em_finish(e: mut Em) -> EmFunc {
    let jumps = e.j_at.len()
    var short = false.filled(jumps)
    var blocks = e.blk_at
    var places = e.j_at
    var changed = true
    while changed {
        changed = false
        blocks = em_remap(e, short, e.blk_at)
        places = em_remap(e, short, e.j_at)
        var j = 0
        while j < jumps {
            if !short[j] {
                let target = blocks[e.j_blk[j]]
                var distance = target - (places[j] + 2)
                if target > places[j] { distance = target - places[j] - em_jump_size(e.j_cc[j]) }
                if distance >= -128 && distance <= 127 {
                    short[j] = true
                    changed = true
                }
            }
            j = j + 1
        }
    }
    var code = ""
    var from = 0
    var j = 0
    while j < jumps {
        let at = e.j_at[j]
        code = code + e.c.slice(from, at)
        let target = blocks[e.j_blk[j]]
        if short[j] {
            if e.j_cc[j] < 0 {
                code.push(0xEB)
            } else {
                code.push(0x70 + e.j_cc[j])
            }
            code.push(target - (places[j] + 2))
        } else {
            var field = 0
            if e.j_cc[j] < 0 {
                field = ex_jmp(mut code)
            } else {
                field = ex_jcc(mut code, e.j_cc[j])
            }
            ex_patch(mut code, field, target)
        }
        from = at + em_jump_size(e.j_cc[j])
        j = j + 1
    }
    code = code + e.c.slice(from, e.c.len())
    var rt_at: List[i64] = []
    for f in e.rt {
        rt_at.push(f.field)
    }
    var ref_at: List[i64] = []
    for f in e.refs {
        ref_at.push(f.field)
    }
    let call_at = em_remap(e, short, e.call_at)
    let rt_new = em_remap(e, short, rt_at)
    let ref_new = em_remap(e, short, ref_at)
    var rt: List[Fixup] = []
    var k = 0
    while k < rt_new.len() {
        rt.push(Fixup { field: rt_new[k], value: e.rt[k].value })
        k = k + 1
    }
    var refs: List[Fixup] = []
    k = 0
    while k < ref_new.len() {
        refs.push(Fixup { field: ref_new[k], value: e.refs[k].value })
        k = k + 1
    }
    return EmFunc { code: code, call_at: call_at, call_fn: e.call_fn, rt: rt, refs: refs }
}

// Whether block `b` is nothing but a jump: one instruction, and no move
// of the allocator before it. The first block is never one: the
// function starts there.
fn em_only_jumps(m: MFunc, result: RaResult, b: i64) -> bool {
    let i = m.b_first[b]
    return b != 0 && i == m.b_last[b] && m.op[i] == SX_JMP && result.mv_start[i] == result.mv_start[i + 1]
}

// Fills `thru` and `nxt`. A chain of jumps that never reaches a real
// block (an empty endless loop) is left as it is.
fn em_thread(e: mut Em, m: MFunc, result: RaResult) {
    let n = m.b_first.len()
    var b = 0
    while b < n {
        var to = b
        var steps = 0
        while steps <= n && em_only_jumps(m, result, to) {
            to = m.s_blk[m.b_ss[to]]
            steps = steps + 1
        }
        if steps > n { to = b }
        e.thru.push(to)
        b = b + 1
    }
    e.nxt = 0.filled(n)
    var following = n
    b = n - 1
    while b >= 0 {
        e.nxt[b] = following
        if e.thru[b] == b { following = b }
        b = b - 1
    }
}

// The bytes of one function. `frames` are the sizes of its frame
// objects, `trap_at` where in the data the message of each kind of trap
// is.
fn em_function(sx: SxFunc, result: RaResult, frames: List[i64], trap_at: List[i64]) -> EmFunc {
    var e = Em {
        c: "",
        scratch_at: 0,
        slots_at: 0,
        obj_at: [],
        total: 0,
        pushes: [],
        argin_at: 0,
        j_at: [],
        j_cc: [],
        j_blk: [],
        blk_at: [],
        call_at: [],
        call_fn: [],
        rt: [],
        refs: [],
        trap_at: trap_at,
        m_base: 0,
        m_index: -1,
        m_scale: 1,
        m_disp: 0,
        fl_ok: false,
        fl_a: -1,
        fl_b: -1,
        fl_imm: 0,
        thru: [],
        nxt: []
    }
    em_layout(mut e, frames, sx, result)
    em_prologue(mut e)
    em_thread(mut e, sx.mf, result)
    var b = 0
    while b < sx.mf.b_first.len() {
        e.blk_at.push(e.c.len())
        if e.thru[b] != b {
            b = b + 1
            continue
        }
        var i = sx.mf.b_first[b]
        while i <= sx.mf.b_last[b] {
            em_moves(mut e, sx.mf, result, i)
            em_instruction(mut e, sx.mf, result, b, i)
            i = i + 1
        }
        b = b + 1
    }
    return em_finish(mut e)
}
