// What the tools in this folder share: reading the source files, lexing
// and parsing each of them into one tree, and printing a mistake with
// its source line.

fn read_or_exit(path: str) -> str {
    match read_file(path) {
        Ok(text) => return text
        Err(problem) => {
            eprint("error: cannot read '" + path + "': " + problem)
            exit(1)
        }
    }
}

// Lexes the part of `p.src` from `start` to `start + len` on its own
// and parses it into `p.ast`. Returns the first mistake, at its offset
// in the whole text, or an empty message when there is none.
fn parse_part(p: mut Parser, start: i64, len: i64) -> ParseError {
    p.tokens = new_tokens()
    // Positions are offsets in the whole text.
    match lex_part(p.src, start, start + len, mut p.tokens) {
        Some(found) => return ParseError { message: found.message, offset: found.offset }
        None => {}
    }
    parse_tokens(mut p)
    if p.failed { return ParseError { message: p.error.message, offset: p.error.offset } }
    return ParseError { message: "", offset: 0 }
}

const REPORT_WIDTH = 100

fn append_spaces(out: mut str, count: i64) {
    var i = 0
    while i < count {
        out = out + " "
        i = i + 1
    }
}

// Prints an error with the offending source line and a caret under it.
// A very long line is cut down to the part around the problem.
fn report_error(path: str, src: str, offset: i64, message: str) {
    report_error_as("error", path, src, offset, message)
}

// The same, with `head` before the message: `error`, or `error[E0401]`
// with the code of the message.
fn report_error_as(head: str, path: str, src: str, offset: i64, message: str) {
    let at = line_column(src, offset)
    var end = offset
    if end > src.len() { end = src.len() }
    // The line the position is in, without its line ending.
    var line_start = end
    while line_start > 0 && src[line_start - 1] != '\n' {
        line_start = line_start - 1
    }
    var line_end = end
    while line_end < src.len() && src[line_end] != '\n' {
        line_end = line_end + 1
    }
    if line_end < src.len() && line_end > line_start && src[line_end - 1] == '\r' {
        line_end = line_end - 1
    }
    let characters = count_characters(src, line_start, line_end)
    var shown = ""
    var caret = at.column - 1
    if characters <= REPORT_WIDTH {
        shown = src.slice(line_start, line_end)
    } else {
        var first = at.column - 1 - REPORT_WIDTH / 2
        if first < 0 { first = 0 }
        if first > characters - REPORT_WIDTH { first = characters - REPORT_WIDTH }
        let last = first + REPORT_WIDTH
        // Where the characters `first` and `last` start in the text.
        var from = line_start
        var to = line_end
        var seen = 0
        var i = line_start
        while i < line_end {
            if starts_character(src[i]) {
                if seen == first { from = i }
                if seen == last { to = i }
                seen = seen + 1
            }
            i = i + 1
        }
        caret = at.column - 1 - first
        if first > 0 {
            shown = "..."
            caret = caret + 3
        }
        shown = shown + src.slice(from, to)
        if last < characters { shown = shown + "..." }
    }
    let line = str(at.line)
    let gutter = line.len()
    var out = head + ": " + message + "\n"
    append_spaces(mut out, gutter)
    out = out + "--> " + path + ":" + line + ":" + str(at.column) + "\n"
    append_spaces(mut out, gutter)
    out = out + " |\n"
    out = out + line + " | " + shown + "\n"
    append_spaces(mut out, gutter)
    out = out + " | "
    append_spaces(mut out, caret)
    out = out + "^"
    eprint(out)
}

// One line per token: line, column, kind and text.
fn token_listing(src: str, tokens: Tokens) -> str {
    var out = ""
    // The line and column of `cursor`, kept up to date while the tokens
    // are visited in order, so the text is walked only once.
    var cursor = 0
    var line = 1
    var column = 1
    var i = 0
    let count = tokens.kinds.len()
    while i < count {
        let kind = tokens.kinds[i]
        let start = tokens.starts[i]
        while cursor < start {
            let b = src[cursor]
            if b == '\n' {
                line = line + 1
                column = 1
            } else if starts_character(b) {
                column = column + 1
            }
            cursor = cursor + 1
        }
        let line_text = str(line)
        append_spaces(mut out, 4 - line_text.len())
        out = out + line_text
        out = out + ":"
        let column_text = str(column)
        out = out + column_text
        append_spaces(mut out, 4 - column_text.len())
        out = out + " "
        let name = token_kind_name(kind)
        out = out + name
        append_spaces(mut out, 10 - name.len())
        out = out + " "
        if kind == TOK_NEWLINE {
            out = out + "\\n"
        } else if kind != TOK_EOF {
            out = out + src.slice(start, start + tokens.lens[i])
        }
        i = i + 1
        if i < count { out = out + "\n" }
    }
    return out
}
