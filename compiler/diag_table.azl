// The table of error codes, the usage text and the version, as the
// compiler written in azoL needs them. Generated from `src/diag.rs`,
// `src/main.rs` and `Cargo.toml` by `compiler/gen_tables_azl.py`; do
// not edit it by hand.

const VERSION = "0.1.0"

const USAGE = "azoL compiler (early development)\n\nUsage:\n    azol lex <file.azl>              Print the tokens of a source file\n    azol lex --time <file.azl>       Lex the file and report the speed only\n    azol parse <file.azl>            Print the syntax tree of a source file\n    azol parse --time <file.azl>     Lex and parse the file and report the speed only\n    azol build <file.azl>            Compile to an executable next to the source file\n    azol build <file.azl> -o <out>   Compile to the given output path\n    azol build <a.azl> <b.azl> ...   Compile several files as one program; the\n                                     executable is named after the first\n    azol build --target <target> ... Compile for `aarch64-macos`, `x86_64-linux` or\n                                     `aarch64-linux`\n                                     instead of the machine the compiler runs on\n    azol check <a.azl> <b.azl> ...   Report every independent error of a program\n                                     without writing an executable\n    azol check --json ...            Report errors as one JSON object per line on\n    azol build --json ...            standard output, with exact positions, the\n                                     rule that was broken and, when the repair is\n                                     mechanical, the edit that makes it\n    azol explain                     List the error codes with their rules\n    azol explain <code>              Explain one error code, as in `azol explain E0401`\n    azol fmt <files...>              Rewrite source files in the canonical layout\n    azol fmt --check <files...>      Change nothing; list the files that are not\n                                     formatted and exit with 1 if there are any\n    azol fmt -                       Format standard input to standard output\n    azol --version                   Print the version"

// The first lines of `docs/errors.md`.
const ERRORS_MD_HEAD = "# azoL error codes\n\nWritten by `azol explain --markdown` from the compiler's table of error codes; do not edit by hand. `azol explain <code>` prints the same text.\n\nAreas: E01 syntax, E02 names, E03 types, E04 ownership and exclusivity, E05 patterns, E06 generics, E07 constants, E08 limits.\n"

// One kind of error: its code, the wordings that belong to it with
// `{}` for the parts that vary, the rule of the language behind it,
// what to do about it when that is the same every time, and the
// longer text `explain` prints.
struct DiagEntry {
    code: str
    patterns: List[str]
    rule: str
    help: str
    explain: str
}

// What a message that fits no pattern gets.
fn diag_unclassified() -> DiagEntry {
    return DiagEntry { code: "E0000", patterns: [], rule: "This message has no code of its own yet.", help: "", explain: "Please report it: every message is meant to have a code." }
}

// Every kind of error, in the order they are tried: the first entry
// with a pattern that fits a message wins.
fn diag_table() -> List[DiagEntry] {
    var t: List[DiagEntry] = []
    diag_table_1(mut t)
    diag_table_2(mut t)
    diag_table_3(mut t)
    diag_table_4(mut t)
    diag_table_5(mut t)
    diag_table_6(mut t)
    diag_table_7(mut t)
    diag_table_8(mut t)
    return t
}

fn diag_table_1(t: mut List[DiagEntry]) {
    t.push(DiagEntry { code: "E0101", patterns: ["unexpected character"], rule: "Source text consists of names, numbers, strings, operators and punctuation that the language knows.", help: "", explain: "A character that cannot start anything in azoL was found, for example `@` or `#`. A lone `!` that is not part of `!=` and not in front of a value also ends up here." })
    t.push(DiagEntry { code: "E0102", patterns: ["unterminated string literal"], rule: "A string literal ends with `\"` on the line it starts on.", help: "Add the closing `\"`.", explain: "Strings do not continue on the next line. To put a line end inside a string write `\\n`." })
    t.push(DiagEntry { code: "E0103", patterns: ["unknown escape sequence in string literal", "unknown escape sequence in character literal"], rule: "After a backslash only `n`, `t`, `r`, `0`, `\\`, `\"` and `'` are allowed.", help: "", explain: "To write a backslash itself, write two: `\\\\`." })
    t.push(DiagEntry { code: "E0104", patterns: ["a character literal holds one ASCII character, as in `'a'`"], rule: "A character literal is one ASCII character between single quotes and stands for its byte value.", help: "", explain: "`'a'` is the number 97. Text of any other length is a string and uses double quotes." })
    t.push(DiagEntry { code: "E0105", patterns: ["a hexadecimal number is `0x` followed by the digits 0-9 and a-f, as in `0x1F`", "a binary number is `0b` followed by the digits 0 and 1, as in `0b1010`"], rule: "A number with the prefix `0x` or `0b` needs at least one digit of that base after it.", help: "", explain: "Digits may be separated with `_`, as in `0xFFFF_FFFF`. The prefixes are written in lower case." })
    t.push(DiagEntry { code: "E0107", patterns: ["expected end of line but found {}"], rule: "A statement ends at the end of its line; there are no semicolons.", help: "Start a new line here.", explain: "Two statements cannot share a line. An expression may continue on the next line after a binary operator, or when the next line starts with `.`." })
    t.push(DiagEntry { code: "E0108", patterns: ["expected a new line, `,` or `}` but found {}"], rule: "The members of a struct or enum and the arms of a `match` are separated by a new line or a comma.", help: "", explain: "Write one member per line, or put commas between them." })
    t.push(DiagEntry { code: "E0109", patterns: ["expected `}` to close the block but reached end of file"], rule: "Every `{` is closed by a `}` in the same file.", help: "", explain: "The file ended while a block was still open. The report points at the end of the file; the missing `}` belongs to a block that starts earlier." })
    t.push(DiagEntry { code: "E0110", patterns: ["cannot assign to this expression"], rule: "The left side of `=` is a variable, a field of one, or an element of a list.", help: "", explain: "Something that is computed, such as a call or a sum, has no place to store a value in." })
    t.push(DiagEntry { code: "E0111", patterns: ["a constant is declared outside functions; use `let` for a value inside one"], rule: "`const` declares a name for the whole program and is written at the top level of a file.", help: "", explain: "Inside a function a fixed value is declared with `let`." })
}

fn diag_table_2(t: mut List[DiagEntry]) {
    t.push(DiagEntry { code: "E0112", patterns: ["a struct literal here needs parentheses around it, `({} { ... })`: this `{` starts the block"], rule: "Between `if`, `while`, `for ... in` or `match` and the `{` of its block, a struct literal is written in parentheses.", help: "Put the struct literal in parentheses.", explain: "Wrong:\n\n    if p == Point { x: 1, y: 2 } {\n    }\n\nRight:\n\n    if p == (Point { x: 1, y: 2 }) {\n    }" })
    t.push(DiagEntry { code: "E0113", patterns: ["a `_` in a number stands between two digits, as in `1_000`", "a decimal number does not start with `0`; other bases are written `0x1F` and `0b1010`"], rule: "In a number a `_` stands between two digits, and a decimal number other than `0` does not start with `0`.", help: "", explain: "`1_000_000`, `0xFFFF_FFFF` and `0b1010_1010` are fine; `1__0`, `1_`, `0x_F` and `007` are not. There are no octal numbers." })
    t.push(DiagEntry { code: "E0106", patterns: ["expected {} but found {}"], rule: "The program must follow the grammar; here something else was required.", help: "", explain: "The message names what the grammar needs at this point and what was found instead. Every declaration starts with `fn`, `struct`, `enum` or `const`; conditions and bodies are not wrapped in extra punctuation." })
    t.push(DiagEntry { code: "E0201", patterns: ["unknown variable `{}`"], rule: "A name must be declared before it is used: as a variable, a parameter, a constant or a variant.", help: "", explain: "Variables are visible from their `let` or `var` to the end of the block they are in." })
    t.push(DiagEntry { code: "E0202", patterns: ["unknown function `{}`"], rule: "Only functions of the program and the built-in functions can be called.", help: "", explain: "The built-in functions are `print`, `eprint`, `str`, `chr`, `args`, `read_file`, `write_file`, `set_executable`, `remove_file`, `rename_file`, `clock` and `exit`. The library's `find`, `split` and the like are methods: `text.find(part)`." })
    t.push(DiagEntry { code: "E0203", patterns: ["unknown type `{}`; {}"], rule: "A type is `i64`, `bool`, `str`, `List[...]`, `Option[...]`, `Result[..., ...]` or a struct or enum of the program.", help: "", explain: "There are no other number types yet: all integers are `i64`." })
    t.push(DiagEntry { code: "E0204", patterns: ["unknown struct `{}`"], rule: "A struct literal names a struct declared in the program.", help: "", explain: "" })
    t.push(DiagEntry { code: "E0205", patterns: ["unknown variant `{}`"], rule: "A pattern with `(...)` names a variant of an enum.", help: "", explain: "" })
    t.push(DiagEntry { code: "E0206", patterns: ["struct `{}` has no field `{}`", "`{}` has no field `{}`; its methods are `len()`, `push(...)` and `pop()`", "`{}` has no fields; use `match` to look inside it", "`{}` has no fields"], rule: "Only structs have fields, and only the ones they declare.", help: "", explain: "The value inside an enum is reached with `match`. Lists and strings have methods, called with `()`." })
    t.push(DiagEntry { code: "E0207", patterns: ["`{}` has no method `{}`"], rule: "A method call needs a method that exists for the type of the value before the dot.", help: "", explain: "Strings have `len`, `slice`, `find`, `contains`, `starts_with`, `ends_with`, `trim`, `split`, `lines` and `to_i64`. Lists have `len`, `push`, `pop`, `contains`, `first`, `last` and `reversed`; lists of strings also `join`. The program's own functions are called as `name(value)`." })
}

fn diag_table_3(t: mut List[DiagEntry]) {
    t.push(DiagEntry { code: "E0208", patterns: ["function `{}` is defined more than once", "struct `{}` is defined more than once", "enum `{}` is defined more than once", "constant `{}` is defined more than once", "`{}` is already defined as an enum", "`{}` is already defined as a struct", "variant `{}` is declared more than once", "variant `{}` already belongs to `{}`; variant names must differ across enums", "field `{}` is declared more than once", "type parameter `{}` is declared more than once", "`{}` is already a variant of `{}`", "`{}` is already a constant"], rule: "A name is declared once: functions, constants and variants share one namespace across all files, types another.", help: "", explain: "Variant names are used without their enum's name (`Some`, not `Option.Some`), so two enums cannot both have a variant of the same name. The report points at the second declaration." })
    t.push(DiagEntry { code: "E0209", patterns: ["`{}` is a built-in type and cannot be redefined", "`{}` is built in and cannot be redefined", "`{}` is a type of the standard library; choose another name"], rule: "The names of built-in types and functions cannot be declared again.", help: "", explain: "" })
    t.push(DiagEntry { code: "E0210", patterns: ["`{}` is a function; call it with `{}(...)`", "`{}` is a struct; create a value with `{} { ... }`", "`{}` is an enum; create a value with one of its variants", "`{}` is a variable, not a function", "only functions can be called"], rule: "Functions are called, structs are built with `{ ... }`, enums through their variants; none of them is a value by itself.", help: "", explain: "There are no function values yet, so a function's name cannot be stored or passed." })
    t.push(DiagEntry { code: "E0211", patterns: ["`{}` is a variant of `{}` and cannot be used as a variable name", "`{}` is a constant and cannot be used as a variable name"], rule: "A variable or parameter cannot have the name of a variant or a constant, so that a name means the same everywhere.", help: "", explain: "" })
    t.push(DiagEntry { code: "E0212", patterns: ["enum `{}` has no variants"], rule: "An enum declares at least one variant.", help: "", explain: "" })
    t.push(DiagEntry { code: "E0303", patterns: ["a condition must be `bool` but this is `{}`"], rule: "The condition of `if` and `while` is a `bool`; numbers are not conditions.", help: "", explain: "Compare explicitly: `if count != 0`." })
    t.push(DiagEntry { code: "E0304", patterns: ["this function returns `{}` but this is `{}`", "this function returns nothing, so `return` cannot have a value", "this function must return a value of type `{}`"], rule: "`return` gives back a value of exactly the type the function declares after `->`, and none when it declares none.", help: "", explain: "" })
    t.push(DiagEntry { code: "E0305", patterns: ["function `{}` must return a value of type `{}` on every path"], rule: "A function with a result type ends every path with `return`.", help: "", explain: "An `if` without `else`, or a loop, may be skipped, so a `return` after it is still needed. A `match` whose arms all return counts as returning." })
    t.push(DiagEntry { code: "E0306", patterns: ["`for` needs a list to go through but this is `{}`"], rule: "`for` goes through the items of a list.", help: "", explain: "To count, use `while` with a counter. To go through the bytes of a string, index it: `text[i]`." })
    t.push(DiagEntry { code: "E0307", patterns: ["only a list or a string can be indexed but this is `{}`"], rule: "`value[index]` works on lists (an item) and strings (a byte).", help: "", explain: "" })
}

fn diag_table_4(t: mut List[DiagEntry]) {
    t.push(DiagEntry { code: "E0308", patterns: ["`print` takes an `i64`, a `bool` or a `str` but this is `{}`", "`str` turns an `i64` or a `bool` into text but this is `{}`"], rule: "`print` and `str` work on numbers, `bool`s and (for `print`) strings only.", help: "", explain: "Print the parts of a struct, list or enum one by one." })
    t.push(DiagEntry { code: "E0602", patterns: ["`{}` is a type parameter and takes no type arguments", "`{}` takes no type arguments", "`List` takes one element type, as in `List[i64]`", "`{}` takes {} type argument{}, as in `{}`"], rule: "A generic type is written with exactly as many type arguments as it declares type parameters, and other types with none.", help: "", explain: "" })
    t.push(DiagEntry { code: "E0309", patterns: ["`{}` takes {} argument{} but {} were given", "`{}` holds {} value{} but {} were given"], rule: "A call gives exactly one argument for each parameter, and a variant exactly one value for each of its fields.", help: "", explain: "In a method call the value before the dot is not counted." })
    t.push(DiagEntry { code: "E0310", patterns: ["this expression has no value to {}"], rule: "A call to a function that returns nothing has no value and cannot be stored, passed, compared or matched on.", help: "", explain: "" })
    t.push(DiagEntry { code: "E0311", patterns: ["structs cannot be compared with `{}` yet; compare their fields", "lists cannot be compared with `{}` yet", "`{}` works only on enums whose variants hold no values; use `match` for `{}`"], rule: "`==` and `!=` compare numbers, `bool`s, strings and enums whose variants hold no values.", help: "", explain: "" })
    t.push(DiagEntry { code: "E0506", patterns: ["`{}` holds {} value{}; write `{}` to match it", "`{}` holds {} value{} but this pattern lists {}"], rule: "A variant pattern lists one name or `_` for each value the variant holds.", help: "", explain: "Wrong:\n\n    match found {\n        Some => print(1)\n        None => print(0)\n    }\n\nRight:\n\n    match found {\n        Some(_) => print(1)\n        None => print(0)\n    }" })
    t.push(DiagEntry { code: "E0312", patterns: ["`{}` holds {} value{}; write `{}`", "`{}` holds no value; write it without `()`"], rule: "A variant is written with one value for each of its fields in `(...)`, and without parentheses when it has none.", help: "", explain: "`Some(3)` and `None`, never `Some` alone or `None()`." })
    t.push(DiagEntry { code: "E0313", patterns: ["field `{}` is given more than once", "field `{}` of `{}` is missing"], rule: "A struct literal gives every field of the struct exactly once.", help: "", explain: "There are no default values for fields." })
    t.push(DiagEntry { code: "E0315", patterns: ["the program has no `main` function", "`main` cannot take parameters", "`main` must return `i64` or nothing", "`main` cannot have type parameters"], rule: "A program has exactly one `fn main()`, without parameters, returning nothing or the exit code as `i64`.", help: "", explain: "Command-line arguments come from `args()`." })
    t.push(DiagEntry { code: "E0316", patterns: ["`break` and `continue` can only be used inside a loop"], rule: "`break` and `continue` belong to the innermost `while` or `for` around them.", help: "", explain: "" })
}

fn diag_table_5(t: mut List[DiagEntry]) {
    t.push(DiagEntry { code: "E0317", patterns: ["this number does not fit in `i64`", "this number does not fit in 64 bits"], rule: "A number literal must fit in 64 bits.", help: "", explain: "Decimal literals go up to 9223372036854775807. Hexadecimal and binary literals may use all 64 bits and then mean the same bits as an `i64`." })
    t.push(DiagEntry { code: "E0318", patterns: ["`?` needs a `Result` or an `Option` but this is `{}`", "`?` on `{}` needs a function that returns {}, but this function returns {}; use `match`"], rule: "`value?` follows a `Result` or an `Option`, in a function that returns the same kind: an `Option`, or a `Result` with the same error type.", help: "Use `match` to handle the other case here.", explain: "`value?` is what an `Ok` or a `Some` holds. For an `Err` or a `None` the function returns that `Err` or `None` at once, so its own result type must be able to hold it.\n\nWrong:\n\n    fn main() {\n        let text = read_file(\"a.txt\")?\n    }\n\nRight:\n\n    fn main() {\n        match read_file(\"a.txt\") {\n            Ok(text) => print(text)\n            Err(why) => eprint(why)\n        }\n    }" })
    t.push(DiagEntry { code: "E0301", patterns: ["expected `{}` but this is `{}`"], rule: "A value stored in a variable or a place has exactly the type of that variable or place; nothing is converted silently.", help: "", explain: "Use `str(number)` to make text from a number and `text.to_i64()` for the other direction." })
    t.push(DiagEntry { code: "E0703", patterns: ["cannot change `{}`: it is a constant", "cannot pass `{}` as `mut`: it is a constant"], rule: "A constant never changes.", help: "", explain: "Copy it into a `var` to work on a changeable value." })
    t.push(DiagEntry { code: "E0401", patterns: ["cannot change `{}`: declare it with `var` to make it changeable", "cannot pass `{}` as `mut`: declare it with `var` to make it changeable"], rule: "A variable declared with `let` never changes; only one declared with `var` can be assigned, grown or passed as `mut`.", help: "Declare the variable with `var` instead of `let`.", explain: "Wrong:\n\n    let total = 0\n    total = total + 1\n\nRight:\n\n    var total = 0\n    total = total + 1\n\nThis also covers changing a part of the variable: a field, a list element, `push` and `pop`." })
    t.push(DiagEntry { code: "E0402", patterns: ["cannot change `{}`: a parameter is read-only unless it is declared `mut`", "cannot pass `{}` as `mut`: a parameter is read-only unless it is declared `mut`"], rule: "A function can change an argument only through a parameter declared `mut`, and the caller then writes `mut` too.", help: "", explain: "Wrong:\n\n    fn add(items: List[i64]) {\n        items.push(1)\n    }\n\nRight:\n\n    fn add(items: mut List[i64]) {\n        items.push(1)\n    }\n\n    add(mut numbers)\n\nTo work on a private copy instead, store the parameter in a `var`." })
    t.push(DiagEntry { code: "E0403", patterns: ["cannot change `{}`: a loop variable or pattern binding is read-only", "cannot pass `{}` as `mut`: a loop variable or pattern binding is read-only"], rule: "The variable of a `for` loop and the names bound by a pattern are read-only views of the value they come from.", help: "", explain: "Wrong:\n\n    for item in items {\n        item = item + 1\n    }\n\nRight:\n\n    var i = 0\n    while i < items.len() {\n        items[i] = items[i] + 1\n        i = i + 1\n    }" })
    t.push(DiagEntry { code: "E0405", patterns: ["argument {} of `{}` can be changed by the function, so it must be written `mut <variable>`"], rule: "An argument for a `mut` parameter is written with `mut` in front, so that every place a variable can change is visible in the caller.", help: "Write `mut` in front of the argument.", explain: "Wrong:\n\n    grow(numbers)\n\nRight:\n\n    grow(mut numbers)" })
    t.push(DiagEntry { code: "E0406", patterns: ["argument {} of `{}` is not a `mut` parameter; remove `mut`", "`mut` can only be used on a function argument"], rule: "`mut` in front of a value is written only for an argument whose parameter is declared `mut`.", help: "Remove `mut`.", explain: "" })
    t.push(DiagEntry { code: "E0407", patterns: ["`mut` needs a variable or a part of a variable", "`{}` changes the list, so it needs a variable or a part of a variable", "`{}` changes its receiver, so it needs a variable or a part of a variable", "only a variable or a part of a variable can be assigned"], rule: "Only a variable, a field of one or an element of one can be changed; a computed value has no owner to change.", help: "Store the value in a `var` first.", explain: "Wrong:\n\n    make_list().push(1)\n\nRight:\n\n    var items = make_list()\n    items.push(1)" })
}

fn diag_table_6(t: mut List[DiagEntry]) {
    t.push(DiagEntry { code: "E0408", patterns: ["cannot change `{}` while a loop is going through it", "cannot pass `{}` as `mut` while a loop is going through it"], rule: "A list cannot be changed while a `for` loop is going through it.", help: "", explain: "The loop variable looks at the item inside the list, so the list must stay as it is.\n\nWrong:\n\n    for item in items {\n        items.push(item)\n    }\n\nRight:\n\n    let snapshot = items\n    for item in snapshot {\n        items.push(item)\n    }\n\nor collect the changes in another variable and apply them after the loop." })
    t.push(DiagEntry { code: "E0409", patterns: ["cannot change `{}` while a `match` is looking inside it", "cannot pass `{}` as `mut` while a `match` is looking inside it"], rule: "A value cannot be changed while a `match` is looking inside it.", help: "", explain: "The names a pattern binds refer to the value where it is, so it must stay as it is until the `match` ends.\n\nWrong:\n\n    match shape {\n        Circle(r) => shape = Circle(r + 1)\n        Empty => {}\n    }\n\nRight:\n\n    var next = shape\n    match shape {\n        Circle(r) => next = Circle(r + 1)\n        Empty => {}\n    }\n    shape = next" })
    t.push(DiagEntry { code: "E0410", patterns: ["`{}` is passed twice in one call and one of the uses is `mut`; copy it into a variable first", "cannot change `{}` here: it is also passed to a function in the same expression"], rule: "One call cannot receive the same data twice when one of the uses is `mut`.", help: "", explain: "Large values are passed by reference; this rule is what keeps a reference indistinguishable from a private copy.\n\nWrong:\n\n    append(mut items, items)\n\nRight:\n\n    let copy = items\n    append(mut items, copy)" })
    t.push(DiagEntry { code: "E0411", patterns: ["cannot change `{}` here: it is still being read earlier in the same expression", "cannot pass `{}` as `mut` here: it is still being read earlier in the same expression"], rule: "A string cannot be changed while an operator in the same expression is still reading it.", help: "", explain: "Wrong:\n\n    let joined = text + shorten(mut text)\n\nRight:\n\n    let before = text\n    let joined = before + shorten(mut text)" })
    t.push(DiagEntry { code: "E0412", patterns: ["a string cannot be changed in place; build a new one with `slice` and `+`"], rule: "A byte of a string can be read with `text[i]` but not assigned.", help: "", explain: "Wrong:\n\n    text[0] = 65\n\nRight:\n\n    text = chr(65) + text.slice(1, text.len())" })
    t.push(DiagEntry { code: "E0413", patterns: ["struct `{}` contains itself, so it would have no finite size", "enum `{}` contains itself, so it would have no finite size; put the inner value in a `List`"], rule: "A value is stored inline in its owner, so a type cannot contain itself directly; it can through a `List`.", help: "", explain: "Wrong:\n\n    struct Node {\n        value: i64\n        next: Option[Node]\n    }\n\nRight:\n\n    struct Node {\n        value: i64\n        children: List[Node]\n    }" })
    t.push(DiagEntry { code: "E0414", patterns: ["`?` cannot be used inside a list literal; store its value in a variable first", "`?` cannot be used after a part of the same value that owns memory; store its value in a variable first"], rule: "`?` may leave the function, so it cannot stand inside a list literal, or in a struct literal or variant after a part that owns memory: the half-built value would have no owner.", help: "Compute the value with `?` in a `let` before the literal.", explain: "Wrong:\n\n    return Ok([first()?, second()?])\n\nRight:\n\n    let a = first()?\n    let b = second()?\n    return Ok([a, b])" })
    t.push(DiagEntry { code: "E0501", patterns: ["this `match` does not handle {}; add an arm for it or a final `_ =>` arm", "this `match` does not handle {}; add arms for them or a final `_ =>` arm"], rule: "A `match` handles every case: each variant of an enum, both `true` and `false`, or has a final `_ =>` arm.", help: "Add the missing arms.", explain: "Wrong:\n\n    match found {\n        Some(at) => print(at)\n    }\n\nRight:\n\n    match found {\n        Some(at) => print(at)\n        None => {}\n    }" })
    t.push(DiagEntry { code: "E0502", patterns: ["a `match` on `{}` needs a final `_ =>` arm: the arms cannot list every value"], rule: "A `match` on a number or a string ends with a `_ =>` arm, because no list of values covers them all.", help: "Add a final `_ =>` arm.", explain: "Wrong:\n\n    match code {\n        0 => print(\"ok\")\n    }\n\nRight:\n\n    match code {\n        0 => print(\"ok\")\n        _ => print(\"failed\")\n    }" })
    t.push(DiagEntry { code: "E0503", patterns: ["this arm can never run: {}"], rule: "Every arm of a `match` must be reachable: arms are tried in order and an earlier one already takes this case.", help: "", explain: "Wrong:\n\n    match found {\n        _ => print(0)\n        None => print(1)\n    }\n\nRight:\n\n    match found {\n        None => print(1)\n        _ => print(0)\n    }" })
}

fn diag_table_7(t: mut List[DiagEntry]) {
    t.push(DiagEntry { code: "E0504", patterns: ["`match` works on enums, `i64`, `bool` and `str` but this is `{}`"], rule: "`match` looks at an enum, a number, a `bool` or a string.", help: "", explain: "For a struct, match on one of its fields." })
    t.push(DiagEntry { code: "E0505", patterns: ["this pattern is {} but the `match` is on `{}`", "`{}` is a variant of `{}` but this `match` is on `{}`"], rule: "A pattern has the type of the value being matched.", help: "", explain: "Wrong:\n\n    match count {\n        None => print(0)\n        _ => print(1)\n    }\n\nwhere `count` is an `i64`. Right:\n\n    match count {\n        0 => print(0)\n        _ => print(1)\n    }" })
    t.push(DiagEntry { code: "E0507", patterns: ["`{}` is used twice in this pattern"], rule: "Each name in a pattern is bound once.", help: "", explain: "Wrong: `Pair(a, a) => ...`. Right: `Pair(a, b) => ...`." })
    t.push(DiagEntry { code: "E0508", patterns: ["a pattern inside a pattern is not supported yet; give the value a name and `match` on it inside the arm"], rule: "The values of a variant pattern are names or `_`; patterns are not nested yet.", help: "", explain: "Wrong:\n\n    match outer {\n        Some(Some(value)) => print(value)\n        _ => {}\n    }\n\nRight:\n\n    match outer {\n        Some(inner) => {\n            match inner {\n                Some(value) => print(value)\n                None => {}\n            }\n        }\n        None => {}\n    }" })
    t.push(DiagEntry { code: "E0601", patterns: ["cannot tell what this empty list holds; give the variable a type, as in `var xs: List[i64] = []`", "cannot tell which `{}` this is; give the variable a type, as in `{}`", "cannot tell what `{}` is in this call to `{}`: no argument settles it; store the result in a variable with a type"], rule: "The type arguments of a generic type or function come from the values given or from the type expected at that place; when neither settles them they must be written.", help: "Give the variable a type.", explain: "`[]`, `None` and `Ok(1)` do not say what else they could hold. Write `let found: Option[i64] = None`, or use them where the type is already known: as an argument, a field, a returned value." })
    t.push(DiagEntry { code: "E0603", patterns: ["`{}` is used with types that grow without end", "this type nests structs too deeply", "this type nests enums too deeply"], rule: "A generic function or type is compiled once per set of types it is used with, so that set must be finite.", help: "", explain: "`fn f[T](x: T) { f([x]) }` would need `f` for `T`, `List[T]`, `List[List[T]]` and so on forever." })
    t.push(DiagEntry { code: "E0701", patterns: ["`{}` is not a constant; a constant is made of literals and other constants", "a constant must be made of literals and other constants", "string constants can be joined with `+`; no other operator works on them in a constant"], rule: "The value of a constant is computed when the program is compiled: from literals, other constants and operators on numbers and `bool`s.", help: "", explain: "Calls, variables, lists and structs cannot appear in a constant. The one exception is `embed(\"path\")`, which stands for the contents of a file. String constants are string literals, embedded files and those joined with `+`." })
    t.push(DiagEntry { code: "E0702", patterns: ["constant `{}` is defined in terms of itself"], rule: "Constants may refer to each other in any order, but not in a circle.", help: "", explain: "" })
    t.push(DiagEntry { code: "E0704", patterns: ["division by zero in a constant"], rule: "A constant expression cannot divide by zero.", help: "", explain: "" })
    t.push(DiagEntry { code: "E0705", patterns: ["`embed` works only in a constant: write `const NAME = embed(\"file\")` and use the constant"], rule: "`embed(\"path\")` stands for the contents of a file, read when the program is compiled; it can only be the value of a constant, or a part of one.", help: "Give the file's text a name with `const NAME = embed(\"path\")` and use `NAME`.", explain: "Wrong:\n\n    fn main() {\n        print(embed(\"notes.txt\"))\n    }\n\nRight:\n\n    const NOTES = embed(\"notes.txt\")\n\n    fn main() {\n        print(NOTES)\n    }\n\nTo read a file while the program runs, use `read_file`." })
}

fn diag_table_8(t: mut List[DiagEntry]) {
    t.push(DiagEntry { code: "E0706", patterns: ["cannot embed `{}`: {}"], rule: "The file named in `embed` must be readable when the program is compiled. The path is relative to the folder of the source file that names it.", help: "", explain: "The text after the colon is the system's reason, such as `No such file or directory`. `embed(\"data/table.txt\")` in `src/main.azl` reads `src/data/table.txt`, wherever the compiler is started from." })
    t.push(DiagEntry { code: "E0302", patterns: ["{} needs `{}` but this is `{}`"], rule: "An operator, an argument, a field and a list element each need a value of one exact type; nothing is converted silently.", help: "", explain: "Arithmetic and comparison with `<` work on `i64`; `+` also joins two strings; `&&`, `||` and `!` work on `bool`. Use `str(number)` to put a number into text." })
    t.push(DiagEntry { code: "E0801", patterns: ["source file is larger than 4 GiB"], rule: "A source file is at most 4 GiB.", help: "", explain: "" })
    t.push(DiagEntry { code: "E0802", patterns: ["code is nested too deeply"], rule: "Expressions, blocks and patterns nest at most 200 levels deep.", help: "", explain: "" })
    t.push(DiagEntry { code: "E0803", patterns: ["enum `{}` has more than {} variants, which is not supported yet", "function `{}` has more than {} parameters, which is not supported yet", "this function needs more than {} slots of stack, which is not supported yet", "struct `{}` is too large for now", "enum `{}` is too large for now"], rule: "The compiler has fixed limits: 8 parameters per function, 1000 variants per enum, 500 slots per struct or enum, 2000 slots of stack per function.", help: "", explain: "A slot is 8 bytes. Every local variable and every intermediate struct, string or list of a function takes slots. Split a very large function, or build a very long list with `push` in a loop instead of one literal." })
    t.push(DiagEntry { code: "E0804", patterns: ["there are no floating-point numbers yet; the only number type is `i64`"], rule: "The only number type so far is `i64`.", help: "", explain: "" })
}
