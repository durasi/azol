// Recursive-descent parser with precedence climbing for expressions.
// It never backtracks: every decision is made from the current token,
// plus at most a look past blank lines.
//
// The first mistake stops the parse. A function that finds one records
// it with `parse_fail` and returns; every caller checks `p.failed` after
// a call that can fail and returns in turn, so nothing is built from a
// half-read construct.

const MAX_PARSE_DEPTH = 200

// Why a text could not be parsed, and at which byte.
struct ParseError {
    message: str
    offset: i64
}

// Everything a parse works on: the source, its tokens, the tree being
// built, and where the parser is.
struct Parser {
    src: str
    tokens: Tokens
    ast: Ast
    // Index of the current token, and its kind.
    pos: i64
    kind: i64
    // Ids of the list being collected, innermost last. Only the first
    // `scratch_len` elements are in use.
    scratch: List[i64]
    scratch_len: i64
    // True while parsing a condition, where `name {` starts a block and
    // not a struct literal.
    no_struct: bool
    depth: i64
    // The last text with values that was parsed (see `parse_text`), or
    // `NO_NODE`.
    text_chain: i64
    failed: bool
    error: ParseError
}

// A parser for `src`, with no tokens yet: fill `tokens` with `lex` and
// call `parse_tokens`.
fn new_parser(src: str) -> Parser {
    return Parser {
        src: src,
        tokens: new_tokens(),
        ast: new_ast(),
        pos: 0,
        kind: TOK_EOF,
        scratch: [],
        scratch_len: 0,
        no_struct: false,
        depth: 0,
        text_chain: NO_NODE,
        failed: false,
        error: ParseError { message: "", offset: 0 },
    }
}

// Parses the tokens in `p.tokens`, from the first one, and adds what
// they declare to `p.ast`. Calling it again after replacing the tokens
// adds another file to the same tree; the positions in its tokens then
// refer to the same source text, further along. Look at `p.failed`
// afterwards.
fn parse_tokens(p: mut Parser) {
    p.pos = 0
    p.kind = p.tokens.kinds[0]
    p.scratch_len = 0
    p.no_struct = false
    p.depth = 0
    parse_file(mut p)
}

// ---- token helpers ---------------------------------------------------

// Records the first mistake, at the current token.
fn parse_fail(p: mut Parser, message: str) {
    parse_fail_at(mut p, message, p.tokens.starts[p.pos])
}

fn parse_fail_at(p: mut Parser, message: str, offset: i64) {
    if !p.failed {
        p.failed = true
        p.error = ParseError { message: message, offset: offset }
    }
}

// Moves to the next token. The end of the file is never passed.
fn bump(p: mut Parser) {
    if p.kind != TOK_EOF {
        p.pos = p.pos + 1
        p.kind = p.tokens.kinds[p.pos]
    }
}

// The span of the current token, which is then passed.
fn take_span(p: mut Parser) -> Span {
    let span = Span { start: p.tokens.starts[p.pos], len: p.tokens.lens[p.pos] }
    bump(mut p)
    return span
}

// Passes the current token if it is of this kind.
fn eat(p: mut Parser, kind: i64) -> bool {
    if p.kind == kind {
        bump(mut p)
        return true
    }
    return false
}

// Passes a token of this kind, or fails.
fn expect(p: mut Parser, kind: i64) {
    if p.kind == kind {
        bump(mut p)
    } else if p.kind == TOK_DOT_DOT || p.kind == TOK_DOT_DOT_EQ {
        range_outside_for(mut p)
    } else {
        parse_fail(mut p, "expected " + describe_token(kind) + " but found " + describe_token(p.kind))
    }
}

// Passes a name and returns its span, or fails saying what was expected.
fn expect_name(p: mut Parser, what: str) -> Span {
    if p.kind == TOK_IDENT { return take_span(mut p) }
    parse_fail(mut p, "expected " + what + " but found " + describe_token(p.kind))
    return Span { start: 0, len: 0 }
}

fn skip_newlines(p: mut Parser) {
    while p.kind == TOK_NEWLINE {
        p.pos = p.pos + 1
        p.kind = p.tokens.kinds[p.pos]
    }
}

fn kind_after_newlines(p: Parser) -> i64 {
    var i = p.pos
    while p.tokens.kinds[i] == TOK_NEWLINE {
        i = i + 1
    }
    return p.tokens.kinds[i]
}

// Counts one more level of nesting; code nested too deeply is refused
// rather than overflowing the stack.
fn enter(p: mut Parser) {
    p.depth = p.depth + 1
    if p.depth > MAX_PARSE_DEPTH { parse_fail(mut p, "code is nested too deeply") }
}

// Where the current token starts.
fn here(p: Parser) -> i64 {
    return p.tokens.starts[p.pos]
}

// Adds an id to the list being collected.
fn collect(p: mut Parser, id: i64) {
    if p.scratch_len < p.scratch.len() {
        p.scratch[p.scratch_len] = id
    } else {
        p.scratch.push(id)
    }
    p.scratch_len = p.scratch_len + 1
}

// Moves the ids collected since `start` into the tree and returns where
// they are.
fn finish_list(p: mut Parser, start: i64) -> IdRange {
    let range = IdRange { start: p.ast.lists.len(), len: p.scratch_len - start }
    var i = start
    while i < p.scratch_len {
        p.ast.lists.push(p.scratch[i])
        i = i + 1
    }
    p.scratch_len = start
    return range
}

fn push_expr(p: mut Parser, expr: Expr, pos: i64) -> i64 {
    p.ast.exprs.push(expr)
    p.ast.expr_pos.push(pos)
    return p.ast.exprs.len() - 1
}

fn push_stmt(p: mut Parser, stmt: Stmt, pos: i64) -> i64 {
    p.ast.stmts.push(stmt)
    p.ast.stmt_pos.push(pos)
    return p.ast.stmts.len() - 1
}

fn empty_range() -> IdRange {
    return IdRange { start: 0, len: 0 }
}

// ---- items -------------------------------------------------------------

fn parse_file(p: mut Parser) {
    while true {
        skip_newlines(mut p)
        match p.kind {
            TOK_EOF => return
            TOK_FN => parse_function(mut p)
            TOK_STRUCT => parse_struct(mut p)
            TOK_ENUM => parse_enum(mut p)
            TOK_CONST => parse_const(mut p)
            _ => parse_fail(mut p, "expected `fn`, `struct`, `enum` or `const` but found " + describe_token(p.kind))
        }
        if p.failed { return }
        if p.kind != TOK_EOF {
            line_end(mut p)
            if p.failed { return }
        }
    }
}

fn line_end(p: mut Parser) {
    if !eat(mut p, TOK_NEWLINE) {
        if p.kind == TOK_DOT_DOT || p.kind == TOK_DOT_DOT_EQ {
            range_outside_for(mut p)
            return
        }
        parse_fail(mut p, "expected end of line but found " + describe_token(p.kind))
    }
}

// `a..b` anywhere but after `for ... in`.
fn range_outside_for(p: mut Parser) {
    parse_fail(mut p, "a range exists only in `for i in a..b`; for a part of a list use `xs.slice(a, b)`")
}

// `[T, U]` after a name, or nothing.
fn parse_generics(p: mut Parser) -> IdRange {
    let start = p.scratch_len
    if eat(mut p, TOK_LBRACKET) {
        while true {
            let name = expect_name(mut p, "a type parameter name")
            if p.failed { return empty_range() }
            p.ast.names.push(name)
            collect(mut p, p.ast.names.len() - 1)
            if !eat(mut p, TOK_COMMA) { break }
        }
        expect(mut p, TOK_RBRACKET)
        if p.failed { return empty_range() }
    }
    return finish_list(mut p, start)
}

fn parse_function(p: mut Parser) {
    let first_expr = p.ast.exprs.len()
    let first_stmt = p.ast.stmts.len()
    let first_pattern = p.ast.patterns.len()
    let first_init = p.ast.field_inits.len()
    bump(mut p)
    let name = expect_name(mut p, "a function name")
    if p.failed { return }
    let generics = parse_generics(mut p)
    if p.failed { return }
    expect(mut p, TOK_LPAREN)
    if p.failed { return }
    let start = p.scratch_len
    skip_newlines(mut p)
    while p.kind != TOK_RPAREN {
        let param_name = expect_name(mut p, "a parameter name")
        if p.failed { return }
        expect(mut p, TOK_COLON)
        if p.failed { return }
        let mutable = eat(mut p, TOK_MUT)
        let ty = parse_type(mut p)
        if p.failed { return }
        p.ast.params.push(Param { name: param_name, mutable: mutable, ty: ty })
        collect(mut p, p.ast.params.len() - 1)
        skip_newlines(mut p)
        if !eat(mut p, TOK_COMMA) { break }
        skip_newlines(mut p)
    }
    expect(mut p, TOK_RPAREN)
    if p.failed { return }
    let params = finish_list(mut p, start)
    var ret = NO_NODE
    if eat(mut p, TOK_ARROW) {
        ret = parse_type(mut p)
        if p.failed { return }
    }
    let body = parse_block(mut p)
    if p.failed { return }
    let nodes = Nodes {
        exprs_start: first_expr,
        exprs_len: p.ast.exprs.len() - first_expr,
        stmts_start: first_stmt,
        stmts_len: p.ast.stmts.len() - first_stmt,
        patterns_start: first_pattern,
        patterns_len: p.ast.patterns.len() - first_pattern,
        field_inits_start: first_init,
        field_inits_len: p.ast.field_inits.len() - first_init,
    }
    p.ast.items.push(ItemFn(name, generics, params, ret, body, nodes))
}

fn parse_struct(p: mut Parser) {
    bump(mut p)
    let name = expect_name(mut p, "a struct name")
    if p.failed { return }
    let generics = parse_generics(mut p)
    if p.failed { return }
    expect(mut p, TOK_LBRACE)
    if p.failed { return }
    let start = p.scratch_len
    while true {
        skip_newlines(mut p)
        if p.kind == TOK_RBRACE { break }
        let field_name = expect_name(mut p, "a field name")
        if p.failed { return }
        expect(mut p, TOK_COLON)
        if p.failed { return }
        let ty = parse_type(mut p)
        if p.failed { return }
        p.ast.fields.push(FieldDecl { name: field_name, ty: ty })
        collect(mut p, p.ast.fields.len() - 1)
        member_separator(mut p)
        if p.failed { return }
    }
    bump(mut p)
    let fields = finish_list(mut p, start)
    p.ast.items.push(ItemStruct(name, generics, fields))
}

fn parse_enum(p: mut Parser) {
    bump(mut p)
    let name = expect_name(mut p, "an enum name")
    if p.failed { return }
    let generics = parse_generics(mut p)
    if p.failed { return }
    expect(mut p, TOK_LBRACE)
    if p.failed { return }
    let start = p.scratch_len
    while true {
        skip_newlines(mut p)
        if p.kind == TOK_RBRACE { break }
        let variant_name = expect_name(mut p, "a variant name")
        if p.failed { return }
        let field_start = p.scratch_len
        if eat(mut p, TOK_LPAREN) {
            while true {
                let ty = parse_type(mut p)
                if p.failed { return }
                collect(mut p, ty)
                if !eat(mut p, TOK_COMMA) { break }
            }
            expect(mut p, TOK_RPAREN)
            if p.failed { return }
        }
        let fields = finish_list(mut p, field_start)
        p.ast.variants.push(VariantDecl { name: variant_name, fields: fields })
        collect(mut p, p.ast.variants.len() - 1)
        member_separator(mut p)
        if p.failed { return }
    }
    bump(mut p)
    let variants = finish_list(mut p, start)
    p.ast.items.push(ItemEnum(name, generics, variants))
}

fn parse_const(p: mut Parser) {
    bump(mut p)
    let name = expect_name(mut p, "a constant name")
    if p.failed { return }
    var ty = NO_NODE
    if eat(mut p, TOK_COLON) {
        ty = parse_type(mut p)
        if p.failed { return }
    }
    expect(mut p, TOK_ASSIGN)
    if p.failed { return }
    let value = parse_expr(mut p)
    if p.failed { return }
    p.ast.items.push(ItemConst(name, ty, value))
}

// Members of a struct or enum are separated by a newline or a comma.
fn member_separator(p: mut Parser) {
    if eat(mut p, TOK_COMMA) || p.kind == TOK_NEWLINE || p.kind == TOK_RBRACE { return }
    parse_fail(mut p, "expected a new line, `,` or `}` but found " + describe_token(p.kind))
}

// A type: a name, with type arguments in `[...]` if it takes any.
fn parse_type(p: mut Parser) -> i64 {
    enter(mut p)
    if p.failed { return NO_NODE }
    let name = expect_name(mut p, "a type")
    if p.failed { return NO_NODE }
    let start = p.scratch_len
    if eat(mut p, TOK_LBRACKET) {
        while true {
            let arg = parse_type(mut p)
            if p.failed { return NO_NODE }
            collect(mut p, arg)
            if !eat(mut p, TOK_COMMA) { break }
        }
        expect(mut p, TOK_RBRACKET)
        if p.failed { return NO_NODE }
    }
    let args = finish_list(mut p, start)
    p.depth = p.depth - 1
    p.ast.types.push(TypeNode { name: name, args: args })
    return p.ast.types.len() - 1
}

// ---- statements --------------------------------------------------------

// `{`, statements one per line, `}`.
fn parse_block(p: mut Parser) -> IdRange {
    enter(mut p)
    if p.failed { return empty_range() }
    expect(mut p, TOK_LBRACE)
    if p.failed { return empty_range() }
    let saved = p.no_struct
    p.no_struct = false
    let start = p.scratch_len
    while true {
        skip_newlines(mut p)
        if eat(mut p, TOK_RBRACE) { break }
        if p.kind == TOK_EOF {
            parse_fail(mut p, "expected `}` to close the block but reached end of file")
            return empty_range()
        }
        let stmt = parse_statement(mut p)
        if p.failed { return empty_range() }
        collect(mut p, stmt)
        if p.kind != TOK_RBRACE {
            line_end(mut p)
            if p.failed { return empty_range() }
        }
    }
    p.no_struct = saved
    p.depth = p.depth - 1
    return finish_list(mut p, start)
}

// True for what can stand on the left of `=`.
fn is_assignable(expr: Expr) -> bool {
    match expr {
        ExprIdent(name) => return true
        ExprField(base, name) => return true
        ExprIndex(base, index) => return true
        _ => return false
    }
}

// The operator of `a op= b`, for the token of `op=`.
fn compound_operator(kind: i64) -> BinOp {
    match kind {
        TOK_PLUS_ASSIGN => return BinAdd
        TOK_MINUS_ASSIGN => return BinSub
        TOK_STAR_ASSIGN => return BinMul
        TOK_SLASH_ASSIGN => return BinDiv
        TOK_PERCENT_ASSIGN => return BinRem
        TOK_AMP_ASSIGN => return BinBitAnd
        TOK_PIPE_ASSIGN => return BinBitOr
        TOK_CARET_ASSIGN => return BinBitXor
        TOK_SHL_ASSIGN => return BinShl
        _ => return BinShr
    }
}

// A second copy of an expression that names a place or is part of an
// index of one, for the reading side of `a op= b`. Only what can be
// evaluated twice without anyone noticing is copied: names, numbers,
// fields, indexes and arithmetic on them. Anything else gives `NO_NODE`.
fn copy_place(p: mut Parser, id: i64) -> i64 {
    let pos = p.ast.expr_pos[id]
    let expr = p.ast.exprs[id]
    match expr {
        ExprIdent(name) => return push_expr(mut p, ExprIdent(name), pos)
        ExprInt(text) => return push_expr(mut p, ExprInt(text), pos)
        ExprBool(value) => return push_expr(mut p, ExprBool(value), pos)
        ExprField(base, name) => {
            let inner = copy_place(mut p, base)
            if inner == NO_NODE { return NO_NODE }
            return push_expr(mut p, ExprField(inner, name), pos)
        }
        ExprIndex(base, index) => {
            let inner = copy_place(mut p, base)
            if inner == NO_NODE { return NO_NODE }
            let at = copy_place(mut p, index)
            if at == NO_NODE { return NO_NODE }
            return push_expr(mut p, ExprIndex(inner, at), pos)
        }
        ExprUnary(op, operand) => {
            let inner = copy_place(mut p, operand)
            if inner == NO_NODE { return NO_NODE }
            return push_expr(mut p, ExprUnary(op, inner), pos)
        }
        ExprBinary(op, lhs, rhs) => {
            let left = copy_place(mut p, lhs)
            if left == NO_NODE { return NO_NODE }
            let right = copy_place(mut p, rhs)
            if right == NO_NODE { return NO_NODE }
            return push_expr(mut p, ExprBinary(op, left, right), pos)
        }
        _ => return NO_NODE
    }
}

// True when the token after the current one is of this kind and
// touches it: the two signs of `++`.
fn doubled_sign(p: Parser, kind: i64) -> bool {
    return p.kind == kind && p.tokens.kinds[p.pos + 1] == kind &&
        p.tokens.starts[p.pos + 1] == p.tokens.starts[p.pos] + 1
}

fn parse_statement(p: mut Parser) -> i64 {
    let pos = here(p)
    if doubled_sign(p, TOK_PLUS) {
        parse_fail(mut p, "azoL has no `++`; write `x += 1`")
        return NO_NODE
    }
    match p.kind {
        TOK_LET => return parse_let(mut p, pos)
        TOK_VAR => return parse_let(mut p, pos)
        TOK_RETURN => {
            bump(mut p)
            if p.kind == TOK_NEWLINE || p.kind == TOK_RBRACE || p.kind == TOK_EOF {
                return push_stmt(mut p, StmtReturn(NO_NODE), pos)
            }
            let value = parse_expr(mut p)
            if p.failed { return NO_NODE }
            return push_stmt(mut p, StmtReturn(value), pos)
        }
        TOK_IF => return parse_if(mut p)
        TOK_WHILE => {
            bump(mut p)
            let cond = parse_condition(mut p)
            if p.failed { return NO_NODE }
            let body = parse_block(mut p)
            if p.failed { return NO_NODE }
            return push_stmt(mut p, StmtWhile(cond, body), pos)
        }
        TOK_FOR => {
            bump(mut p)
            let first = expect_name(mut p, "a loop variable name")
            if p.failed { return NO_NODE }
            var index = Span { start: 0, len: 0 }
            var item = first
            if eat(mut p, TOK_COMMA) {
                index = first
                item = expect_name(mut p, "a loop variable name")
                if p.failed { return NO_NODE }
            }
            let in_word = Span { start: here(p), len: 2 }
            expect(mut p, TOK_IN)
            if p.failed { return NO_NODE }
            let iter = parse_condition(mut p)
            if p.failed { return NO_NODE }
            if p.kind == TOK_DOT_DOT || p.kind == TOK_DOT_DOT_EQ {
                if index.len > 0 {
                    let message = "a loop over a range has one variable, the number itself: write `for " +
                        span_text(p.src, item) + " in a..b`"
                    parse_fail_at(mut p, message, index.start)
                    return NO_NODE
                }
                return parse_range_loop(mut p, pos, item, in_word, iter)
            }
            let body = parse_block(mut p)
            if p.failed { return NO_NODE }
            return push_stmt(mut p, StmtFor(index, item, iter, body), pos)
        }
        TOK_MATCH => return parse_match(mut p, pos)
        TOK_CONST => {
            parse_fail(mut p, "a constant is declared outside functions; use `let` for a value inside one")
            return NO_NODE
        }
        TOK_BREAK => {
            bump(mut p)
            return push_stmt(mut p, StmtBreak, pos)
        }
        TOK_CONTINUE => {
            bump(mut p)
            return push_stmt(mut p, StmtContinue, pos)
        }
        _ => {}
    }
    // An expression on its own, or an assignment.
    let expr = parse_expr(mut p)
    if p.failed { return NO_NODE }
    if p.kind >= TOK_PLUS_ASSIGN && p.kind <= TOK_SHR_ASSIGN {
        // `a op= b` is `a = a op b`. The place is written once and read
        // through a second copy of its expression.
        let op = compound_operator(p.kind)
        bump(mut p)
        if !is_assignable(p.ast.exprs[expr]) {
            parse_fail_at(mut p, "cannot assign to this expression", pos)
            return NO_NODE
        }
        let read = copy_place(mut p, expr)
        if read == NO_NODE {
            parse_fail_at(mut p, "the place of `" + binop_symbol(op) +
                    "=` is worked out twice, so its index cannot call a function; give the index a name with `let` first", pos)
            return NO_NODE
        }
        skip_newlines(mut p)
        let operand = parse_expr(mut p)
        if p.failed { return NO_NODE }
        var value = NO_NODE
        if operand == p.text_chain && is_add(op) {
            value = join_text(mut p, read, operand)
        } else {
            value = push_expr(mut p, ExprBinary(op, read, operand), pos)
        }
        return push_stmt(mut p, StmtAssign(expr, value), pos)
    }
    if !eat(mut p, TOK_ASSIGN) { return push_stmt(mut p, StmtExpr(expr), pos) }
    if !is_assignable(p.ast.exprs[expr]) {
        parse_fail_at(mut p, "cannot assign to this expression", pos)
        return NO_NODE
    }
    // `x =+ 1` and `x =- 1`: the two signs of `+=` the wrong way round.
    // A sign that touches `=` and stands apart from what follows is that
    // slip; `x = -1` and `x =-1` stay what they are.
    let equals = p.tokens.starts[p.pos - 1]
    if p.tokens.starts[p.pos] == equals + 1 {
        if p.kind == TOK_PLUS {
            parse_fail_at(mut p, "azoL has no `=+`; write `x += 1`", equals)
            return NO_NODE
        }
        if p.kind == TOK_MINUS && p.tokens.starts[p.pos + 1] > equals + 2 {
            parse_fail_at(mut p, "azoL has no `=-`; write `x -= 1`, or `x = -1` for the negative number", equals)
            return NO_NODE
        }
    }
    skip_newlines(mut p)
    let value = parse_expr(mut p)
    if p.failed { return NO_NODE }
    return push_stmt(mut p, StmtAssign(expr, value), pos)
}

// A number that is not written in the source: `value` itself. The
// checker reads a number whose span is empty from the span's start.
fn hidden_number(p: mut Parser, value: i64, pos: i64) -> i64 {
    return push_expr(mut p, ExprInt(Span { start: value, len: 0 }), pos)
}

fn hidden_name(p: mut Parser, name: Span, pos: i64) -> i64 {
    return push_expr(mut p, ExprIdent(name), pos)
}

// True when a number token is zero whatever its base: no digit in it
// other than `0`.
fn is_zero_literal(src: str, span: Span) -> bool {
    var i = 0
    while i < span.len {
        let b = src[span.start + i]
        if b != '0' && b != '_' && !(i == 1 && (b == 'x' || b == 'b')) { return false }
        i = i + 1
    }
    return true
}

// `for i in a..b`, `for i in a..=b`, either with `step k`: the rest of
// the loop after `a`, with the parser at the range sign.
//
// A range is not a value and the loop has no node of its own: it is
// built here from what the checker and the generators already know,
//
//     if true {
//         var next = a
//         let end = b
//         while next < end {
//             let i = next
//             next = next + 1
//             ...the body...
//         }
//     }
//
// The step is taken before the body, so `continue` needs nothing
// special. `next`, `end` and `more` are named by the texts of the range
// sign, of `in` and of `for`, which no variable of the program can be
// called. Their statements start at `for`, which is how the checker
// knows them (`ck_let`). Any loop other than the plain `a..b` keeps a
// `bool`, worked out before the step from the distance left, so that it
// stops at the end even where one more step would wrap around:
//
//         var more = next <= end
//         while more {
//             let i = next
//             more = end - i < 0 || end - i >= k
//             next = next + k
//             ...
fn parse_range_loop(p: mut Parser, pos: i64, item: Span, end_name: Span, from: i64) -> i64 {
    let inclusive = p.kind == TOK_DOT_DOT_EQ
    let next_name = take_span(mut p)
    let more_name = Span { start: pos, len: 3 }
    let to = parse_condition(mut p)
    if p.failed { return NO_NODE }
    // The step: one, or the number after `step`, which may be negative.
    var down = false
    var size = Span { start: 1, len: 0 }
    var one = true
    if p.kind == TOK_IDENT && span_is(p.src, Span { start: here(p), len: p.tokens.lens[p.pos] }, "step") {
        bump(mut p)
        let step_pos = here(p)
        if eat(mut p, TOK_MINUS) { down = true }
        if p.kind != TOK_INT || p.src[here(p)] == '\'' {
            parse_fail_at(mut p, "the step of a range is a number written out, as in `step 2` or `step -1`", step_pos)
            return NO_NODE
        }
        size = take_span(mut p)
        if is_zero_literal(p.src, size) {
            parse_fail_at(mut p, "the step of a range cannot be zero", step_pos)
            return NO_NODE
        }
        one = span_is(p.src, size, "1")
    }
    let body = parse_block(mut p)
    if p.failed { return NO_NODE }
    let plain = one && !down && !inclusive
    let scratch = p.scratch_len

    // var next = a; let end = b
    let first_let = push_stmt(mut p, StmtLet(true, next_name, NO_NODE, from), pos)
    collect(mut p, first_let)
    let second_let = push_stmt(mut p, StmtLet(false, end_name, NO_NODE, to), pos)
    collect(mut p, second_let)
    var cond = NO_NODE
    if plain {
        let left = hidden_name(mut p, next_name, pos)
        let right = hidden_name(mut p, end_name, pos)
        cond = push_expr(mut p, ExprBinary(BinLt, left, right), pos)
    } else {
        // var more = next <op> end
        var first = BinLt
        if down && inclusive {
            first = BinGtEq
        } else if down {
            first = BinGt
        } else if inclusive {
            first = BinLtEq
        }
        let left = hidden_name(mut p, next_name, pos)
        let right = hidden_name(mut p, end_name, pos)
        let start_value = push_expr(mut p, ExprBinary(first, left, right), pos)
        let third_let = push_stmt(mut p, StmtLet(true, more_name, NO_NODE, start_value), pos)
        collect(mut p, third_let)
        cond = hidden_name(mut p, more_name, pos)
    }
    let outer = finish_list(mut p, scratch)

    // The body: let i = next; (more = ...;) next = next +/- k; the rest.
    let inner_start = p.ast.lists.len()
    var inner_len = body.len + 2
    let read_next = hidden_name(mut p, next_name, pos)
    let bind = push_stmt(mut p, StmtLet(false, item, NO_NODE, read_next), pos)
    p.ast.lists.push(bind)
    if !plain {
        inner_len = inner_len + 1
        var value = NO_NODE
        if one && inclusive {
            // more = i < end (or i > end going down)
            let i_now = hidden_name(mut p, item, pos)
            let end_now = hidden_name(mut p, end_name, pos)
            if down {
                value = push_expr(mut p, ExprBinary(BinGt, i_now, end_now), pos)
            } else {
                value = push_expr(mut p, ExprBinary(BinLt, i_now, end_now), pos)
            }
        } else {
            // more = d < 0 || d >= k (or d > k), d the distance left.
            var reach = BinGt
            if inclusive { reach = BinGtEq }
            var a1 = hidden_name(mut p, end_name, pos)
            var b1 = hidden_name(mut p, item, pos)
            var a2 = hidden_name(mut p, end_name, pos)
            var b2 = hidden_name(mut p, item, pos)
            if down {
                a1 = hidden_name(mut p, item, pos)
                b1 = hidden_name(mut p, end_name, pos)
                a2 = hidden_name(mut p, item, pos)
                b2 = hidden_name(mut p, end_name, pos)
            }
            let d1 = push_expr(mut p, ExprBinary(BinSub, a1, b1), pos)
            let zero = hidden_number(mut p, 0, pos)
            let wrapped = push_expr(mut p, ExprBinary(BinLt, d1, zero), pos)
            let d2 = push_expr(mut p, ExprBinary(BinSub, a2, b2), pos)
            let k = push_expr(mut p, ExprInt(size), pos)
            let far = push_expr(mut p, ExprBinary(reach, d2, k), pos)
            value = push_expr(mut p, ExprBinary(BinOr, wrapped, far), pos)
        }
        let target = hidden_name(mut p, more_name, pos)
        let update = push_stmt(mut p, StmtAssign(target, value), pos)
        p.ast.lists.push(update)
    }
    let step_target = hidden_name(mut p, next_name, pos)
    let step_read = hidden_name(mut p, next_name, pos)
    let step_size = push_expr(mut p, ExprInt(size), pos)
    var step_op = BinAdd
    if down { step_op = BinSub }
    let stepped = push_expr(mut p, ExprBinary(step_op, step_read, step_size), pos)
    let advance = push_stmt(mut p, StmtAssign(step_target, stepped), pos)
    p.ast.lists.push(advance)
    var i = 0
    while i < body.len {
        let id = p.ast.lists[body.start + i]
        p.ast.lists.push(id)
        i = i + 1
    }
    let loop_stmt = push_stmt(mut p, StmtWhile(cond, IdRange { start: inner_start, len: inner_len }), pos)
    // The whole: if true { var next ...; while ... }
    let whole_start = p.ast.lists.len()
    i = 0
    while i < outer.len {
        let id = p.ast.lists[outer.start + i]
        p.ast.lists.push(id)
        i = i + 1
    }
    p.ast.lists.push(loop_stmt)
    let always = push_expr(mut p, ExprBool(true), pos)
    return push_stmt(mut p, StmtIf(always, IdRange { start: whole_start, len: outer.len + 1 }, ElseNone), pos)
}

// True for a token that can follow a whole statement.
fn ends_statement(kind: i64) -> bool {
    return kind == TOK_NEWLINE || kind == TOK_RBRACE || kind == TOK_EOF
}

// `let name = value` and `var name: Type = value`.
fn parse_let(p: mut Parser, pos: i64) -> i64 {
    let mutable = p.kind == TOK_VAR
    bump(mut p)
    let name = expect_name(mut p, "a variable name")
    if p.failed { return NO_NODE }
    var ty = NO_NODE
    if eat(mut p, TOK_COLON) {
        ty = parse_type(mut p)
        if p.failed { return NO_NODE }
    }
    expect(mut p, TOK_ASSIGN)
    if p.failed { return NO_NODE }
    skip_newlines(mut p)
    let value = parse_expr(mut p)
    if p.failed { return NO_NODE }
    return push_stmt(mut p, StmtLet(mutable, name, ty, value), pos)
}

fn parse_if(p: mut Parser) -> i64 {
    enter(mut p)
    if p.failed { return NO_NODE }
    let pos = here(p)
    bump(mut p)
    let cond = parse_condition(mut p)
    if p.failed { return NO_NODE }
    let then_block = parse_block(mut p)
    if p.failed { return NO_NODE }
    var else_branch = ElseNone
    if kind_after_newlines(p) == TOK_ELSE {
        skip_newlines(mut p)
        bump(mut p)
        if p.kind == TOK_IF {
            let next = parse_if(mut p)
            if p.failed { return NO_NODE }
            else_branch = ElseIf(next)
        } else {
            let body = parse_block(mut p)
            if p.failed { return NO_NODE }
            else_branch = ElseBlock(body)
        }
    }
    p.depth = p.depth - 1
    return push_stmt(mut p, StmtIf(cond, then_block, else_branch), pos)
}

fn parse_match(p: mut Parser, pos: i64) -> i64 {
    bump(mut p)
    let scrutinee = parse_condition(mut p)
    if p.failed { return NO_NODE }
    expect(mut p, TOK_LBRACE)
    if p.failed { return NO_NODE }
    let start = p.scratch_len
    while true {
        skip_newlines(mut p)
        if p.kind == TOK_RBRACE { break }
        let pattern = parse_pattern(mut p)
        if p.failed { return NO_NODE }
        expect(mut p, TOK_FAT_ARROW)
        if p.failed { return NO_NODE }
        var body = empty_range()
        if p.kind == TOK_LBRACE {
            body = parse_block(mut p)
            if p.failed { return NO_NODE }
        } else {
            // One statement without braces.
            let body_start = p.scratch_len
            let saved = p.no_struct
            p.no_struct = false
            let stmt = parse_statement(mut p)
            if p.failed { return NO_NODE }
            p.no_struct = saved
            collect(mut p, stmt)
            body = finish_list(mut p, body_start)
        }
        p.ast.arms.push(Arm { pattern: pattern, body: body })
        collect(mut p, p.ast.arms.len() - 1)
        member_separator(mut p)
        if p.failed { return NO_NODE }
    }
    bump(mut p)
    let arms = finish_list(mut p, start)
    return push_stmt(mut p, StmtMatch(scrutinee, arms), pos)
}

fn push_pattern(p: mut Parser, pattern: Pattern, pos: i64) -> i64 {
    p.depth = p.depth - 1
    p.ast.patterns.push(pattern)
    p.ast.pat_pos.push(pos)
    return p.ast.patterns.len() - 1
}

fn parse_pattern(p: mut Parser) -> i64 {
    enter(mut p)
    if p.failed { return NO_NODE }
    let pos = here(p)
    match p.kind {
        TOK_IDENT => {
            let name = take_span(mut p)
            if eat(mut p, TOK_LPAREN) {
                let start = p.scratch_len
                while true {
                    let arg = parse_pattern(mut p)
                    if p.failed { return NO_NODE }
                    collect(mut p, arg)
                    if !eat(mut p, TOK_COMMA) { break }
                }
                expect(mut p, TOK_RPAREN)
                if p.failed { return NO_NODE }
                let args = finish_list(mut p, start)
                return push_pattern(mut p, PatVariant(name, args), pos)
            }
            if name.len == 1 && p.src[name.start] == '_' {
                return push_pattern(mut p, PatWildcard, pos)
            }
            return push_pattern(mut p, PatName(name), pos)
        }
        TOK_INT => {
            let digits = take_span(mut p)
            return push_pattern(mut p, PatInt(false, digits), pos)
        }
        TOK_MINUS => {
            bump(mut p)
            let digits = Span { start: p.tokens.starts[p.pos], len: p.tokens.lens[p.pos] }
            expect(mut p, TOK_INT)
            if p.failed { return NO_NODE }
            return push_pattern(mut p, PatInt(true, digits), pos)
        }
        TOK_STR => {
            let text = take_span(mut p)
            var i = text.start + 1
            while i < text.start + text.len - 1 {
                if p.src[i] == '{' {
                    parse_fail_at(mut p, "a pattern is a fixed text and holds no values; write `\\\{` for a brace", i)
                    return NO_NODE
                }
                if p.src[i] == '\\' { i = i + 1 }
                i = i + 1
            }
            return push_pattern(mut p, PatStr(text), pos)
        }
        TOK_TRUE => {
            bump(mut p)
            return push_pattern(mut p, PatBool(true), pos)
        }
        TOK_FALSE => {
            bump(mut p)
            return push_pattern(mut p, PatBool(false), pos)
        }
        _ => {
            parse_fail(mut p, "expected a pattern but found " + describe_token(p.kind))
            return NO_NODE
        }
    }
}

// ---- expressions -------------------------------------------------------

fn parse_expr(p: mut Parser) -> i64 {
    return parse_binary(mut p, 1)
}

// An expression directly followed by `{`, as in `if`, `while`, `for`
// and `match`.
fn parse_condition(p: mut Parser) -> i64 {
    let saved = p.no_struct
    p.no_struct = true
    let result = parse_expr(mut p)
    p.no_struct = saved
    // `if p == Point { x: 1 } {`: the `{` after a name starts the block
    // here, and no statement begins with `name:`.
    if !p.failed && p.kind == TOK_LBRACE && p.tokens.kinds[p.pos - 1] == TOK_IDENT {
        var next = p.pos + 1
        while p.tokens.kinds[next] == TOK_NEWLINE {
            next = next + 1
        }
        if p.tokens.kinds[next] == TOK_IDENT && p.tokens.kinds[next + 1] == TOK_COLON {
            let name = Span { start: p.tokens.starts[p.pos - 1], len: p.tokens.lens[p.pos - 1] }
            let message = "a struct literal here needs parentheses around it, `(" + span_text(p.src, name)
            parse_fail_at(mut p, message + " \{ ... })`: this `\{` starts the block", name.start)
            return NO_NODE
        }
    }
    return result
}

// How tightly a binary operator binds, or 0 for a token that is not one.
fn binary_precedence(kind: i64) -> i64 {
    match kind {
        TOK_OR_OR => return 1
        TOK_AND_AND => return 2
        TOK_EQ => return 3
        TOK_NOT_EQ => return 3
        TOK_LT => return 3
        TOK_LT_EQ => return 3
        TOK_GT => return 3
        TOK_GT_EQ => return 3
        TOK_PIPE => return 4
        TOK_CARET => return 5
        TOK_AMP => return 6
        TOK_SHL => return 7
        TOK_SHR => return 7
        TOK_PLUS => return 8
        TOK_MINUS => return 8
        TOK_STAR => return 9
        TOK_SLASH => return 9
        TOK_PERCENT => return 9
        _ => return 0
    }
}

// The operator a token stands for. Only called for binary operators.
fn binary_operator(kind: i64) -> BinOp {
    match kind {
        TOK_OR_OR => return BinOr
        TOK_AND_AND => return BinAnd
        TOK_EQ => return BinEq
        TOK_NOT_EQ => return BinNotEq
        TOK_LT => return BinLt
        TOK_LT_EQ => return BinLtEq
        TOK_GT => return BinGt
        TOK_GT_EQ => return BinGtEq
        TOK_PIPE => return BinBitOr
        TOK_CARET => return BinBitXor
        TOK_AMP => return BinBitAnd
        TOK_SHL => return BinShl
        TOK_SHR => return BinShr
        TOK_PLUS => return BinAdd
        TOK_MINUS => return BinSub
        TOK_STAR => return BinMul
        TOK_SLASH => return BinDiv
        _ => return BinRem
    }
}

fn parse_binary(p: mut Parser, min_prec: i64) -> i64 {
    var lhs = parse_unary(mut p)
    if p.failed { return NO_NODE }
    while true {
        // The common case first: what follows is not an operator at all.
        if p.kind < TOK_EQ || p.kind > TOK_SHR { break }
        let prec = binary_precedence(p.kind)
        if prec == 0 || prec < min_prec { break }
        if p.kind == TOK_PLUS || p.kind == TOK_MINUS {
            // `x++` and `x--` from other languages.
            if doubled_sign(p, TOK_PLUS) {
                parse_fail(mut p, "azoL has no `++`; write `x += 1`")
                return NO_NODE
            }
            if doubled_sign(p, TOK_MINUS) && ends_statement(p.tokens.kinds[p.pos + 2]) {
                parse_fail(mut p, "azoL has no `--`; write `x -= 1`")
                return NO_NODE
            }
        }
        let op = binary_operator(p.kind)
        bump(mut p)
        skip_newlines(mut p)
        let rhs = parse_binary(mut p, prec + 1)
        if p.failed { return NO_NODE }
        let pos = p.ast.expr_pos[lhs]
        if rhs == p.text_chain && is_add(op) {
            lhs = join_text(mut p, lhs, rhs)
        } else {
            lhs = push_expr(mut p, ExprBinary(op, lhs, rhs), pos)
        }
    }
    return lhs
}

fn is_add(op: BinOp) -> bool {
    match op {
        BinAdd => return true
        _ => return false
    }
}

// `"total: {sum}, {n} items"`: a text with values. The lexer leaves the
// literal one token, so `azol fmt` and `azol lex` see it whole; here it
// becomes the chain `"total: " + text(sum) + ", " + text(n) + " items"`
// of nodes that exist. Each piece of text is an `ExprStr` whose span has
// no quotes around it, and each value is the argument of a call of a
// function whose name is empty, which the checker reads as "the text of
// this value". `span` is the literal with its quotes.
fn parse_text(p: mut Parser, span: Span) -> i64 {
    let end = span.start + span.len - 1
    let after = p.pos
    var result = NO_NODE
    var from = span.start + 1
    var i = from
    while i < end {
        let b = p.src[i]
        if b == '\\' {
            i = i + 2
            continue
        }
        if b != '{' {
            i = i + 1
            continue
        }
        // The value goes up to the next `}`.
        var k = i + 1
        var blank = true
        var digits = true
        var colon = false
        while k < end && p.src[k] != '}' {
            let v = p.src[k]
            if v == '{' || (v == '\\' && k + 1 < end && p.src[k + 1] == '"') {
                parse_fail_at(mut p, "a value in a text cannot hold a text or a brace of its own; give the value a name with `let` first",
                    k)
                return NO_NODE
            }
            if v != ' ' { blank = false }
            if v < '0' || v > '9' { digits = false }
            if v == ':' { colon = true }
            k = k + 1
        }
        if k >= end {
            let next = p.tokens.kinds[after]
            if p.tokens.starts[after] == span.start + span.len &&
                (next == TOK_IDENT || next == TOK_INT || next == TOK_FLOAT || next == TOK_STR) {
                parse_fail_at(mut p, "a value in a text cannot hold a text or a brace of its own; give the value a name with `let` first",
                    span.start + span.len - 1)
            } else {
                parse_fail_at(mut p, "this `\{` starts a value in the text, but no `}` ends it; write `\\\{` for a brace", i)
            }
            return NO_NODE
        }
        if blank {
            parse_fail_at(mut p, "`\{}` in a text holds no value; write `\\\{}` for the braces themselves", i)
            return NO_NODE
        }
        if i > span.start + 1 && p.src[i - 1] == '$' {
            parse_fail_at(mut p, "a value in a text is written `\{value}`, without `$`", i - 1)
            return NO_NODE
        }
        if digits {
            parse_fail_at(mut p, "a value in a text is written where it goes, `\{value}`, not numbered and given afterwards", i)
            return NO_NODE
        }
        if colon {
            parse_fail_at(mut p, "a value in a text has no format after `:`; base and padding are methods, as in `\{n.to_hex()}`",
                i)
            return NO_NODE
        }
        // The tokens of the value come after those of the file for as
        // long as it is parsed.
        let mark = p.tokens.kinds.len()
        var tokens = new_tokens()
        match lex_part(p.src, i + 1, k, mut tokens) {
            Some(mistake) => {
                parse_fail_at(mut p, mistake.message, mistake.offset)
                return NO_NODE
            }
            None => {}
        }
        var t = 0
        while t < tokens.kinds.len() {
            p.tokens.kinds.push(tokens.kinds[t])
            p.tokens.starts.push(tokens.starts[t])
            p.tokens.lens.push(tokens.lens[t])
            t = t + 1
        }
        p.pos = mark
        p.kind = p.tokens.kinds[mark]
        let no_struct = p.no_struct
        p.no_struct = false
        let value = parse_expr(mut p)
        if !p.failed && p.kind != TOK_EOF {
            parse_fail(mut p, "a value in a text is one expression, and this is more than one; write `\\\{` if a brace was meant")
        }
        while p.tokens.kinds.len() > mark {
            p.tokens.kinds.pop()
            p.tokens.starts.pop()
            p.tokens.lens.pop()
        }
        p.no_struct = no_struct
        p.pos = after
        p.kind = p.tokens.kinds[after]
        if p.failed { return NO_NODE }
        if i > from {
            let piece = push_expr(mut p, ExprStr(Span { start: from, len: i - from }), from)
            result = text_join(mut p, result, piece, span.start)
        }
        let callee = push_expr(mut p, ExprIdent(Span { start: i, len: 0 }), i)
        let start = p.scratch_len
        collect(mut p, value)
        let args = finish_list(mut p, start)
        let call = push_expr(mut p, ExprCall(callee, args), i)
        result = text_join(mut p, result, call, span.start)
        i = k + 1
        from = i
    }
    if end > from {
        let piece = push_expr(mut p, ExprStr(Span { start: from, len: end - from }), from)
        result = text_join(mut p, result, piece, span.start)
    }
    if result == NO_NODE {
        // Every `{` was written `\{`.
        return push_expr(mut p, ExprStr(span), span.start)
    }
    p.text_chain = result
    return result
}

fn text_join(p: mut Parser, left: i64, right: i64, pos: i64) -> i64 {
    if left == NO_NODE { return right }
    return push_expr(mut p, ExprBinary(BinAdd, left, right), pos)
}

// `left + "a{x}b"`, where the text is the chain `chain`: the same as
// `left + "a" + text(x) + "b"`, so that what is appended to a text is
// appended piece by piece, in place, and not built on the side first.
fn join_text(p: mut Parser, left: i64, chain: i64) -> i64 {
    let pos = p.ast.expr_pos[left]
    var at = chain
    var first = NO_NODE
    var second = NO_NODE
    while true {
        var inner = NO_NODE
        var right = NO_NODE
        let node = p.ast.exprs[at]
        match node {
            ExprBinary(_, lhs, rhs) => {
                inner = lhs
                right = rhs
            }
            _ => {}
        }
        if inner == NO_NODE { break }
        p.ast.expr_pos[at] = pos
        first = at
        second = right
        at = inner
    }
    let joined = push_expr(mut p, ExprBinary(BinAdd, left, at), pos)
    p.text_chain = NO_NODE
    if first == NO_NODE { return joined }
    p.ast.exprs[first] = ExprBinary(BinAdd, joined, second)
    return chain
}

fn parse_unary(p: mut Parser) -> i64 {
    if p.kind != TOK_MINUS && p.kind != TOK_BANG { return parse_postfix(mut p) }
    var op = OpNeg
    if p.kind == TOK_BANG { op = OpNot }
    enter(mut p)
    if p.failed { return NO_NODE }
    let pos = here(p)
    bump(mut p)
    let operand = parse_unary(mut p)
    if p.failed { return NO_NODE }
    p.depth = p.depth - 1
    return push_expr(mut p, ExprUnary(op, operand), pos)
}

// A primary expression followed by any number of calls, indexes and
// field accesses.
fn parse_postfix(p: mut Parser) -> i64 {
    var expr = parse_primary(mut p)
    if p.failed { return NO_NODE }
    let pos = p.ast.expr_pos[expr]
    while true {
        if p.kind == TOK_LPAREN {
            bump(mut p)
            let saved = p.no_struct
            p.no_struct = false
            let start = p.scratch_len
            skip_newlines(mut p)
            while p.kind != TOK_RPAREN {
                let arg_pos = here(p)
                var arg = NO_NODE
                if eat(mut p, TOK_MUT) {
                    let value = parse_expr(mut p)
                    if p.failed { return NO_NODE }
                    arg = push_expr(mut p, ExprMutArg(value), arg_pos)
                } else {
                    arg = parse_expr(mut p)
                    if p.failed { return NO_NODE }
                }
                collect(mut p, arg)
                skip_newlines(mut p)
                if !eat(mut p, TOK_COMMA) { break }
                skip_newlines(mut p)
            }
            expect(mut p, TOK_RPAREN)
            if p.failed { return NO_NODE }
            p.no_struct = saved
            let args = finish_list(mut p, start)
            expr = push_expr(mut p, ExprCall(expr, args), pos)
        } else if p.kind == TOK_LBRACKET {
            bump(mut p)
            let saved = p.no_struct
            p.no_struct = false
            skip_newlines(mut p)
            let index = parse_expr(mut p)
            if p.failed { return NO_NODE }
            skip_newlines(mut p)
            expect(mut p, TOK_RBRACKET)
            if p.failed { return NO_NODE }
            p.no_struct = saved
            expr = push_expr(mut p, ExprIndex(expr, index), pos)
        } else if p.kind == TOK_DOT {
            bump(mut p)
            let name = expect_name(mut p, "a field name")
            if p.failed { return NO_NODE }
            expr = push_expr(mut p, ExprField(expr, name), pos)
        } else if p.kind == TOK_QUESTION {
            bump(mut p)
            expr = push_expr(mut p, ExprTry(expr), pos)
        } else if p.kind == TOK_NEWLINE && kind_after_newlines(p) == TOK_DOT {
            // A line that starts with `.` continues the previous one.
            skip_newlines(mut p)
        } else {
            return expr
        }
    }
    return expr
}

fn parse_primary(p: mut Parser) -> i64 {
    let pos = here(p)
    match p.kind {
        TOK_INT => {
            let span = take_span(mut p)
            return push_expr(mut p, ExprInt(span), pos)
        }
        TOK_FLOAT => {
            let span = take_span(mut p)
            return push_expr(mut p, ExprFloat(span), pos)
        }
        TOK_STR => {
            let span = take_span(mut p)
            // The common case first: a text without values.
            let end = span.start + span.len - 1
            var i = span.start + 1
            while i < end {
                let b = p.src[i]
                if b == '{' { return parse_text(mut p, span) }
                if b == '\\' { i = i + 1 }
                i = i + 1
            }
            return push_expr(mut p, ExprStr(span), pos)
        }
        TOK_TRUE => {
            bump(mut p)
            return push_expr(mut p, ExprBool(true), pos)
        }
        TOK_FALSE => {
            bump(mut p)
            return push_expr(mut p, ExprBool(false), pos)
        }
        TOK_IDENT => {
            let name = take_span(mut p)
            if p.kind == TOK_LBRACE && !p.no_struct { return parse_struct_literal(mut p, name) }
            if p.kind == TOK_STR && name.len == 1 && p.src[name.start] == 'f' && p.tokens.starts[p.pos] == name.start + 1 {
                parse_fail_at(mut p, "a text needs no `f` in front to hold values: write `\"total: \{sum}\"`", name.start)
                return NO_NODE
            }
            return push_expr(mut p, ExprIdent(name), pos)
        }
        TOK_LPAREN => {
            enter(mut p)
            if p.failed { return NO_NODE }
            bump(mut p)
            let saved = p.no_struct
            p.no_struct = false
            skip_newlines(mut p)
            let inner = parse_expr(mut p)
            if p.failed { return NO_NODE }
            skip_newlines(mut p)
            expect(mut p, TOK_RPAREN)
            if p.failed { return NO_NODE }
            p.no_struct = saved
            p.depth = p.depth - 1
            return inner
        }
        TOK_LBRACKET => {
            enter(mut p)
            if p.failed { return NO_NODE }
            bump(mut p)
            let saved = p.no_struct
            p.no_struct = false
            let start = p.scratch_len
            skip_newlines(mut p)
            while p.kind != TOK_RBRACKET {
                let item = parse_expr(mut p)
                if p.failed { return NO_NODE }
                collect(mut p, item)
                skip_newlines(mut p)
                if !eat(mut p, TOK_COMMA) { break }
                skip_newlines(mut p)
            }
            expect(mut p, TOK_RBRACKET)
            if p.failed { return NO_NODE }
            p.no_struct = saved
            p.depth = p.depth - 1
            let items = finish_list(mut p, start)
            return push_expr(mut p, ExprArrayLit(items), pos)
        }
        _ => {
            parse_fail(mut p, "expected an expression but found " + describe_token(p.kind))
            return NO_NODE
        }
    }
}

// `Name { field: value, ... }`, with the name already read.
fn parse_struct_literal(p: mut Parser, name: Span) -> i64 {
    enter(mut p)
    if p.failed { return NO_NODE }
    bump(mut p)
    let start = p.scratch_len
    skip_newlines(mut p)
    while p.kind != TOK_RBRACE {
        let field = expect_name(mut p, "a field name")
        if p.failed { return NO_NODE }
        var value = NO_NODE
        if p.kind == TOK_COMMA || p.kind == TOK_RBRACE || p.kind == TOK_NEWLINE {
            // `Pair { key, value }`: the field takes the variable of
            // the same name.
            value = push_expr(mut p, ExprIdent(field), field.start)
        } else {
            expect(mut p, TOK_COLON)
            if p.failed { return NO_NODE }
            value = parse_expr(mut p)
            if p.failed { return NO_NODE }
        }
        p.ast.field_inits.push(FieldInit { name: field, value: value })
        collect(mut p, p.ast.field_inits.len() - 1)
        skip_newlines(mut p)
        if !eat(mut p, TOK_COMMA) { break }
        skip_newlines(mut p)
    }
    expect(mut p, TOK_RBRACE)
    if p.failed { return NO_NODE }
    p.depth = p.depth - 1
    let fields = finish_list(mut p, start)
    return push_expr(mut p, ExprStructLit(name, fields), name.start)
}
