// Checks `sha256` against known hashes. Build it together with
// sha256.azl and bytes.azl; it prints `ok` or what differs.

fn check(text: str, want: str) -> i64 {
    let got = hex_text(sha256(text))
    if got == want { return 0 }
    print("wrong hash: " + got)
    print("   wanted: " + want)
    return 1
}

fn main() -> i64 {
    var wrong = 0
    wrong = wrong + check("", "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    wrong = wrong + check("abc", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    wrong = wrong + check(
        "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
    )
    var many = ""
    var i = 0
    while i < 1000 {
        many = many + "a"
        i = i + 1
    }
    wrong = wrong + check(many, "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3")
    // Lengths around the block boundary, where the padding changes shape.
    wrong = wrong + check(many.slice(0, 55), "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318")
    wrong = wrong + check(many.slice(0, 56), "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a")
    wrong = wrong + check(many.slice(0, 64), "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb")
    if wrong == 0 { print("ok") }
    return wrong
}
