// expect-exit: 1
// expect-output: 1 2 10
// expect-stderr: azol: index out of range

// A check made on one path only does not count on the other.
fn main() {
    let xs = [10, 20, 30]
    var i = 0
    var total = 0
    var skip = false
    while i < 2 {
        if !skip {
            total = total + xs[i * 5]
        }
        print(i + 1)
        skip = true
        i = i + 1
    }
    print(total)
    var j = 7
    if skip || xs[j] > 0 {
        total = total + 1
    }
    if total > 100 && xs[j] > 0 {
        total = total + 1
    }
    total = total + xs[j]
    print(total)
}
