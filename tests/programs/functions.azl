// expect-exit: 42
// expect-output: 6765 21 2432902008176640000 12345678 61 1 2 0 5 1 2 3 1 36
fn fib(n: i64) -> i64 {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

fn gcd(a: i64, b: i64) -> i64 {
    var x = a
    var y = b
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    return x
}

fn factorial(n: i64) -> i64 {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}

fn digits(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    return a * 10000000 + b * 1000000 + c * 100000 + d * 10000 + e * 1000 + f * 100 + g * 10 + h
}

fn ackermann(m: i64, n: i64) -> i64 {
    if m == 0 { return n + 1 }
    if n == 0 { return ackermann(m - 1, 1) }
    return ackermann(m - 1, ackermann(m, n - 1))
}

fn noisy(value: i64, result: bool) -> bool {
    print(value)
    return result
}

fn is_even(n: i64) -> bool {
    return n % 2 == 0
}

fn nothing() {
    return
}

fn sum_to(n: i64) -> i64 {
    var total = 0
    var i = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    return total
}

fn main() -> i64 {
    print(fib(20))
    print(gcd(1071, 462))
    print(factorial(20))
    print(digits(1, 2, 3, 4, 5, 6, 7, 8))
    print(ackermann(3, 3))

    // `&&` and `||` must not evaluate the right side when the left decides.
    if noisy(1, false) && noisy(99, true) { print(98) }
    if noisy(2, true) || noisy(99, true) { print(0) }
    if is_even(fib(10)) == false { print(5) }
    if noisy(1, true) && noisy(2, true) && noisy(3, false) || is_even(4) { print(1) }
    nothing()
    print(sum_to(gcd(16, 24)))
    return fib(9) + gcd(48, 16) - sum_to(3) - 2
}
