// expect-exit: 3
// expect-line: hello, world!
// expect-line: 13
// expect-line: hello, world!hello, world!
// expect-line: hello, world
// expect-line: hello, world!?
// expect-line: hello, world!
// expect-line: true
// expect-line: leaving

// String constants joined with `+`, and `exit` as the end of a path.

const GREETING = "hello, " + "world"
const LOUD = GREETING + "!"
const TWICE = LOUD + LOUD

fn pick(n: i64) -> str {
    if n == 0 { return GREETING }
    if n == 1 { return LOUD }
    print("leaving")
    exit(3)
}

// A copy of a constant grows; the constant stays as it is.
fn appended() {
    var s = LOUD
    s = s + "?"
    print(s)
}

fn main() {
    print(LOUD)
    print(LOUD.len())
    print(TWICE)
    print(pick(0))
    appended()
    print(LOUD)
    print(pick(1) == LOUD)
    print(pick(2))
}
