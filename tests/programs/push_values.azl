// expect-exit: 0
// expect-line: 40 780 39 c39
// expect-line: 20 190 10 9
// expect-line: 12 a b a b a b a b a b a b
// expect-line: 33 528 3 6
// expect-line: 17 136 16 45
// expect-line: 6 20 2
// Pushing values of several slots: with room they are copied into the
// list where the `push` is written, and the runtime only makes room.
// The value pushed may come from the list that grows.
struct Pair {
    a: i64,
    b: i64,
}

struct Named {
    id: i64,
    name: str,
}

struct Wide {
    a: i64,
    b: i64,
    c: i64,
    d: i64,
    e: i64,
    f: i64,
    g: i64,
    h: i64,
    i: i64,
}

enum Shape {
    Dot,
    Circle(i64),
    Box(i64, i64),
}

fn main() {
    var named: List[Named] = []
    var i = 0
    while i < 40 {
        named.push(Named { id: i, name: "c" + str(i) })
        i = i + 1
    }
    var sum = 0
    for n in named {
        sum = sum + n.id
    }
    print(str(named.len()) + " " + str(sum) + " " + str(named[39].id) + " " + named[39].name)

    var pairs = [Pair { a: 0, b: 0 }]
    i = 1
    while i < 20 {
        // The element read here lives in the list that may move.
        pairs.push(Pair { a: pairs[i - 1].a + 1, b: i })
        pairs.push(pairs[0])
        let gone = pairs.pop()
        sum = sum + gone.a
        i = i + 1
    }
    var total = 0
    for p in pairs {
        total = total + p.b
    }
    print(str(pairs.len()) + " " + str(total) + " " + str(pairs[10].a) + " " + str(pairs[9].b))

    var texts = ["a", "b"]
    i = 0
    while i < 10 {
        texts.push(texts[i])
        i = i + 1
    }
    print(str(texts.len()) + " " + texts.join(" "))

    var wide: List[Wide] = []
    i = 0
    while i < 33 {
        wide.push(Wide { a: i, b: 1, c: 2, d: 3, e: 4, f: 5, g: 6, h: 7, i: i })
        i = i + 1
    }
    total = 0
    for w in wide {
        total = total + w.i
    }
    print(str(wide.len()) + " " + str(total) + " " + str(wide[3].a) + " " + str(wide[32].g))

    var lists: List[List[i64]] = []
    i = 0
    while i < 17 {
        var inner: List[i64] = []
        var j = 0
        while j < i {
            inner.push(j)
            j = j + 1
        }
        lists.push(inner)
        i = i + 1
    }
    total = 0
    for l in lists {
        total = total + l.len()
    }
    var last = 0
    for x in lists[10] {
        last = last + x
    }
    print(str(lists.len()) + " " + str(total) + " " + str(lists[16].len()) + " " + str(last))

    var shapes = [Dot]
    i = 0
    while i < 5 {
        if i % 2 == 0 {
            shapes.push(Circle(i))
        } else {
            shapes.push(Box(i, i + 1))
        }
        i = i + 1
    }
    total = 0
    var boxes = 0
    for s in shapes {
        match s {
            Dot => total = total + 0
            Circle(r) => total = total + r
            Box(w, h) => {
                total = total + w + h + w
                boxes = boxes + 1
            }
        }
    }
    print(str(shapes.len()) + " " + str(total) + " " + str(boxes))
}
