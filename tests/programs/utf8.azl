// expect-exit: 0
// expect-line: true true true true true true
// expect-line: false false false false false
// expect-line: false true false true
// expect-line: false true true false
// expect-line: false false false false false
// expect-line: 20 20 20 20 20
// expect-line: true true bad

// `is_utf8()`: whether the bytes of a string are well-formed UTF-8.

fn text(bytes: List[i64]) -> str {
    var s = ""
    for byte in bytes {
        s.push(byte)
    }
    return s
}

fn row(cases: List[List[i64]]) {
    var line = ""
    for bytes in cases {
        if line.len() > 0 {
            line = line + " "
        }
        line = line + str(text(bytes).is_utf8())
    }
    print(line)
}

// `count` plain letters, then `bytes`, then `tail`.
fn padded(count: i64, bytes: List[i64], tail: str) -> str {
    var s = "a".repeat(count)
    for byte in bytes {
        s.push(byte)
    }
    return s + tail
}

fn main() {
    let none: List[i64] = []
    // Nothing, plain text, and characters of two, three and four bytes.
    row([none, [112, 108, 97, 105, 110], [0xC3, 0xA9], [0xE2, 0x82, 0xAC], [0xF0, 0x9F, 0x98, 0x80], [0x7F, 0xC2, 0x80, 0xDF, 0xBF]])
    // A continuation byte alone, encodings that are too long, a start
    // with nothing or with a letter after it.
    row([[0x80], [0xC0, 0x80], [0xC1, 0xBF], [0xC2], [0xC2, 0x41]])
    // Three bytes: too long, the smallest, a surrogate, the last before them.
    row([[0xE0, 0x80, 0x80], [0xE0, 0xA0, 0x80], [0xED, 0xA0, 0x80], [0xED, 0x9F, 0xBF]])
    // Four bytes: too long, the smallest, the largest, past the largest.
    row([[0xF0, 0x80, 0x80, 0x80], [0xF0, 0x90, 0x80, 0x80], [0xF4, 0x8F, 0xBF, 0xBF], [0xF4, 0x90, 0x80, 0x80]])
    // Bytes that start nothing, and characters cut short.
    row([[0xF5, 0x80, 0x80, 0x80], [0xFF], [0xE2, 0x82], [0xE2, 0x28, 0xA1], [0xF0, 0x9F, 0x98]])
    // The same at every distance from the start, so that every place in
    // a group of eight bytes is tried.
    var good = 0
    var cut = 0
    var stray = 0
    var short = 0
    var long = 0
    var count = 0
    while count < 20 {
        if padded(count, [0xE2, 0x82, 0xAC], "z").is_utf8() {
            good = good + 1
        }
        if !padded(count, [0xE2, 0x82], "z").is_utf8() {
            cut = cut + 1
        }
        if !padded(count, [0x80], "zzzzzzzzz").is_utf8() {
            stray = stray + 1
        }
        if !padded(count, [0xC3], "").is_utf8() {
            short = short + 1
        }
        if padded(count, [0xF0, 0x9F, 0x98, 0x80, 0xC3, 0xA9], "zzzzzzzzzzzzzzzzz").is_utf8() {
            long = long + 1
        }
        count = count + 1
    }
    print(str(good) + " " + str(cut) + " " + str(stray) + " " + str(short) + " " + str(long))
    let literal = "héllo €"
    var verdict = "good"
    if !chr(200).is_utf8() {
        verdict = "bad"
    }
    print(str(literal.is_utf8()) + " " + str((literal + "!").is_utf8()) + " " + verdict)
}
