// Bytes, slices and the text methods of the standard library.

fn show(parts: List[str]) {
    var out = ""
    for part in parts {
        out = out + "[" + part + "]"
    }
    print(out)
}

fn position(found: Option[i64]) {
    match found {
        Some(at) => print(at)
        None => print("none")
    }
}

fn number(text: str) {
    match text.to_i64() {
        Some(n) => print(n)
        None => print("bad")
    }
}

fn reverse(text: str) -> str {
    var out = ""
    var i = text.len()
    while i > 0 {
        i = i - 1
        out = out + chr(text[i])
    }
    return out
}

fn main() {
    let hello = "hello"
    print(hello[0])
    print(hello[hello.len() - 1])
    print(hello.slice(1, 4))
    print("[" + hello.slice(2, 2) + "]")
    print(hello.slice(0, hello.len()))

    position(hello.find("ll"))
    position(hello.find(""))
    position("hello hello".find("o h") )
    position(hello.find("lo!"))
    print(hello.contains("ell"))
    print(hello.contains("elo"))
    print(hello.starts_with("he"))
    print(hello.starts_with(""))
    print(hello.starts_with("hello!"))
    print(hello.ends_with("llo"))
    print(hello.ends_with("hell"))
    print("".ends_with(""))

    print("[" + "  \t two words \r\n".trim() + "]")
    print("[" + "   ".trim() + "]")
    print("[" + "x".trim() + "]")

    let letters = "a,b,c".split(",")
    print(letters.len())
    show(letters)
    let gaps = ",a,,".split(",")
    print(gaps.len())
    show(gaps)
    print("whole".split("").len())
    show("whole".split("--"))
    print("one--two".split("--").len())
    show("one--two".split("--"))

    let lines = "first\r\n\nthird\n".lines()
    print(lines.len())
    show(lines)
    print("".lines().len())

    number("42")
    number("-7")
    number("9223372036854775807")
    number("9223372036854775808")
    number("")
    number("-")
    number("12a")
    number(" 1")

    print(letters.join(", "))
    let nothing: List[str] = []
    print(nothing.join(", "))
    print(["solo"].join(", "))

    // Bytes back into text.
    print(chr(65) + chr(66) + chr(67))
    print((chr(255) + chr(0))[0])
    print((chr(255) + chr(0) + "x").len())
    print(reverse(hello))

    // A method on a computed string, in a loop: nothing may leak.
    var total = 0
    for word in "the quick brown".split(" ") {
        total = total + (word + "!").trim().slice(0, word.len()).len() - 1
    }
    print(total)
}
