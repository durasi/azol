// expect-line: 01234
// expect-line: 12345
// expect-line: :0:3:6:9
// expect-line: :0:3:6:9
// expect-line: 43210
// expect-line: :10:6:2
// expect-line: 0
// expect-line: 023
// expect-line: from
// expect-line: to
// expect-line: 2
