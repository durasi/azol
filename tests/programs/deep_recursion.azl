// Recursion that is deep but ends is ordinary: 100,000 calls inside one
// another fit in the stack every system gives a program.
// expect-exit: 0
// expect-line: 100000
// expect-line: 5000050000

fn count(n: i64) -> i64 {
    if n == 0 {
        return 0
    }
    return count(n - 1) + 1
}

fn sum(n: i64) -> i64 {
    if n == 0 {
        return 0
    }
    return sum(n - 1) + n
}

fn main() {
    print(str(count(100000)))
    print(str(sum(100000)))
}
