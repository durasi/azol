// The library's map from text keys to values of any one type.
//
// Who owns what: the map owns its keys and its values. `set` takes its
// own copy of the value (or the value itself when the caller does not
// use it again). `get` gives back a copy, like every read in azoL:
// changing what it returned does not change the map, and a changed
// value goes back in with `set`. Copying a map copies all of its keys
// and values; the two maps are then independent.

fn show(found: Option[i64]) -> str {
    match found {
        Some(value) => return str(value)
        None => return "none"
    }
}

fn text(found: Option[str]) -> str {
    match found {
        Some(value) => return "<" + value + ">"
        None => return "none"
    }
}

fn joined(found: Option[List[str]]) -> str {
    match found {
        Some(items) => return "[" + items.join(",") + "]"
        None => return "none"
    }
}

// Each part is a function of its own, so that its maps are freed
// before the next part starts.
fn basics() {
    // An empty map.
    var ages: Map[i64] = new_map()
    print(ages.len())
    print(show(ages.get("ada")))
    print(ages.has(""))
    print(ages.remove("ada"))
    print(ages.keys().len())

    // One key, then more, with a value replaced.
    ages.set("ada", 36)
    print(ages.len())
    print(show(ages.get("ada")))
    print(show(ages.get("Ada")))
    print(show(ages.get("ad")))
    print(show(ages.get("adaa")))
    ages.set("alan", 41)
    ages.set("", -1)
    ages.set("ada", 37)
    print(ages.len())
    print(show(ages.get("ada")))
    print(show(ages.get("")))
    print(ages.has("alan"))
    print(ages.has("grace"))
    print(ages.keys().join("|"))

    // Removing: the first key, a missing key, the last key, all keys.
    print(ages.remove("ada"))
    print(ages.remove("ada"))
    print(ages.keys().join("|"))
    print(show(ages.get("ada")))
    print(show(ages.get("alan")))
    print(ages.remove("alan"))
    print(ages.remove(""))
    print(ages.len())
    print(ages.has(""))
    ages.set("ada", 1)
    print(show(ages.get("ada")))
    print(ages.len())
}

fn large() {
    // The known hash of a short text.
    print("".hash() == 0xcbf2_9ce4_8422_2325)
    print("a".hash().to_hex())
    print("foobar".hash().to_hex())

    // Thousands of keys.
    var squares: Map[i64] = new_map()
    var i = 0
    while i < 2000 {
        squares.set("key" + str(i), i * i)
        i = i + 1
    }
    print(squares.len())
    var total = 0
    var missing = 0
    i = 0
    while i < 2000 {
        match squares.get("key" + str(i)) {
            Some(value) => total = total + value
            None => missing = missing + 1
        }
        i = i + 1
    }
    print(total)
    print(missing)
    print(squares.has("key2000"))
    print(squares.has("key"))
    print(squares.has("KEY7"))

    // Many removals: two keys of every three go.
    var removed = 0
    i = 0
    while i < 2000 {
        if i % 3 != 0 {
            if squares.remove("key" + str(i)) { removed = removed + 1 }
        }
        i = i + 1
    }
    print(removed)
    print(squares.len())
    var present = 0
    total = 0
    i = 0
    while i < 2000 {
        match squares.get("key" + str(i)) {
            Some(value) => {
                present = present + 1
                total = total + value
            }
            None => {}
        }
        i = i + 5
    }
    print(present)
    print(total)
    print(squares.has("key3"))
    print(squares.has("key4"))
    let left = squares.keys()
    print(left.take(6).join(" "))
    print(left.skip(left.len() - 3).join(" "))

    // Keys come back, old values are replaced, and new keys arrive
    // while the table still remembers removed slots.
    i = 0
    while i < 600 {
        if i % 2 == 0 { squares.set("key" + str(i), -i) }
        i = i + 1
    }
    i = 0
    while i < 300 {
        squares.set("extra" + str(i), 1)
        i = i + 1
    }
    print(squares.len())
    print(show(squares.get("key6")))
    print(show(squares.get("key9")))
    print(show(squares.get("key4")))
    print(show(squares.get("key5")))
    var order = 0
    for at, key in squares.keys() {
        if at % 8 == 0 {
            match squares.get(key) {
                Some(value) => order = order + (at + 1) * value
                None => order = order - 1000000
            }
        }
    }
    print(order)
}

fn churning() {
    // Set and remove the same few keys again and again: the removed
    // slots must not fill the table.
    var churn: Map[i64] = new_map()
    var i = 0
    while i < 3500 {
        let name = "c" + str(i % 7)
        churn.set(name, i)
        if i % 2 == 1 {
            let gone = churn.remove(name)
        }
        i = i + 1
    }
    print(churn.len())
    print(churn.keys().sorted().join(","))
    print(churn.table.len() <= 64)
    // Emptied completely, a key at a time.
    for key in churn.keys() {
        let gone = churn.remove(key)
    }
    print(churn.len())
    print(churn.has("c0"))
}

fn owned_values() {
    // Values that own memory: text.
    var capitals: Map[str] = new_map()
    capitals.set("Türkiye", "Ankara")
    capitals.set("France", "Paris")
    capitals.set("Japan", "Kyoto")
    capitals.set("Japan", "Tokyo")
    print(text(capitals.get("Japan")))
    print(text(capitals.get("Türkiye")))
    print(text(capitals.get("Spain")))
    print(capitals.remove("France"))
    print(capitals.keys().sorted().join(","))

    // Values that own memory: lists of text.
    var groups: Map[List[str]] = new_map()
    groups.set("fruit", ["apple", "pear"])
    groups.set("empty", [])
    groups.set("tools", ["saw"])
    print(joined(groups.get("fruit")))
    print(joined(groups.get("empty")))
    print(joined(groups.get("none")))
    // What `map_get` returns is a copy: changing it leaves the map as
    // it was, until the changed list is set again.
    match groups.get("fruit") {
        Some(items) => {
            var more = items
            more.push("fig")
            print(more.len())
            print(joined(groups.get("fruit")))
            groups.set("fruit", more)
        }
        None => {}
    }
    print(joined(groups.get("fruit")))
    // A copy of the map is a map of its own.
    var copy = groups
    copy.set("tools", ["saw", "drill"])
    print(copy.remove("fruit"))
    print(joined(copy.get("tools")))
    print(joined(groups.get("tools")))
    print(copy.len())
    print(groups.len())
    print(groups.remove("empty"))
    print(groups.keys().join(","))
}

fn many_lists() {
    // Many lists, most of them removed again.
    var lists: Map[List[str]] = new_map()
    var i = 0
    while i < 150 {
        var items: List[str] = []
        var k = 0
        while k < i % 4 {
            items.push("item" + str(i) + "." + str(k))
            k = k + 1
        }
        lists.set("list" + str(i), items)
        i = i + 1
    }
    i = 0
    while i < 150 {
        if i % 5 != 2 {
            let gone = lists.remove("list" + str(i))
        }
        i = i + 1
    }
    print(lists.len())
    print(joined(lists.get("list7")))
    print(joined(lists.get("list8")))
    print(joined(lists.get("list149")))
    print(joined(lists.get("list147")))
    var items_left = 0
    for key in lists.keys() {
        match lists.get(key) {
            Some(items) => items_left = items_left + items.len()
            None => {}
        }
    }
    print(items_left)
}

fn main() {
    basics()
    large()
    churning()
    owned_values()
    many_lists()
}
