// Multiplying, dividing and taking remainders by powers of two, where
// shifts and masks stand in for the real operations: negative numbers
// round toward zero and a remainder keeps the sign of the left side.

fn show(n: i64) {
    print(n / 2)
    print(n / 8)
    print(n / 1024)
    print(n / 4611686018427387904)
    print(n % 2)
    print(n % 8)
    print(n % 1024)
    print(n % 4611686018427387904)
    print(n * 4)
    print(n % 2 == 0)
    print(n % 8 != 0)
    print(n % 2 == 1)
    print(n % 3 == 0)
}

fn count_even(xs: List[i64]) -> i64 {
    var even = 0
    for x in xs {
        if x % 2 == 0 && x % 16 != 0 { even = even + 1 }
    }
    return even
}

fn main() {
    let lowest = -9223372036854775807 - 1
    let numbers = [0, 1, -1, 7, -7, 8, -8, 9, -9, 1023, -1023, 1024, -1024, 1025, -1025, 9223372036854775807, -9223372036854775807, lowest]
    for n in numbers {
        show(n)
    }
    print(count_even(numbers))
    var i = -20
    var sum = 0
    while i <= 20 {
        var local = i
        sum = sum + local / 4 * 100 + local % 4
        local = local * 16
        if local % 32 == 0 { sum = sum + 1 }
        i = i + 1
    }
    print(sum)
    let eight = 8
    print(-17 / eight)
    print(-17 % eight)
    print(-17 / 8)
    print(-17 % 8)
    print((0 - 16) / 16)
    print((0 - 16) % 16)
}
