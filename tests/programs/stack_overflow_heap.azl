// Running out of stack in a chain of three functions that call each other,
// each level holding a string and a list of its own on the heap and a
// 300-slot value in its frame. The program stops with the message; the
// memory it still holds goes back to the system with the process.
// expect-exit: 1
// expect-line: start
// expect-line: 3 levels: 12
// expect-stderr: azol: stack overflow

struct Row { f0: i64, f1: i64, f2: i64, f3: i64, f4: i64, f5: i64, f6: i64, f7: i64, f8: i64, f9: i64, f10: i64, f11: i64, f12: i64, f13: i64, f14: i64, f15: i64, f16: i64, f17: i64, f18: i64, f19: i64 }

struct Wide {
    r0: Row
    r1: Row
    r2: Row
    r3: Row
    r4: Row
    r5: Row
    r6: Row
    r7: Row
    r8: Row
    r9: Row
    r10: Row
    r11: Row
    r12: Row
    r13: Row
    r14: Row
}

fn wide(n: i64) -> Wide {
    let r = Row { f0: n + 0, f1: n + 1, f2: n + 2, f3: n + 3, f4: n + 4, f5: n + 5, f6: n + 6, f7: n + 7, f8: n + 8, f9: n + 9, f10: n + 10, f11: n + 11, f12: n + 12, f13: n + 13, f14: n + 14, f15: n + 15, f16: n + 16, f17: n + 17, f18: n + 18, f19: n + 19 }
    return Wide {
        r0: r, r1: r, r2: r, r3: r, r4: r, r5: r, r6: r, r7: r, r8: r, r9: r,
        r10: r, r11: r, r12: r, r13: r, r14: r
    }
}

fn first(n: i64, limit: i64) -> i64 {
    if n == limit {
        return 0
    }
    let label = "level " + str(n)
    var numbers = [n, n + 1]
    numbers.push(label.len())
    let w = wide(n)
    return second(n + 1, limit) + numbers[0] + w.r0.f0 - 2 * n + 1
}

fn second(n: i64, limit: i64) -> i64 {
    if n == limit {
        return 0
    }
    var names = ["a" + str(n), "b"]
    names.push("c")
    let w = wide(n)
    return third(n + 1, limit) + names.len() + w.r14.f19 - n - 19
}

fn third(n: i64, limit: i64) -> i64 {
    if n == limit {
        return 0
    }
    let text = str(n) + "!"
    let w = wide(n)
    return first(n + 1, limit) + text.len() + w.r7.f5 - n + 1
}

fn main() {
    print("start")
    print("3 levels: " + str(first(0, 3)))
    print(str(first(0, 0 - 1)))
}
