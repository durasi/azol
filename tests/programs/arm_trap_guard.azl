// expect-exit: 1
// expect-output: -2 11
// expect-stderr: azol: index out of range

// A function whose first test is decided before its frame exists still
// checks every index it reaches afterwards.
fn pick(n: i64, xs: List[i64]) -> i64 {
    if n < 0 {
        return n
    }
    return xs[n] + pick(n - 4, xs)
}

fn main() {
    let xs = [1, 2, 3, 4, 5, 6, 7, 8]
    print(pick(6, xs) - 10)
    print(pick(7, xs))
    print(pick(11, xs))
    print(0)
}
