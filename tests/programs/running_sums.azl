// expect-exit: 0
// expect-line: 0
// expect-line: 7
// expect-line: 2 10 9
// expect-line: 40096
// expect-line: 1
// expect-line: 28665
// expect-line: 17
// expect-line: -301
// expect-line: 1
// expect-line: 6667
// Loops in which each turn reads what the turn before wrote: the
// optimising path keeps that number in a register, and must give what
// the reads from the list give, also when the loop does not run, when
// two lists are written, and when the list changes under the loop.
fn sums_of(source: List[i64]) -> List[i64] {
    var sums = 0.filled(source.len())
    if source.len() == 0 { return sums }
    sums[0] = source[0]
    var i = 1
    while i < source.len() {
        sums[i] = sums[i - 1] + source[i]
        i = i + 1
    }
    return sums
}

fn products(n: i64) -> List[i64] {
    var out = 1.filled(n + 1)
    out[0] = 1
    var i = 1
    while i <= n {
        out[i] = out[i - 1] * i % 1000003
        i = i + 1
    }
    return out
}

fn both(n: i64) -> i64 {
    var a = 0.filled(n)
    var b = 0.filled(n)
    a[0] = 3
    b[0] = 5
    var i = 1
    while i < n {
        a[i] = a[i - 1] + b[i - 1]
        b[i] = a[i] ^ i
        i = i + 1
    }
    return a[n - 1] + b[n - 1]
}

fn shifting(n: i64) -> i64 {
    var a = 0.filled(n)
    a[0] = 1
    var i = 1
    while i < n {
        a[i] = a[i - 1] + 2
        if i % 3 == 0 { a[i - 1] = 0 }
        i = i + 1
    }
    var total = 0
    for x in a {
        total = total + x
    }
    return total
}

fn main() {
    print(sums_of([]).len())
    print(sums_of([7])[0])
    let sums = sums_of([3, -1, 4, -1, 5, -9, 2, 6])
    print(str(sums[1]) + " " + str(sums[4]) + " " + str(sums[7]))
    var big: List[i64] = []
    for i in 0..5000 {
        big.push(i * i % 97 - 40)
    }
    print(sums_of(big)[4999])
    print(products(0)[0])
    print(products(2000)[2000])
    print(both(2))
    print(both(300))
    print(shifting(1))
    print(shifting(100))
}
