// expect-exit: 7
// expect-output: 1 3 5 7 9 100 2 20 12 30 111 222 333 1 0 1
fn classify(n: i64) -> i64 {
    if n < 0 {
        return 111
    } else if n == 0 {
        return 222
    } else {
        return 333
    }
}

fn main() -> i64 {
    var i = 0
    while i < 100 {
        i = i + 1
        if i % 2 == 0 {
            continue
        }
        if i > 9 {
            break
        }
        print(i)
    }
    print(100)

    var a = 1
    var total = 0
    while a <= 3 {
        var b = 1
        while b <= 3 {
            if b == 2 {
                b = b + 1
                continue
            }
            total = total + a * b
            b = b + 1
        }
        a = a + 1
    }
    let x = 2
    if x == 2 {
        let x = 20
        print(2)
        print(x)
    }
    print(x + 10)
    print(total + 6)
    print(classify(-5))
    print(classify(0))
    print(classify(5))

    let yes = 3 > 2
    let no = !yes
    if yes && !no {
        print(1)
    }
    if no || yes == false {
        print(99)
    } else {
        print(0)
    }
    if yes != no {
        print(1)
    }
    return 7
}
