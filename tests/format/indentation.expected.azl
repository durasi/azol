struct Point {
    x: i64
    y: i64
}

fn area(p: Point) -> i64 {
    return p.x * p.y
}

fn main() {
    let p = Point { x: 3, y: 4 }
    var total = 0
    for i in range(0, 10) {
        if i % 2 == 0 {
            total = total + i
        } else if i == 7 {
            continue
        } else {
            total = total - 1
        }
    }
    while total > 0 {
        total = total - area(p)
    }
    print(total)
}
