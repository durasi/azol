; B1: the loop is tested against the smaller of two lengths, as a
; `select`; both checks go.
fn w(p0: ptr [param 0 read], p1: ptr [param 1 read], p2: i64) -> i64 {
b0:
    v0 = load i64, p0, 8  [param 0]
    v1 = load ptr, p0, 0  [param 0]
    v10 = load i64, p1, 8  [param 1]
    v11 = load ptr, p1, 0  [param 1]
    v20 = slt v0, v10
    v21 = select v20, v0, v10
    jump b1(0, 0)
b1(v2: i64, v3: i64):
    v4 = slt v2, v21
    br v4, b2, b4
b2:
    v5 = ult v2, v0
    br v5, b3, b5
b3:
    v6 = gep v1, v2, 8, 0
    v7 = load i64, v6, 0  [buf(param 0)]
    v15 = ult v2, v10
    br v15, b6, b5
b6:
    v12 = gep v11, v2, 8, 0
    v13 = load i64, v12, 0  [buf(param 1)]
    v14 = mul v7, v13
    v8 = add v3, v14
    v9 = add v2, 1
    jump b1(v9, v8)
b4:
    ret v3
b5:
    trap index
}

fn main(p0: i64, p1: i64) -> i64 {
    frames 24, 24
b0:
    v0 = frame 0
    v1 = callrt alloc(40)
    store i64, v1, 0, 10  [buf(frame 0)]
    store i64, v1, 8, 20  [buf(frame 0)]
    store i64, v1, 16, 30  [buf(frame 0)]
    store i64, v1, 24, 40  [buf(frame 0)]
    store i64, v1, 32, 50  [buf(frame 0)]
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, p0  [frame 0]
    store i64, v0, 16, 5  [frame 0]
    v3 = frame 1
    v4 = callrt alloc(24)
    store i64, v4, 0, 1  [buf(frame 1)]
    store i64, v4, 8, 2  [buf(frame 1)]
    store i64, v4, 16, 3  [buf(frame 1)]
    store ptr, v3, 0, v4  [frame 1]
    store i64, v3, 8, 3  [frame 1]
    store i64, v3, 16, 3  [frame 1]
    v2 = call w(v0, v3, p1) -> i64
    callrt free(v1)
    callrt free(v4)
    ret v2
}
