fn w(p0: ptr [param 0 read], p1: i64, p2: i64) -> i64 {
b0:
    v0 = load i64, p0, 8  [param 0]
    v1 = load ptr, p0, 0  [param 0]
    v13 = and p1, 7
    v14 = add p2, -1
    v15 = add v14, v13
    v16 = ule v15, v0
    v17 = sub v0, v15
    v18 = add v17, v13
    v19 = select v16, v18, v13
    v20 = slt 4, v19
    v21 = select v20, 4, v19
    jump b1(v13, 0)
b1(v2: i64, v3: i64):
    v4 = slt v2, 4
    v22 = slt v2, v21
    br v22, b2, b6
b2:
    v11 = add p2, v2
    v12 = sub v11, 1
    v5 = ult v12, v0
    jump b3
b3:
    v6 = gep v1, v12, 8, 0
    v7 = load i64, v6, 0  [buf(param 0)]
    v8 = add v3, v7
    v9 = add v2, 1
    jump b1(v9, v8)
b4:
    ret v3
b5:
    trap index
b6:
    v23 = slt v2, 4
    br v23, b5, b4
}

fn main(p0: i64, p1: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    v1 = callrt alloc(40)
    store i64, v1, 0, 10  [buf(frame 0)]
    store i64, v1, 8, 20  [buf(frame 0)]
    store i64, v1, 16, 30  [buf(frame 0)]
    store i64, v1, 24, 40  [buf(frame 0)]
    store i64, v1, 32, 50  [buf(frame 0)]
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, 5  [frame 0]
    store i64, v0, 16, 5  [frame 0]
    v2 = call w(v0, p0, p1) -> i64
    callrt free(v1)
    ret v2
}
