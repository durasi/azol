; Kept: the memory is never freed here; removing only the allocation would change what the strict interpreter and a leak check see... and the address is returned.
fn make(p0: i64) -> ptr {
    frames 8
b0:
    v0 = callrt alloc(16)
    store i64, v0, 0, p0  [buf(frame 0)]
    ret v0
}

fn main(p0: i64) -> i64 {
    frames 8
b0:
    v0 = call make(p0) -> ptr
    v1 = load i64, v0, 0  [buf(frame 0)]
    callrt free(v0)
    ret v1
}
