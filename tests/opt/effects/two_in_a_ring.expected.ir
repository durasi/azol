fn even(p0: ptr [param 0 read write], p1: i64) {
b0:
    v0 = sle p1, 0
    br v0, b1, b2
b1:
    ret
b2:
    v1 = load i64, p0, 0  [param 0]
    v2 = sub p1, 1
    call odd(p0, v2)
    ret
}

fn odd(p0: ptr [param 0 read write], p1: i64) {
b0:
    v0 = sle p1, 0
    br v0, b1, b2
b1:
    ret
b2:
    store i64, p0, 0, p1  [param 0]
    v2 = sub p1, 1
    call even(p0, v2)
    ret
}

fn main(p0: i64) -> i64 {
    frames 8
b0:
    v0 = frame 0
    store i64, v0, 0, 0  [frame 0]
    call even(v0, p0)
    v1 = load i64, v0, 0  [frame 0]
    ret v1
}
