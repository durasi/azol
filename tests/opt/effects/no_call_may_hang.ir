; The callee has a loop, which may run for ever: its call stays. So does the call of a function that calls itself.
fn spin(p0: i64) -> i64 {
b0:
    jump b1(p0)
b1(v0: i64):
    v1 = sgt v0, 0
    br v1, b2, b3
b2:
    v2 = sub v0, 1
    jump b1(v2)
b3:
    ret v0
}

fn down(p0: i64) -> i64 {
b0:
    v0 = sgt p0, 0
    br v0, b1, b2
b1:
    v1 = sub p0, 1
    v2 = call down(v1) -> i64
    ret v2
b2:
    ret p0
}

fn main(p0: i64) -> i64 {
b0:
    v1 = call spin(p0) -> i64
    v2 = call down(p0) -> i64
    ret p0
}
