; A store to a frame object that a call then gets but does not read (the callee only writes through it), and that is written again before anything reads it: the store goes.
fn init(p0: ptr [param 0 read write writebuf resize free], p1: i64) {
b0:
    store i64, p0, 8, p1  [param 0]
    ret
}

fn main(p0: i64) -> i64 {
    frames 16
b0:
    v0 = frame 0
    store i64, v0, 0, 1  [frame 0]
    call init(v0, p0)
    store i64, v0, 0, 2  [frame 0]
    v1 = load i64, v0, 0  [frame 0]
    v2 = load i64, v0, 8  [frame 0]
    v3 = add v1, v2
    ret v3
}
