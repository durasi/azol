; An element's address handed to a function that writes it: for the list that is a write to its buffer, not to its header.
fn set(p0: ptr [param 0 read write writebuf resize free], p1: i64) {
b0:
    store i64, p0, 0, p1  [param 0]
    ret
}

fn set_at(p0: ptr [param 0 read write writebuf resize free], p1: i64) {
b0:
    v0 = load ptr, p0, 0  [param 0]
    v1 = gep v0, p1, 8, 0
    call set(v1, 7)
    ret
}

fn main(p0: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    v1 = callrt alloc(32)
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, 4  [frame 0]
    store i64, v0, 16, 4  [frame 0]
    store i64, v1, 0, 10  [buf(frame 0)]
    store i64, v1, 8, 20  [buf(frame 0)]
    store i64, v1, 16, 30  [buf(frame 0)]
    store i64, v1, 24, 40  [buf(frame 0)]
    call set_at(v0, p0)
    v2 = gep v1, p0, 8, 0
    v3 = load i64, v2, 0  [buf(frame 0)]
    callrt drop(v0)
    ret v3
}
