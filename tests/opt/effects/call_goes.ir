; A call of a function that only works out a number, with a result nothing uses: the call goes.
fn square(p0: i64) -> i64 {
b0:
    v0 = mul p0, p0
    ret v0
}

fn first(p0: ptr [param 0 read]) -> i64 {
b0:
    v0 = load i64, p0, 0  [param 0]
    ret v0
}

fn main(p0: i64) -> i64 {
    frames 8
b0:
    v0 = frame 0
    store i64, v0, 0, p0  [frame 0]
    v1 = call square(p0) -> i64
    v2 = call first(v0) -> i64
    v3 = call square(v2) -> i64
    v4 = load i64, v0, 0  [frame 0]
    ret v4
}
