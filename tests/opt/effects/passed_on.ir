; What a callee does counts: handed to `list_push` the list is resized; handed to a reader it is read.
fn grow(p0: ptr [param 0 read write writebuf resize free], p1: i64) {
    frames 8
b0:
    v0 = frame 0
    store i64, v0, 0, p1  [frame 0]
    callrt list_push(p0, v0, 8)
    ret
}

fn outer(p0: ptr [param 0 read write writebuf resize free], p1: i64) {
b0:
    call grow(p0, p1)
    ret
}

fn count(p0: ptr [param 0 read write writebuf resize free]) -> i64 {
b0:
    v0 = load i64, p0, 8  [param 0]
    ret v0
}

fn counted(p0: ptr [param 0 read write writebuf resize free]) -> i64 {
b0:
    v0 = call count(p0) -> i64
    ret v0
}

fn main(p0: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    store ptr, v0, 0, 0  [frame 0]
    store i64, v0, 8, 0  [frame 0]
    store i64, v0, 16, 0  [frame 0]
    call outer(v0, p0)
    call outer(v0, p0)
    v1 = call counted(v0) -> i64
    callrt drop(v0)
    ret v1
}
