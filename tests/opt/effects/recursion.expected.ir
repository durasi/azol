fn fill(p0: ptr [param 0 read writebuf], p1: i64) {
b0:
    v0 = slt p1, 0
    br v0, b1, b2
b1:
    ret
b2:
    v1 = load ptr, p0, 0  [param 0]
    v2 = gep v1, p1, 8, 0
    store i64, v2, 0, p1  [buf(param 0)]
    v3 = sub p1, 1
    call fill(p0, v3)
    ret
}

fn main(p0: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    v1 = callrt alloc(32)
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, 4  [frame 0]
    store i64, v0, 16, 4  [frame 0]
    store i64, v1, 0, 10  [buf(frame 0)]
    store i64, v1, 8, 20  [buf(frame 0)]
    store i64, v1, 16, 30  [buf(frame 0)]
    store i64, v1, 24, 40  [buf(frame 0)]
    call fill(v0, 3)
    v2 = gep v1, p0, 8, 0
    v3 = load i64, v2, 0  [buf(frame 0)]
    callrt drop(v0)
    ret v3
}
