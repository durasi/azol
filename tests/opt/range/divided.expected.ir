fn w(p0: ptr [param 0 read], p1: i64) -> i64 {
b0:
    v0 = load i64, p0, 8  [param 0]
    v1 = load ptr, p0, 0  [param 0]
    v2 = and p1, 15
    v3 = sdiv v2, 4
    v5 = ult v3, 4
    jump b3
b3:
    v6 = gep v1, v3, 8, 0
    v7 = load i64, v6, 0  [buf(param 0)]
    ret v7
b4:
    ret -1
b5:
    trap index
}

fn main(p0: i64, p1: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    v1 = callrt alloc(40)
