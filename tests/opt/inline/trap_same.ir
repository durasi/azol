; A body that stops the program stops it with the same message from inside the caller.
; calls: 0
; run: main 20 4
; out: => 10
; run: main 20 0
; err: azol: division by zero
; exit: 1
; run: main 20 9
; out: before
; err: azol: index out of range
; exit: 1
data "before"

fn checked(p0: i64, p1: i64) -> i64 {
b0:
    v0 = eq p1, 0
    br v0, b1, b2
b1:
    trap divide
b2:
    v1 = ult p1, 8
    br v1, b3, b4
b3:
    v2 = sdiv p0, p1
    ret v2
b4:
    trap index
}

fn main(p0: i64, p1: i64) -> i64 {
    frames 8
b0:
    v5 = eq p1, 9
    br v5, b1, b2
b1:
    v0 = addr @data+0
    callrt print_str(v0, 6)
    jump b2
b2:
    v1 = call checked(p0, p1) -> i64
    v2 = call checked(v1, 1) -> i64
    v3 = add v1, v2
    ret v3
}
