; out: => -8
fn show(p0: i64) -> i64 {
b0:
    callrt print_i64(p0)
    v0 = add p0, 1
    ret v0
}

fn show_all(p0: i64, p1: i64) -> i64 {
b0:
    v0 = mul p0, p1
    callrt print_i64(v0)
    callrt print_i64(p1)
    callrt print_i64(p0)
    v1 = sub p0, p1
    callrt print_i64(v1)
    callrt print_i64(v0)
    callrt print_i64(p1)
    callrt print_i64(p0)
    callrt print_i64(v1)
    callrt print_i64(v0)
    callrt print_i64(p1)
    callrt print_i64(p0)
    callrt print_i64(v1)
    callrt print_i64(v0)
    callrt print_i64(p1)
    callrt print_i64(p0)
    callrt print_i64(v1)
    callrt print_i64(v0)
    callrt print_i64(p1)
    callrt print_i64(p0)
    callrt print_i64(v1)
    ret v1
}

fn pair(p0: i64, p1: i64) -> i64 {
b0:
    callrt print_i64(p1)
    v0 = sub p0, p1
    ret v0
}

fn main(p0: i64) -> i64 {
b0:
    v0 = call show(p0) -> i64
    v1 = call show(v0) -> i64
    v2 = call pair(v1, v0) -> i64
    v3 = call show_all(v2, v1) -> i64
    v4 = call show_all(v3, v2) -> i64
    v5 = call pair(v4, p0) -> i64
    ret v5
}
