; A `bool` parameter that gets a constant: the body's `xor p0, 1` must stay a `bool`.
; calls: 0
; run: main 7
; out: => 1785
; run: main -7
; out: => -1785
fn pick(p0: bool, p1: i64) -> i64 {
b0:
    v0 = xor p0, 1
    br v0, b1, b2
b1:
    v1 = neg p1
    ret v1
b2:
    ret p1
}

fn main(p0: i64) -> i64 {
b0:
    v0 = call pick(1, p0) -> i64
    v1 = call pick(0, p0) -> i64
    v2 = shl v0, 8
    v3 = add v2, v1
    ret v3
}
