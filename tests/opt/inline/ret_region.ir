; A callee that gives an aggregate through its last parameter: `ret` becomes the caller's frame object.
; calls: 0
; run: main 4
; out: => 50
fn make_pair(p0: i64, p1: ptr [param 1 read write writebuf resize free]) {
b0:
    v0 = add p0, 1
    store i64, p1, 0, p0  [ret]
    store i64, p1, 8, v0  [ret]
    ret
}

fn main(p0: i64) -> i64 {
    frames 16, 16
b0:
    v0 = frame 0
    v1 = frame 1
    call make_pair(p0, v0)
    call make_pair(10, v1)
    v2 = load i64, v0, 8  [frame 0]
    v3 = load i64, v1, 0  [frame 1]
    v4 = mul v2, v3
    ret v4
}
