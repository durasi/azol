; A frame object ends with the call of its function.
; run:
; err: ir-interp: a load in memory that was freed
; exit: 3
fn leak() -> ptr {
    frames 8
b0:
    v0 = frame 0
    store i64, v0, 0, 5  [frame 0]
    ret v0
}

fn main() -> i64 {
b0:
    v0 = call leak() -> ptr
    v1 = load i64, v0, 0  [ret]
    ret v1
}
