; `realloc` gives a new block with the old bytes. `realloc(0, n)` is
; `alloc(n)` and `free(0)` does nothing.
; run:
; out: => 5, 6, 7
fn main() -> i64, i64, i64 {
    frames 8
b0:
    v0 = callrt realloc(0, 8)
    store i64, v0, 0, 5  [buf(frame 0)]
    v1 = callrt realloc(v0, 24)
    store i64, v1, 8, 6  [buf(frame 0)]
    store i64, v1, 16, 7  [buf(frame 0)]
    v2 = load i64, v1, 0  [buf(frame 0)]
    v3 = load i64, v1, 8  [buf(frame 0)]
    v4 = load i64, v1, 16  [buf(frame 0)]
    callrt free(v1)
    callrt free(0)
    ret v2, v3, v4
}
