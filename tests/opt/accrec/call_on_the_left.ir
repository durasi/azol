; `f(n - 1) + n`, the call as the first operand, and a guard that proves nothing: counted, 3000 levels deep.
; calls: 1
; run: tri 3000
; out: => 4501500
; run: tri 0
; out: => 0
; run: tri 255
; out: => 32640
; run: tri 256
; out: => 32896
fn tri(p0: i64) -> i64 {
b0:
    v0 = eq p0, 0
    br v0, b1, b2
b1:
    ret 0
b2:
    v1 = add p0, -1
    v2 = call tri(v1) -> i64
    v3 = add v2, p0
    ret v3
}
