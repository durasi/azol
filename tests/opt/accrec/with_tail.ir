; One site adds to the result, the other returns the call as it is: both go round (counted), the second with the accumulator unchanged.
; calls: 2
; run: weight 1000
; out: => 6
; run: weight 7
; out: => 3
fn weight(p0: i64) -> i64 {
b0:
    v0 = sle p0, 0
    br v0, b1, b2
b1:
    ret 0
b2:
    v1 = and p0, 1
    v2 = eq v1, 0
    br v2, b3, b4
b3:
    v3 = sar p0, 1
    v4 = call weight(v3) -> i64
    ret v4
b4:
    v5 = sar p0, 1
    v6 = call weight(v5) -> i64
    v7 = add v6, 1
    ret v7
}
