; `(f(n - 1) + 1) * 2`: what is returned is not the operation on the call's result, so nothing is gathered.
; calls: 1
; run: g 10
; out: => 2046
fn g(p0: i64) -> i64 {
b0:
    v0 = sle p0, 0
    br v0, b1, b2
b1:
    ret 0
b2:
    v1 = add p0, -1
    v2 = call g(v1) -> i64
    v3 = add v2, 1
    v4 = mul v3, 2
    ret v4
}
