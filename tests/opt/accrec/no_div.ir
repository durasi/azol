; Division and a shift: neither is associative, both calls stay.
; calls: 2
; run: d 6
; out: => 6000
; run: s 6
; out: => 12
fn d(p0: i64) -> i64 {
b0:
    v0 = sle p0, 1
    br v0, b1, b2
b1:
    ret 1
b2:
    v1 = add p0, -1
    v2 = call d(v1) -> i64
    v3 = mul p0, 1000
    v4 = sdiv v3, v2
    ret v4
}

fn s(p0: i64) -> i64 {
b0:
    v0 = sle p0, 1
    br v0, b1, b2
b1:
    ret 1
b2:
    v1 = add p0, -1
    v2 = call s(v1) -> i64
    v3 = and v2, 3
    v4 = shl p0, v3
    ret v4
}
