; Something is printed between the call and the addition: in a loop it would be printed before the inner calls, so the call stays.
; calls: 1
; run: f 4
; out: 1
; out: 2
; out: 3
; out: 4
; out: => 10
fn f(p0: i64) -> i64 {
b0:
    v0 = sle p0, 0
    br v0, b1, b2
b1:
    ret 0
b2:
    v1 = add p0, -1
    v2 = call f(v1) -> i64
    callrt print_i64(p0)
    v3 = add v2, p0
    ret v3
}
