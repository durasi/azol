; `n * fact(n - 1)`: the product is gathered on the way down; `n` falls towards 1, so nothing is counted.
; calls: 0
; run: fact 10
; out: => 3628800
; run: fact 1
; out: => 1
; run: fact 25
; out: => 7034535277573963776
fn fact(p0: i64) -> i64 {
b0:
    v0 = sle p0, 1
    br v0, b1, b2
b1:
    ret 1
b2:
    v1 = add p0, -1
    v2 = call fact(v1) -> i64
    v3 = mul p0, v2
    ret v3
}
