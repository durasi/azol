; Arithmetic wraps at 64 bits.
; run:
; out: => -9223372036854775808, 9223372036854775807, -2, -9223372036854775808
fn main() -> i64, i64, i64, i64 {
b0:
    v0 = add 9223372036854775807, 1
    v1 = sub -9223372036854775808, 1
    v2 = mul 9223372036854775807, 2
    v3 = neg -9223372036854775808
    ret v0, v1, v2, v3
}
