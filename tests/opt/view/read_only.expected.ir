data "hello, world"

fn main(p0: i64, p1: i64) -> i64 {
    frames 24, 24
b0:
    v0 = frame 0
    v1 = frame 1
    v2 = addr @data+0
    store ptr, v0, 0, v2  [frame 0]
    store i64, v0, 8, 12  [frame 0]
    store i64, v0, 16, 0  [frame 0]
    store i64, v1, 16, 0  [frame 1]
    v10 = ult p1, p0
    br v10, b4, b5
b1:
    v6 = load u8, v3, 0  [buf(frame 1)]
    jump b2(v6)
b2(v7: i64):
    store i64, v1, 16, 0  [frame 1]
    v8 = mul v4, 1000
    v9 = add v8, v7
    ret v9
b3:
    v3 = load ptr, v1, 0  [frame 1]
    v4 = load i64, v1, 8  [frame 1]
    v5 = sgt v4, 0
    br v5, b1, b2(0)
b4:
    trap slice
b5:
    v11 = load i64, v0, 8  [frame 0]
    v12 = ugt p1, v11
    br v12, b4, b6
b6:
    v13 = load ptr, v0, 0  [frame 0]
    v14 = gep v13, p0, 1, 0
    v15 = sub p1, p0
    store ptr, v1, 0, v14  [frame 1]
    store i64, v1, 8, v15  [frame 1]
    store i64, v1, 16, 0  [frame 1]
    jump b3
}
