data "hello, world"

fn first(p0: ptr [param 0 read], p1: i64, p2: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    store i64, v0, 16, 0  [frame 0]
    v7 = ult p2, p1
    br v7, b4, b5
b1:
    v4 = load u8, v1, 0  [buf(frame 0)]
    jump b2(v4)
b2(v5: i64):
    v6 = add v5, v2
    ret v6
b3:
    v1 = load ptr, v0, 0  [frame 0]
    v2 = load i64, v0, 8  [frame 0]
    v3 = sgt v2, 0
    br v3, b1, b2(0)
b4:
    trap slice
b5:
    v8 = load i64, p0, 8  [param 0]
    v9 = ugt p2, v8
    br v9, b4, b6
b6:
    v10 = load ptr, p0, 0  [param 0]
    v11 = gep v10, p1, 1, 0
    v12 = sub p2, p1
    store ptr, v0, 0, v11  [frame 0]
    store i64, v0, 8, v12  [frame 0]
    store i64, v0, 16, 0  [frame 0]
    jump b3
}

fn main(p0: i64, p1: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    v2 = addr @data+0
    store ptr, v0, 0, v2  [frame 0]
    store i64, v0, 8, 12  [frame 0]
    store i64, v0, 16, 0  [frame 0]
    v3 = call first(v0, p0, p1) -> i64
    ret v3
}
