; A value whose definition is laid out after a block that reads it: with
; three registers the allocator gives it a part that starts at the
; instruction that writes it, which was refused ("an interval moves to a
; register in the middle of an instruction"). From `smaller` of
; bench/suite/dijkstra.azl after the passes.
; run: main 0 1
; out: => true, false, true
; run: main 1 0
; out: => false, true, false
fn smaller(p0: ptr [param 0 read], p1: i64, p2: i64) -> bool {
    frames 0, 0
b0:
    v3 = load i64, p0, 8  [param 0]
    v4 = ult p1, v3
    br v4, b5, b4
b2:
    v17 = ult p1, v3
    br v17, b7, b4
b3:
    v29 = load i64, p0, 32  [param 0]
    v30 = ult p1, v29
    br v30, b10, b4
b4:
    trap index
b5:
    v5 = load ptr, p0, 0  [param 0]
    v6 = gep v5, p1, 8, 0
    v7 = load i64, v6, 0  [buf(param 0)]
    v10 = ult p2, v3
    br v10, b6, b4
b6:
    v12 = gep v5, p2, 8, 0
    v13 = load i64, v12, 0  [buf(param 0)]
    v14 = ne v7, v13
    br v14, b2, b3
b7:
    v19 = gep v5, p1, 8, 0
    v20 = load i64, v19, 0  [buf(param 0)]
    v23 = ult p2, v3
    br v23, b8, b4
b8:
    v25 = gep v5, p2, 8, 0
    v26 = load i64, v25, 0  [buf(param 0)]
    v27 = slt v20, v26
    ret v27
b10:
    v31 = load ptr, p0, 24  [param 0]
    v32 = gep v31, p1, 8, 0
    v33 = load i64, v32, 0  [buf(param 0)]
    v36 = ult p2, v29
    br v36, b11, b4
b11:
    v38 = gep v31, p2, 8, 0
    v39 = load i64, v38, 0  [buf(param 0)]
    v40 = slt v33, v39
    ret v40
}

fn main(p0: i64, p1: i64) -> bool, bool, bool {
    frames 48
b0:
    v0 = frame 0
    v1 = callrt alloc(16)
    v2 = callrt alloc(16)
    store i64, v1, 0, 5  [buf(frame 0)]
    store i64, v1, 8, 9  [buf(frame 0)]
    store i64, v2, 0, 4  [buf(frame 0)]
    store i64, v2, 8, 3  [buf(frame 0)]
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, 2  [frame 0]
    store i64, v0, 16, 2  [frame 0]
    store ptr, v0, 24, v2  [frame 0]
    store i64, v0, 32, 2  [frame 0]
    store i64, v0, 40, 2  [frame 0]
    v3 = call smaller(v0, p0, p1) -> bool
    v4 = call smaller(v0, p1, p0) -> bool
    store i64, v1, 0, 9  [buf(frame 0)]
    v5 = call smaller(v0, p1, p0) -> bool
    callrt free(v1)
    callrt free(v2)
    ret v3, v4, v5
}
