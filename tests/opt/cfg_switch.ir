; A `switch` to four blocks that come together again. b1 is reached by
; two of its cases.
; cfg:
; out: fn main
; out:   order: b0 b2 b1 b3 b4
; out:   idom: b0=b0 b2=b0 b1=b0 b3=b0 b4=b0
; out:   live b0: in p0 | out p0
; out:   live b2: in p0 | out p0
; out:   live b1: in p0 | out p0
; out:   live b3: in p0 | out p0
; out:   live b4: in p0 | out -
; run: main 7
; out: => 7
fn main(p0: i64) -> i64 {
b0:
    switch p0, 1 -> b1, 2 -> b2, 3 -> b1, default b3
b1:
    jump b4
b2:
    jump b4
b3:
    jump b4
b4:
    ret p0
}
