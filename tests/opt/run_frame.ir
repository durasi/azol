; Two frame objects; what is stored in one does not show in the other.
; run:
; out: => 11, 22, 33
fn main() -> i64, i64, i64 {
    frames 16, 8
b0:
    v0 = frame 0
    v1 = frame 1
    store i64, v0, 0, 11  [frame 0]
    store i64, v0, 8, 22  [frame 0]
    store i64, v1, 0, 33  [frame 1]
    v2 = load i64, v0, 0  [frame 0]
    v3 = load i64, v0, 8  [frame 0]
    v4 = load i64, v1, 0  [frame 1]
    ret v2, v3, v4
}
