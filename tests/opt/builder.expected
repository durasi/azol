fn sum_to(p0: i64) -> i64 {
b0:
    jump b1(0, 0)
b1(v0: i64, v1: i64):
    v2 = slt v0, p0
    br v2, b2, b4
b2:
    v3 = add v1, v0
    v4 = add v0, 1
    jump b1(v4, v3)
b3:
    ret v1
b4:
    jump b3
}

fn main() -> i64 {
    frames 8
b0:
    v0 = frame 0
    store i64, v0, 0, 7  [frame 0]
    v1 = load i64, v0, 0  [frame 0]
    callrt print_i64(v1)
    v2 = call sum_to(v1) -> i64
    ret v2
}

fn kinds(p0: i64, p1: ptr [param 1 read writebuf]) -> i64 {
