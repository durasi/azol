; The sum of four numbers in a frame object, through `gep`.
; run:
; out: => 56
fn sum(p0: ptr [param 0 read], p1: i64) -> i64 {
b0:
    jump b1(0, 0)
b1(v0: i64, v1: i64):
    v2 = slt v0, p1
    br v2, b2, b3
b2:
    v3 = gep p0, v0, 8, 0
    v4 = load i64, v3, 0  [param 0]
    v5 = add v1, v4
    v6 = add v0, 1
    jump b1(v6, v5)
b3:
    ret v1
}

fn main() -> i64 {
    frames 32
b0:
    v0 = frame 0
    store i64, v0, 0, 10  [frame 0]
    store i64, v0, 8, 20  [frame 0]
    store i64, v0, 16, 30  [frame 0]
    store i64, v0, 24, -4  [frame 0]
    v1 = call sum(v0, 4) -> i64
    ret v1
}
