; Three loops, each inside the one before.
; cfg:
; out: fn main
; out:   order: b0 b1 b2 b3 b4 b5 b6 b7
; out:   idom: b0=b0 b1=b0 b2=b1 b3=b2 b4=b3 b5=b3 b6=b2 b7=b1
; out:   loop 0: header b1, depth 1, parent -, blocks b1 b2 b3 b4 b5 b6, latches b6, exits b7
; out:   loop 1: header b2, depth 2, parent 0, blocks b2 b3 b4 b5, latches b5, exits b6
; out:   loop 2: header b3, depth 3, parent 1, blocks b3 b4, latches b4, exits b5
; out:   live b0: in p0 | out p0
; out:   live b1: in p0 | out p0
; out:   live b2: in p0 | out p0
; out:   live b3: in p0 | out p0
; out:   live b4: in p0 | out p0
; out:   live b5: in p0 | out p0
; out:   live b6: in p0 | out p0
; out:   live b7: in - | out -
fn main(p0: bool) {
b0:
    jump b1
b1:
    br p0, b2, b7
b2:
    br p0, b3, b6
b3:
    br p0, b4, b5
b4:
    jump b3
b5:
    jump b2
b6:
    jump b1
b7:
    ret
}
