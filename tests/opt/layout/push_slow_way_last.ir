; The way of a `push` that asks the runtime for room is written after the way that has room.
fn main(p0: i64) -> i64 {
    frames 24, 8
b0:
    v1 = frame 0
    v9 = frame 1
    store ptr, v1, 0, 0  [frame 0]
    store i64, v1, 8, 0  [frame 0]
    store i64, v1, 16, 0  [frame 0]
    jump b1(0)
b1(v2: i64):
    v3 = slt v2, p0
    br v3, b2, b5
b2:
    v4 = load i64, v1, 8  [frame 0]
    v5 = load i64, v1, 16  [frame 0]
    v6 = ult v4, v5
    br v6, b3, b4
b4:
    store i64, v9, 0, v2  [frame 1]
    callrt list_push(v1, v9, 8)
    jump b6
b3:
    v7 = load ptr, v1, 0  [frame 0]
    v8 = gep v7, v4, 8, 0
    store i64, v8, 0, v2  [buf(frame 0)]
    v10 = add v4, 1
    store i64, v1, 8, v10  [frame 0]
    jump b6
b6:
    v11 = add v2, 1
    jump b1(v11)
b5:
    v12 = load i64, v1, 8  [frame 0]
    callrt drop(v1)
