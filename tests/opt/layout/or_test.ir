; The two tests of `a || b` come one after the other and the block after the `if` follows them; the body both lead to is written after.
fn main(p0: i64) -> i64 {
b0:
    v1 = slt p0, 0
    br v1, b2, b1
b3(v4: i64):
    ret v4
b1:
    v2 = sgt p0, 100
    br v2, b2, b3(p0)
b2:
    v3 = neg p0
    jump b3(v3)
}
