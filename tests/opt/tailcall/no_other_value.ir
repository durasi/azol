; What is returned is not the result of the call: nothing to do here.
; calls: 1
; run: f 4 9
; out: 9
; out: 1
; out: 2
; out: 3
; out: => 4
fn f(p0: i64, p1: i64) -> i64 {
b0:
    v0 = sle p0, 0
    br v0, b1, b2
b1:
    ret p1
b2:
    v1 = add p0, -1
    v2 = call f(v1, p1) -> i64
    callrt print_i64(v2)
    ret p0
}
