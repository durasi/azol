; Something is freed between the call and the `ret`: the call stays a call, the pass does not move the `free`.
; calls: 1
; run: f 4
; out: => 0
fn f(p0: i64) -> i64 {
    frames 8
b0:
    v0 = sle p0, 0
    br v0, b1, b2
b1:
    ret 0
b2:
    v1 = callrt alloc(8)
    store i64, v1, 0, p0  [buf(frame 0)]
    v2 = load i64, v1, 0  [buf(frame 0)]
    v3 = add v2, -1
    v4 = call f(v3) -> i64
    callrt free(v1)
    ret v4
}
