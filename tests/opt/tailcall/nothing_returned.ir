; A function that gives nothing, with an address it hands on unchanged: the second call of the two goes round (counted), the first stays.
; calls: 3
; text: [param 0]
; run: main 6
; out: => 15
fn fill(p0: ptr [param 0 read write], p1: i64, p2: i64) {
b0:
    v0 = sge p1, p2
    br v0, b1, b2
b1:
    ret
b2:
    v1 = add p1, p2
    v2 = sar v1, 1
    v3 = load i64, p0, 0  [param 0]
    v4 = add v3, v2
    store i64, p0, 0, v4  [param 0]
    call fill(p0, p1, v2)
    v5 = add v2, 1
    call fill(p0, v5, p2)
    ret
}

fn main(p0: i64) -> i64 {
    frames 8
b0:
    v0 = frame 0
    store i64, v0, 0, 0  [frame 0]
    call fill(v0, 0, p0)
    v1 = load i64, v0, 0  [frame 0]
    ret v1
}
