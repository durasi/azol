; The function has a frame object: its `frame` moves to the new entry block and the object is used again in every round.
; calls: 2
; run: main 5
; out: => 790
fn note(p0: ptr [param 0 read write], p1: i64) {
b0:
    v0 = load i64, p0, 0  [param 0]
    v1 = mul v0, 3
    v2 = add v1, p1
    store i64, p0, 0, v2  [param 0]
    ret
}

fn step(p0: i64, p1: i64) -> i64 {
    frames 8
b0:
    v0 = frame 0
    v1 = sle p0, 0
    br v1, b1, b2
b1:
    ret p1
b2:
    store i64, v0, 0, p1  [frame 0]
    call note(v0, p0)
    v2 = load i64, v0, 0  [frame 0]
    v3 = add p0, -1
    v4 = call step(v3, v2) -> i64
    ret v4
}

fn main(p0: i64) -> i64 {
b0:
    v0 = call step(p0, 1) -> i64
    ret v0
}
