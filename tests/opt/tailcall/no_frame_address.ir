; The argument is the address of a frame object of this very call: the next round would use the same object, so the call stays.
; calls: 2
; run: main 3
; out: => 106
fn chain(p0: ptr [param 0 read], p1: i64) -> i64 {
    frames 8
b0:
    v0 = frame 0
    v1 = load i64, p0, 0  [param 0]
    v2 = sle p1, 0
    br v2, b1, b2
b1:
    ret v1
b2:
    v3 = add v1, p1
    store i64, v0, 0, v3  [frame 0]
    v4 = add p1, -1
    v5 = call chain(v0, v4) -> i64
    ret v5
}

fn main(p0: i64) -> i64 {
    frames 8
b0:
    v0 = frame 0
    store i64, v0, 0, 100  [frame 0]
    v1 = call chain(v0, p0) -> i64
    ret v1
}
