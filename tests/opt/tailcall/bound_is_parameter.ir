; The bound is a parameter no site changes and the step is one: no count. With a step of two the sum could pass the bound and wrap, so that one is counted.
; calls: 1
; run: one 0 9 0
; out: => 36
; run: two 0 9 0
; out: => 20
fn one(p0: i64, p1: i64, p2: i64) -> i64 {
b0:
    v0 = slt p0, p1
    br v0, b2, b1
b1:
    ret p2
b2:
    v1 = add p2, p0
    v2 = add p0, 1
    v3 = call one(v2, p1, v1) -> i64
    ret v3
}

fn two(p0: i64, p1: i64, p2: i64) -> i64 {
b0:
    v0 = slt p0, p1
    br v0, b2, b1
b1:
    ret p2
b2:
    v1 = add p2, p0
    v2 = add p0, 2
    v3 = call two(v2, p1, v1) -> i64
    ret v3
}
