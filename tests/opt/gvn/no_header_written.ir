; The two parameters exchange their buffers, an element is stored under the second one's name, and they exchange them back: the stores to the first one's header say its buffer may have changed hands, and what was read from it is read again.
fn hide(p0: ptr [param 0 read write writebuf resize free]) {
b0:
    ret
}

fn again(p0: ptr [param 0 read write writebuf], p1: ptr [param 1 read write writebuf], p2: i64) -> i64 {
b0:
    v0 = load ptr, p0, 0  [param 0]
    v1 = gep v0, p2, 8, 0
    v2 = load i64, v1, 0  [buf(param 0)]
    v3 = load ptr, p1, 0  [param 1]
    store ptr, p0, 0, v3  [param 0]
    store ptr, p1, 0, v0  [param 1]
    jump b1(v0)
b1(v4: ptr):
    v5 = gep v4, p2, 8, 0
    store i64, v5, 0, 9  [buf(param 1)]
    store ptr, p0, 0, v0  [param 0]
    store ptr, p1, 0, v3  [param 1]
    v6 = load i64, v1, 0  [buf(param 0)]
    v7 = add v2, v6
    ret v7
}

fn main(p0: i64) -> i64 {
    frames 24, 24
b0:
    v0 = frame 0
    v1 = callrt alloc(32)
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, 4  [frame 0]
    store i64, v0, 16, 4  [frame 0]
    store i64, v1, 0, 10  [buf(frame 0)]
    store i64, v1, 8, 20  [buf(frame 0)]
    store i64, v1, 16, 30  [buf(frame 0)]
    store i64, v1, 24, 40  [buf(frame 0)]
    call hide(v0)
    v2 = frame 1
    v3 = callrt alloc(32)
    store ptr, v2, 0, v3  [frame 1]
    store i64, v2, 8, 4  [frame 1]
    store i64, v2, 16, 4  [frame 1]
    v4 = call again(v0, v2, p0) -> i64
    callrt drop(v0)
    callrt drop(v2)
    ret v4
}
