; The same with a store on one side: at the join the load stays (no block parameter is put in for the two values).
fn hide(p0: ptr [param 0 read write writebuf resize free]) {
b0:
    ret
}

fn main(p0: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    v1 = callrt alloc(32)
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, 4  [frame 0]
    store i64, v0, 16, 4  [frame 0]
    store i64, v1, 0, 10  [buf(frame 0)]
    store i64, v1, 8, 20  [buf(frame 0)]
    store i64, v1, 16, 30  [buf(frame 0)]
    store i64, v1, 24, 40  [buf(frame 0)]
    call hide(v0)
    v2 = gep v1, 1, 8, 0
    v3 = load i64, v2, 0  [buf(frame 0)]
    v4 = slt p0, 0
    br v4, b1, b2
b1:
    store i64, v2, 0, p0  [buf(frame 0)]
    jump b3(v3)
b2:
    jump b3(p0)
b3(v6: i64):
    v7 = load i64, v2, 0  [buf(frame 0)]
    v8 = add v6, v7
    callrt drop(v0)
    ret v8
}
