; The first check's bad side does not stop, it goes on to where the second check is: that block has two ways in and the condition is not known there. (The comparison itself is the first one's.)
fn main(p0: i64, p1: i64) -> i64 {
b0:
    v0 = ult p0, p1
    br v0, b1, b2
b1:
    jump b2
b2:
    v1 = ult p0, p1
    br v1, b3, b9
b3:
    ret p0
b9:
    trap index
}
