fn set(p0: ptr [param 0 read write]) {
b0:
    store i64, p0, 0, 5  [param 0]
    ret
}

fn main(p0: i64) -> i64 {
    frames 8, 8
b0:
    v0 = frame 0
    v1 = frame 1
    store i64, v0, 0, p0  [frame 0]
    store i64, v1, 0, 2  [frame 1]
    call set(v1)
    v6 = load i64, v1, 0  [frame 1]
    v7 = add p0, p0
    v8 = add v7, v6
