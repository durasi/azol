; A call of a function that may write the list's header: everything about the list is read again.
fn hide(p0: ptr [param 0 read write writebuf resize free]) {
b0:
    ret
}

fn shrink(p0: ptr [param 0 read write]) {
b0:
    v0 = load i64, p0, 8  [param 0]
    v1 = sub v0, 1
    store i64, p0, 8, v1  [param 0]
    ret
}

fn main(p0: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    v1 = callrt alloc(32)
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, 4  [frame 0]
    store i64, v0, 16, 4  [frame 0]
    store i64, v1, 0, 10  [buf(frame 0)]
    store i64, v1, 8, 20  [buf(frame 0)]
    store i64, v1, 16, 30  [buf(frame 0)]
    store i64, v1, 24, 40  [buf(frame 0)]
    call hide(v0)
    v2 = load ptr, v0, 0  [frame 0]
    v3 = load i64, v0, 8  [frame 0]
    v4 = load i64, v2, 0  [buf(frame 0)]
    call shrink(v0)
    v6 = load ptr, v0, 0  [frame 0]
    v7 = load i64, v0, 8  [frame 0]
    v8 = load i64, v6, 0  [buf(frame 0)]
    v9 = add v4, v8
    v10 = add v9, v7
    v11 = add v10, v3
    callrt drop(v0)
    ret v11
}
