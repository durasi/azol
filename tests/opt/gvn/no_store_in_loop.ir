; A loop that stores to the list further down: the load at its top stays, the store reaches it the next time round.
fn hide(p0: ptr [param 0 read write writebuf resize free]) {
b0:
    ret
}

fn main(p0: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    v1 = callrt alloc(32)
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, 4  [frame 0]
    store i64, v0, 16, 4  [frame 0]
    store i64, v1, 0, 10  [buf(frame 0)]
    store i64, v1, 8, 20  [buf(frame 0)]
    store i64, v1, 16, 30  [buf(frame 0)]
    store i64, v1, 24, 40  [buf(frame 0)]
    call hide(v0)
    v2 = load i64, v1, 8  [buf(frame 0)]
    jump b1(0, 0)
b1(v3: i64, v4: i64):
    v5 = slt v3, p0
    br v5, b2, b3
b2:
    v6 = load i64, v1, 8  [buf(frame 0)]
    v7 = add v4, v6
    v8 = add v3, 1
    v10 = gep v1, v8, 8, 0
    store i64, v10, 0, v7  [buf(frame 0)]
    jump b1(v8, v7)
b3:
    v9 = add v4, v2
    callrt drop(v0)
    ret v9
}
