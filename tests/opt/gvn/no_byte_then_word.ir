; One byte read, then all eight bytes at the same address: another width, another value; the second load stays.
fn hide(p0: ptr [param 0 read write writebuf resize free]) {
b0:
    ret
}

fn main(p0: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    v1 = callrt alloc(32)
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, 4  [frame 0]
    store i64, v0, 16, 4  [frame 0]
    store i64, v1, 0, 10  [buf(frame 0)]
    store i64, v1, 8, 20  [buf(frame 0)]
    store i64, v1, 16, 30  [buf(frame 0)]
    store i64, v1, 24, 40  [buf(frame 0)]
    call hide(v0)
    v2 = gep v1, p0, 8, 0
    v4 = load u8, v2, 0  [buf(frame 0)]
    v5 = load i64, v2, 0  [buf(frame 0)]
    v6 = sub v5, v4
    callrt drop(v0)
    ret v6
}
