; A call given an address the pass cannot name (it came along an edge) to write through: nothing about memory is known afterwards.
fn set(p0: ptr [param 0 read write]) {
b0:
    store i64, p0, 0, 5  [param 0]
    ret
}

fn main(p0: i64) -> i64 {
    frames 8, 8
b0:
    v0 = frame 0
    v1 = frame 1
    store i64, v0, 0, 1  [frame 0]
    store i64, v1, 0, 2  [frame 1]
    v2 = slt p0, 0
    br v2, b1(v0), b1(v1)
b1(v3: ptr):
    v4 = load i64, v0, 0  [frame 0]
    call set(v3)
    v5 = load i64, v0, 0  [frame 0]
    v6 = add v4, v5
    ret v6
}
