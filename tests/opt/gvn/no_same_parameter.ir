; A store to the buffer of the same parameter through another address (the list holds lists: an inner buffer and the outer one are different regions, two inner ones are not): the load stays.
fn hide(p0: ptr [param 0 read write writebuf resize free]) {
b0:
    ret
}

fn twice(p0: ptr [param 0 read writebuf], p1: i64, p2: i64) -> i64 {
b0:
    v0 = load ptr, p0, 0  [param 0]
    v2 = gep v0, p1, 8, 0
    v3 = gep v0, p2, 8, 0
    v4 = load i64, v2, 0  [buf(param 0)]
    store i64, v3, 0, 1  [buf(param 0)]
    v5 = load i64, v2, 0  [buf(param 0)]
    v6 = add v4, v5
    ret v6
}

fn main(p0: i64, p1: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    v1 = callrt alloc(32)
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, 4  [frame 0]
    store i64, v0, 16, 4  [frame 0]
    store i64, v1, 0, 10  [buf(frame 0)]
    store i64, v1, 8, 20  [buf(frame 0)]
    store i64, v1, 16, 30  [buf(frame 0)]
    store i64, v1, 24, 40  [buf(frame 0)]
    call hide(v0)
    v2 = call twice(v0, p0, p1) -> i64
    callrt drop(v0)
    ret v2
}
