fn pair(p0: ptr [param 0 read], p1: i64) -> i64 {
b0:
    v0 = load i64, p0, 8  [param 0]
    v1 = ult p1, v0
    br v1, b1, b9
b1:
    v2 = load ptr, p0, 0  [param 0]
    v3 = gep v2, p1, 8, 0
    v4 = load i64, v3, 0  [buf(param 0)]
    jump b2
b2:
    v10 = add v4, v4
    ret v10
b9:
    trap index
}

fn main(p0: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    v1 = callrt alloc(32)
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, 4  [frame 0]
    store i64, v0, 16, 4  [frame 0]
    store i64, v1, 0, 10  [buf(frame 0)]
    store i64, v1, 8, 20  [buf(frame 0)]
    store i64, v1, 16, 30  [buf(frame 0)]
    store i64, v1, 24, 40  [buf(frame 0)]
    v2 = call pair(v0, p0) -> i64
    callrt drop(v0)
    ret v2
}
