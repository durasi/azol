; bench/sieve.azl, as lowering without any optimisation gives it: a flag
; takes eight bytes, as in the default mode today, and every access
; reads the list's header again and checks the index.
fn main() {
    frames 24
b0:
    v0 = frame 0
    store ptr, v0, 0, 0  [frame 0]
    store i64, v0, 8, 0  [frame 0]
    store i64, v0, 16, 0  [frame 0]
    v1 = bconst 0
    v2 = bconst 1
    jump b1(0)
b1(v3: i64):
    v4 = sle v3, 20000000
    br v4, b2, b3
b2:
    v5 = load i64, v0, 8  [frame 0]
    v6 = load i64, v0, 16  [frame 0]
    v7 = eq v5, v6
    br v7, b90, b91
b90:
    v8 = eq v6, 0
    v9 = mul v6, 2
    v10 = select v8, 4, v9
    v11 = mul v10, 8
    v12 = load ptr, v0, 0  [frame 0]
    v13 = callrt realloc(v12, v11)
    store ptr, v0, 0, v13  [frame 0]
    store i64, v0, 16, v10  [frame 0]
    jump b91
b91:
    v14 = load ptr, v0, 0  [frame 0]
    v15 = load i64, v0, 8  [frame 0]
    v16 = gep v14, v15, 8, 0
    store bool, v16, 0, v1  [buf(frame 0)]
    v17 = add v15, 1
    store i64, v0, 8, v17  [frame 0]
    v18 = add v3, 1
    jump b1(v18)
b3:
    jump b4(0, 0, 2)
b4(v19: i64, v20: i64, v21: i64):
    v22 = sle v21, 20000000
    br v22, b5, b14
b5:
    v23 = load i64, v0, 8  [frame 0]
    v24 = ult v21, v23
    br v24, b6, b99
b6:
    v25 = load ptr, v0, 0  [frame 0]
    v26 = gep v25, v21, 8, 0
    v27 = load bool, v26, 0  [buf(frame 0)]
    br v27, b13(v19, v20), b7
b7:
    v28 = add v19, 1
    v29 = mul v21, v21
    jump b8(v29)
b8(v30: i64):
    v31 = sle v30, 20000000
    br v31, b9, b12
b9:
    v32 = load i64, v0, 8  [frame 0]
    v33 = ult v30, v32
    br v33, b10, b99
b10:
    v34 = load ptr, v0, 0  [frame 0]
    v35 = gep v34, v30, 8, 0
    store bool, v35, 0, v2  [buf(frame 0)]
    v36 = add v30, v21
    jump b8(v36)
b12:
    jump b13(v28, v21)
b13(v37: i64, v38: i64):
    v39 = add v21, 1
    jump b4(v37, v38, v39)
b14:
    v40 = mul v19, 100000000
    v41 = add v40, v20
    callrt print_i64(v41)
    v42 = load ptr, v0, 0  [frame 0]
    callrt free(v42)
    ret
b99:
    trap index
}
