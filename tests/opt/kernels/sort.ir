; bench/sort.azl, as lowering without any optimisation gives it: the
; list is a header (address, length, capacity) in memory, and every
; access reads the header again and checks the index.
fn quicksort(p0: ptr [param 0 read writebuf], p1: i64, p2: i64) {
b0:
    v0 = sge p1, p2
    br v0, b1, b2
b1:
    ret
b2:
    v1 = add p1, p2
    v2 = sdiv v1, 2
    v3 = load i64, p0, 8  [param 0]
    v4 = ult v2, v3
    br v4, b3, b99
b3:
    v5 = load ptr, p0, 0  [param 0]
    v6 = gep v5, v2, 8, 0
    v7 = load i64, v6, 0  [buf(param 0)]
    jump b4(p1, p2)
b4(v8: i64, v9: i64):
    v10 = sle v8, v9
    br v10, b5, b20
b5:
    jump b6(v8)
b6(v11: i64):
    v12 = load i64, p0, 8  [param 0]
    v13 = ult v11, v12
    br v13, b7, b99
b7:
    v14 = load ptr, p0, 0  [param 0]
    v15 = gep v14, v11, 8, 0
    v16 = load i64, v15, 0  [buf(param 0)]
    v17 = slt v16, v7
    br v17, b8, b9
b8:
    v18 = add v11, 1
    jump b6(v18)
b9:
    jump b10(v9)
b10(v19: i64):
    v20 = load i64, p0, 8  [param 0]
    v21 = ult v19, v20
    br v21, b11, b99
b11:
    v22 = load ptr, p0, 0  [param 0]
    v23 = gep v22, v19, 8, 0
    v24 = load i64, v23, 0  [buf(param 0)]
    v25 = sgt v24, v7
    br v25, b12, b13
b12:
    v26 = sub v19, 1
    jump b10(v26)
b13:
    v27 = sle v11, v19
    br v27, b14, b4(v11, v19)
b14:
    v28 = load i64, p0, 8  [param 0]
    v29 = ult v11, v28
    br v29, b15, b99
b15:
    v30 = load ptr, p0, 0  [param 0]
    v31 = gep v30, v11, 8, 0
    v32 = load i64, v31, 0  [buf(param 0)]
    v33 = load i64, p0, 8  [param 0]
    v34 = ult v19, v33
    br v34, b16, b99
b16:
    v35 = load ptr, p0, 0  [param 0]
    v36 = gep v35, v19, 8, 0
    v37 = load i64, v36, 0  [buf(param 0)]
    v38 = load i64, p0, 8  [param 0]
    v39 = ult v11, v38
    br v39, b17, b99
b17:
    v40 = load ptr, p0, 0  [param 0]
    v41 = gep v40, v11, 8, 0
    store i64, v41, 0, v37  [buf(param 0)]
    v42 = load i64, p0, 8  [param 0]
    v43 = ult v19, v42
    br v43, b18, b99
b18:
    v44 = load ptr, p0, 0  [param 0]
    v45 = gep v44, v19, 8, 0
    store i64, v45, 0, v32  [buf(param 0)]
    v46 = add v11, 1
    v47 = sub v19, 1
    jump b4(v46, v47)
b20:
    call quicksort(p0, p1, v9)
    call quicksort(p0, v8, p2)
    ret
b99:
    trap index
}

fn main() {
    frames 24
b0:
    v0 = frame 0
    store ptr, v0, 0, 0  [frame 0]
    store i64, v0, 8, 0  [frame 0]
    store i64, v0, 16, 0  [frame 0]
    jump b1(42, 0)
b1(v1: i64, v2: i64):
    v3 = slt v2, 2000000
    br v3, b2, b3
b2:
    v4 = mul v1, 48271
    v5 = srem v4, 2147483647
    v6 = srem v5, 1000000
    v7 = load i64, v0, 8  [frame 0]
    v8 = load i64, v0, 16  [frame 0]
    v9 = eq v7, v8
    br v9, b90, b91
b90:
    v10 = eq v8, 0
    v11 = mul v8, 2
    v12 = select v10, 4, v11
    v13 = mul v12, 8
    v14 = load ptr, v0, 0  [frame 0]
    v15 = callrt realloc(v14, v13)
    store ptr, v0, 0, v15  [frame 0]
    store i64, v0, 16, v12  [frame 0]
    jump b91
b91:
    v16 = load ptr, v0, 0  [frame 0]
    v17 = load i64, v0, 8  [frame 0]
    v18 = gep v16, v17, 8, 0
    store i64, v18, 0, v6  [buf(frame 0)]
    v19 = add v17, 1
    store i64, v0, 8, v19  [frame 0]
    v20 = add v2, 1
    jump b1(v5, v20)
b3:
    call quicksort(v0, 0, 1999999)
    jump b4(0, 0)
b4(v21: i64, v22: i64):
    v23 = slt v22, 2000000
    br v23, b5, b7
b5:
    v24 = load i64, v0, 8  [frame 0]
    v25 = ult v22, v24
    br v25, b6, b99
b6:
    v26 = load ptr, v0, 0  [frame 0]
    v27 = gep v26, v22, 8, 0
    v28 = load i64, v27, 0  [buf(frame 0)]
    v29 = srem v22, 7
    v30 = mul v28, v29
    v31 = add v21, v30
    v32 = add v22, 1000
    jump b4(v31, v32)
b7:
    jump b8(1, 1)
b8(v33: i64, v34: i64):
    v35 = slt v34, 2000000
    br v35, b9, b14
b9:
    v36 = sub v34, 1
    v37 = load i64, v0, 8  [frame 0]
    v38 = ult v36, v37
    br v38, b10, b99
b10:
    v39 = load ptr, v0, 0  [frame 0]
    v40 = gep v39, v36, 8, 0
    v41 = load i64, v40, 0  [buf(frame 0)]
    v42 = load i64, v0, 8  [frame 0]
    v43 = ult v34, v42
    br v43, b11, b99
b11:
    v44 = load ptr, v0, 0  [frame 0]
    v45 = gep v44, v34, 8, 0
    v46 = load i64, v45, 0  [buf(frame 0)]
    v47 = sgt v41, v46
    br v47, b12, b13(v33)
b12:
    jump b13(0)
b13(v48: i64):
    v49 = add v34, 1
    jump b8(v48, v49)
b14:
    v50 = add v21, v33
    callrt print_i64(v50)
    v51 = load ptr, v0, 0  [frame 0]
    callrt free(v51)
    ret
b99:
    trap index
}
