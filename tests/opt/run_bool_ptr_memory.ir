; A `bool` and an address can be stored and loaded like a number.
; run:
; out: => true, 77
fn main() -> bool, i64 {
    frames 16, 8
b0:
    v0 = frame 0
    v1 = frame 1
    store i64, v1, 0, 77  [frame 1]
    v2 = bconst 1
    store bool, v0, 0, v2  [frame 0]
    store ptr, v0, 8, v1  [frame 0]
    v3 = load bool, v0, 0  [frame 0]
    v4 = load ptr, v0, 8  [frame 0]
    v5 = load i64, v4, 0  [frame 1]
    ret v3, v5
}
