; Two ways from b0 to b3: neither b1 nor b2 dominates it. An argument
; of a jump is used in the block the jump leaves, so v1 and v2 are not
; alive on the way out of b1 and b2.
; cfg:
; out: fn main
; out:   order: b0 b1 b2 b3
; out:   idom: b0=b0 b1=b0 b2=b0 b3=b0
; out:   live b0: in p0 | out p0
; out:   live b1: in p0 | out -
; out:   live b2: in p0 | out -
; out:   live b3: in - | out -
fn main(p0: i64) -> i64 {
b0:
    v0 = sgt p0, 0
    br v0, b1, b2
b1:
    v1 = add p0, 1
    jump b3(v1)
b2:
    v2 = sub p0, 1
    jump b3(v2)
b3(v3: i64):
    ret v3
}
