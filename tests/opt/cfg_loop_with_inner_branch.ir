; A branch inside a loop: both arms belong to the loop, and the block
; where they meet is its latch.
; cfg:
; out: fn main
; out:   order: b0 b1 b2 b3 b4 b5 b6
; out:   idom: b0=b0 b1=b0 b2=b1 b3=b2 b4=b2 b5=b2 b6=b1
; out:   loop 0: header b1, depth 1, parent -, blocks b1 b2 b3 b4 b5, latches b5, exits b6
; out:   live b0: in p0 | out p0
; out:   live b1: in p0 | out p0 v0 v1
; out:   live b2: in p0 v0 v1 | out p0 v0 v1
; out:   live b3: in p0 v0 v1 | out p0 v0
; out:   live b4: in p0 v0 v1 | out p0 v0
; out:   live b5: in p0 v0 | out p0
; out:   live b6: in v1 | out -
; run: main 5
; out: => 3
fn main(p0: i64) -> i64 {
b0:
    jump b1(0, 0)
b1(v0: i64, v1: i64):
    v2 = slt v0, p0
    br v2, b2, b6
b2:
    v3 = and v0, 1
    v10 = eq v3, 0
    br v10, b3, b4
b3:
    v4 = add v1, 1
    jump b5(v4)
b4:
    v5 = add v1, 0
    jump b5(v5)
b5(v6: i64):
    v7 = add v0, 1
    jump b1(v7, v6)
b6:
    ret v1
}
