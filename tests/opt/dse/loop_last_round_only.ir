; A store before a loop that every path writes again before the read: the loop's own store is kept.
fn main(p0: i64) -> i64 {
    frames 8
b0:
    v0 = frame 0
    store i64, v0, 0, 99  [frame 0]
    store i64, v0, 0, 0  [frame 0]
    jump b1(0)
b1(v1: i64):
    v2 = slt v1, p0
    br v2, b2, b3
b2:
    store i64, v0, 0, v1  [frame 0]
    v3 = add v1, 1
    jump b1(v3)
b3:
    v4 = load i64, v0, 0  [frame 0]
    ret v4
}
