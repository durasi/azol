; Kept: the object is read at a place that is not a constant, so any of its stores may be the one read.
fn main(p0: i64) -> i64 {
    frames 16
b0:
    v0 = frame 0
    store i64, v0, 0, 10  [frame 0]
    store i64, v0, 8, 20  [frame 0]
    v1 = and p0, 1
    v2 = gep v0, v1, 8, 0
    v3 = load i64, v2, 0  [frame 0]
    ret v3
}
