fn work(p0: ptr [param 0 read write], p1: i64) -> i64 {
b0:
    store i64, p0, 0, p1  [param 0]
    v0 = ult p1, 3
    br v0, b1, b2
b1:
    ret p1
b2:
    trap index
}

fn main(p0: i64) -> i64 {
    frames 8
b0:
    v0 = frame 0
    v1 = call work(v0, p0) -> i64
    v2 = load i64, v0, 0  [frame 0]
    ret v2
}
