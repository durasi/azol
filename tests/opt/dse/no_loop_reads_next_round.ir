; Kept: the next round of the loop reads what this round stored.
fn main(p0: i64) -> i64 {
    frames 8
b0:
    v0 = frame 0
    store i64, v0, 0, 0  [frame 0]
    jump b1(0)
b1(v1: i64):
    v2 = slt v1, p0
    br v2, b2, b3
b2:
    v3 = load i64, v0, 0  [frame 0]
    v4 = add v3, v1
    store i64, v0, 0, v4  [frame 0]
    v5 = add v1, 1
    jump b1(v5)
b3:
    v6 = load i64, v0, 0  [frame 0]
    ret v6
}
