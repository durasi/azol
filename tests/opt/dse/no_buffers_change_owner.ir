; Kept: a load from a buffer of another owner may read the store, because a buffer changes owner when a value moves.
fn main(p0: i64) -> i64, i64 {
    frames 8, 8
b0:
    v0 = callrt alloc(16)
    store i64, v0, 0, 1  [buf(frame 0)]
    v1 = load i64, v0, 0  [buf(frame 1)]
    store i64, v0, 0, p0  [buf(frame 0)]
    v2 = load i64, v0, 0  [buf(frame 1)]
    callrt free(v0)
    ret v1, v2
}
