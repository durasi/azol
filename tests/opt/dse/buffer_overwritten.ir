; Two stores to the same place of a buffer in one block.
fn main(p0: i64) -> i64 {
    frames 8
b0:
    v0 = callrt alloc(16)
    store i64, v0, 0, 1  [buf(frame 0)]
    store i64, v0, 8, 2  [buf(frame 0)]
    store i64, v0, 0, p0  [buf(frame 0)]
    v1 = load i64, v0, 0  [buf(frame 0)]
    v2 = load i64, v0, 8  [buf(frame 0)]
    callrt free(v0)
    v3 = add v1, v2
    ret v3
}
