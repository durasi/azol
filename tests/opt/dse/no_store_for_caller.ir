; Kept: the caller reads what is stored through the parameter.
fn work(p0: ptr [param 0 read write], p1: i64) {
b0:
    store i64, p0, 0, p1  [param 0]
    ret
}

fn main(p0: i64) -> i64 {
    frames 8
b0:
    v0 = frame 0
    store i64, v0, 0, 0  [frame 0]
    call work(v0, p0)
    v1 = load i64, v0, 0  [frame 0]
    ret v1
}
