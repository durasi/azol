; A store to a frame object on a path that only stops the program: nothing can see it.
fn main(p0: i64) -> i64 {
    frames 8
b0:
    v0 = frame 0
    store i64, v0, 0, p0  [frame 0]
    v1 = ult p0, 3
    br v1, b1, b2
b1:
    v2 = load i64, v0, 0  [frame 0]
    ret v2
b2:
    store i64, v0, 0, 9  [frame 0]
    callrt print_i64(p0)
    jump b3
b3:
    trap index
}
