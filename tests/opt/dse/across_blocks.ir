; A store written again on every path, in other blocks.
fn main(p0: i64) -> i64 {
    frames 8
b0:
    v0 = frame 0
    store i64, v0, 0, 1  [frame 0]
    v1 = slt p0, 0
    br v1, b1, b2
b1:
    store i64, v0, 0, 2  [frame 0]
    jump b3
b2:
    store i64, v0, 0, 3  [frame 0]
    jump b3
b3:
    v2 = load i64, v0, 0  [frame 0]
    ret v2
}
