; run: main 511
; out: => 255, -1, 511, 511, 255, 511
; run: main -1
; out: => 255, -1, 4294967295, -1, 255, 4294967295
; run: main 4294967423
; out: => 127, 127, 127, 127, 127, 127
; run: main 2147483648
; out: => 0, 0, 2147483648, -2147483648, 0, 2147483648
fn main(p0: i64) -> i64, i64, i64, i64, i64, i64 {
b0:
    v0 = ext8u p0
    v1 = ext8s p0
    v2 = ext32u p0
    v3 = ext32s p0
    v4 = trunc8 p0
    v5 = trunc32 p0
    ret v0, v1, v2, v3, v4, v5
}
