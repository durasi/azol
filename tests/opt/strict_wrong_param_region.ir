; The store says it goes through parameter 0 and goes through 1.
; run:
; err: ir-interp: an access that is not in its region `param 0`
; exit: 3
fn put(p0: ptr [param 0 write], p1: ptr [param 1 write]) {
b0:
    store i64, p1, 0, 1  [param 0]
    ret
}

fn main() {
    frames 8, 8
b0:
    v0 = frame 0
    v1 = frame 1
    call put(v0, v1)
    ret
}
