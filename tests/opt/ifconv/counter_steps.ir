; A counter that steps or stays on a comparison of two values read
; from memory: both ways of the `if` become `select`.
fn w(p0: ptr [param 0 read], p1: i64, p2: i64) -> i64 {
b0:
    v0 = load ptr, p0, 0  [param 0]
    v1 = and p1, 1
    v2 = and p2, 1
    v3 = gep v0, v1, 8, 0
    v4 = load i64, v3, 0  [buf(param 0)]
    v5 = gep v0, v2, 8, 0
    v6 = load i64, v5, 0  [buf(param 0)]
    v7 = slt v4, v6
    br v7, b1, b2
b1:
    v8 = add p1, 1
    jump b3(v8, p2)
b2:
    v9 = add p2, 1
    jump b3(p1, v9)
b3(v10: i64, v11: i64):
    v12 = mul v10, 10
    v13 = add v12, v11
    ret v13
}

fn main(p0: i64, p1: i64, p2: i64, p3: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    v1 = callrt alloc(32)
    store i64, v1, 0, p0  [buf(frame 0)]
    store i64, v1, 8, p1  [buf(frame 0)]
    store i64, v1, 16, 7  [buf(frame 0)]
    store i64, v1, 24, 9  [buf(frame 0)]
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, 4  [frame 0]
    store i64, v0, 16, 4  [frame 0]
    v2 = call w(v0, p2, p3) -> i64
    callrt drop(v0)
    ret v2
}
