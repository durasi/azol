; A cell that one path reads before anything was stored. That path is
; never taken with the arguments of the runs (the interpreter refuses
; such a load); after the pass it reads 0.
fn f(p0: i64) -> i64 {
    frames 8
b0:
    v0 = frame 0
    jump b1
b1:
    v1 = slt p0, 0
    br v1, b3, b2
b2:
    store i64, v0, 0, p0  [frame 0]
    jump b3
b3:
    v2 = load i64, v0, 0  [frame 0]
    v3 = add v2, 1
    ret v3
}
