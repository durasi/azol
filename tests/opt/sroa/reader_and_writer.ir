; A cell passed to a function that only reads keeps its value across
; the call; one passed to a function that writes is read again after.
; Values that never had an address live across both calls.
fn peek(p0: ptr [param 0 read]) -> i64 {
b0:
    v0 = load i64, p0, 0  [param 0]
    v1 = load i64, p0, 0  [param 0]
    v2 = add v0, v1
    ret v2
}

fn poke(p0: ptr [param 0 read write]) {
b0:
    v0 = load i64, p0, 0  [param 0]
    v1 = mul v0, 3
    store i64, p0, 0, v1  [param 0]
    v2 = load i64, p0, 0  [param 0]
    callrt print_i64(v2)
    ret
}

fn f(p0: i64) -> i64 {
    frames 8, 8, 8
b0:
    v0 = frame 0
    v1 = frame 1
    v2 = frame 2
    jump b1
b1:
    store i64, v0, 0, p0  [frame 0]
    store i64, v1, 0, 7  [frame 1]
    store i64, v2, 0, p0  [frame 2]
    v3 = call peek(v0) -> i64
    v4 = load i64, v0, 0  [frame 0]
    call poke(v0)
    v5 = load i64, v0, 0  [frame 0]
    v6 = load i64, v1, 0  [frame 1]
    v7 = load i64, v2, 0  [frame 2]
    v8 = add v3, v4
    v9 = add v8, v5
    v10 = add v9, v6
    v11 = add v10, v7
    ret v11
}
