; Two blocks that jump to each other and are both entered from outside:
; no loop in the sense of the analyses, and still two definitions meet
; in both.
fn f(p0: i64, p1: i64) -> i64 {
    frames 8, 8
b0:
    v0 = frame 0
    v1 = frame 1
    jump b1
b1:
    store i64, v0, 0, p0  [frame 0]
    store i64, v1, 0, 0  [frame 1]
    v2 = sgt p1, 0
    br v2, b2, b3
b2:
    v3 = load i64, v0, 0  [frame 0]
    v4 = add v3, 1
    store i64, v0, 0, v4  [frame 0]
    v5 = load i64, v1, 0  [frame 1]
    v6 = add v5, 1
    store i64, v1, 0, v6  [frame 1]
    v7 = slt v6, 4
    br v7, b3, b4
b3:
    v8 = load i64, v0, 0  [frame 0]
    v9 = mul v8, 2
    store i64, v0, 0, v9  [frame 0]
    v10 = load i64, v1, 0  [frame 1]
    v11 = add v10, 1
    store i64, v1, 0, v11  [frame 1]
    v12 = slt v11, 4
    br v12, b2, b4
b4:
    v13 = load i64, v0, 0  [frame 0]
    ret v13
}
