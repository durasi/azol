; A counter and a sum that live across calls inside a loop. The counter
; never has an address taken; the sum's address goes to a callee that
; writes it each turn, so every turn reads it again after the call. A
; third cell is only read by a callee and keeps its value all along.
fn bump(p0: ptr [param 0 read write], p1: ptr [param 1 read]) {
b0:
    v0 = load i64, p0, 0  [param 0]
    v1 = load i64, p1, 0  [param 1]
    v2 = add v0, v1
    store i64, p0, 0, v2  [param 0]
    ret
}

fn f(p0: i64) -> i64 {
    frames 8, 8, 8
b0:
    v0 = frame 0
    v1 = frame 1
    v2 = frame 2
    jump b1
b1:
    store i64, v0, 0, 0  [frame 0]
    store i64, v1, 0, 1  [frame 1]
    store i64, v2, 0, 3  [frame 2]
    jump b2
b2:
    v3 = load i64, v0, 0  [frame 0]
    v4 = slt v3, p0
    br v4, b3, b4
b3:
    call bump(v1, v2)
    v5 = load i64, v1, 0  [frame 1]
    v6 = load i64, v2, 0  [frame 2]
    v7 = add v5, v6
    callrt print_i64(v7)
    v8 = load i64, v0, 0  [frame 0]
    v9 = add v8, 1
    store i64, v0, 0, v9  [frame 0]
    jump b2
b4:
    v10 = load i64, v1, 0  [frame 1]
    v11 = load i64, v2, 0  [frame 2]
    v12 = mul v10, v11
    ret v12
}
