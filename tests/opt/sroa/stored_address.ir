; The address of one object is written into another. The first then
; stays exactly as it is; the second, which holds the address, is an
; ordinary variable.
fn f(p0: i64) -> i64 {
    frames 8, 8
b0:
    v0 = frame 0
    v1 = frame 1
    jump b1
b1:
    store i64, v0, 0, p0  [frame 0]
    store ptr, v1, 0, v0  [frame 1]
    v2 = load ptr, v1, 0  [frame 1]
    v3 = load i64, v2, 0  [frame 0]
    v4 = add v3, 1
    store i64, v2, 0, v4  [frame 0]
    v5 = load i64, v0, 0  [frame 0]
    ret v5
}
