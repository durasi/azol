fn bump(p0: ptr [param 0 read write], p1: i64) {
b0:
    v0 = load i64, p0, 0  [param 0]
    v1 = add v0, p1
    store i64, p0, 0, v1  [param 0]
    ret
}

fn loop(p0: ptr [param 0 read write], p1: i64) -> i64 {
    frames 0, 0
b0:
    jump b1
b1:
    jump b2(0, 0)
b2(v19: i64, v20: i64):
    v3 = load i64, p0, 8  [param 0]
    v4 = slt v19, v3
    br v4, b3, b5
b3:
    v6 = load i64, p0, 0  [param 0]
    v7 = slt v19, p1
    br v7, b4, b5
b4:
    v11 = add v20, v6
    v12 = add v11, v3
    v13 = add v12, v3
    v14 = add v13, v6
    v15 = add v19, 1
    jump b2(v15, v14)
b5:
    v18 = add v20, v3
    ret v18
}

fn join(p0: ptr [param 0 read write], p1: i64) -> i64 {
b0:
    v0 = load i64, p0, 0  [param 0]
    v1 = load i64, p0, 8  [param 0]
    v2 = slt p1, 2
    br v2, b1, b2
b1:
    call bump(p0, 5)
    jump b3
b2:
    callrt print_i64(v0)
    jump b3
b3:
    v4 = load i64, p0, 0  [param 0]
    v5 = load i64, p0, 8  [param 0]
    v6 = add v0, v1
    v7 = add v6, v4
    v8 = add v7, v5
    ret v8
}

fn forward(p0: ptr [param 0 read write], p1: i64) -> i64 {
b0:
    store i64, p0, 0, p1  [param 0]
    v0 = load i64, p0, 8  [param 0]
    v1 = slt p1, 2
    br v1, b1, b2
b1:
    store i64, p0, 8, 40  [param 0]
    jump b2
b2:
    v3 = load i64, p0, 8  [param 0]
    v4 = add p1, v3
    v5 = add v4, v0
    ret v5
}

fn unknown(p0: ptr [param 0 read write], p1: ptr [param 1 read]) -> i64 {
b0:
    v0 = load i64, p0, 0  [param 0]
    v1 = load ptr, p1, 0  [param 1]
    jump b1
b1:
    call bump(v1, 9)
    jump b2
b2:
    v2 = load i64, p0, 0  [param 0]
    v3 = add v0, v2
    ret v3
}

fn main(p0: i64) -> i64 {
    frames 16, 8
b0:
    v0 = frame 0
    v1 = frame 1
    store i64, v0, 0, 6  [frame 0]
    store i64, v0, 8, 3  [frame 0]
    store ptr, v1, 0, v0  [frame 1]
    v2 = call loop(v0, p0) -> i64
    v3 = call join(v0, p0) -> i64
    v4 = call forward(v0, p0) -> i64
    v5 = call unknown(v0, v1) -> i64
    v7 = mul v2, 3
    v8 = mul v3, 5
    v9 = mul v4, 7
    v10 = mul v5, 11
    v12 = add v7, v8
    v13 = add v12, v9
    v14 = add v13, v10
    v15 = and v14, 127
    ret v15
}
