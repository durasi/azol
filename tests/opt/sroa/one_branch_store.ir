; A variable that only one branch changes: the join needs a parameter.
fn f(p0: i64, p1: i64) -> i64 {
    frames 8
b0:
    v0 = frame 0
    jump b1
b1:
    store i64, v0, 0, p0  [frame 0]
    v1 = sgt p1, 0
    br v1, b2, b3
b2:
    v2 = load i64, v0, 0  [frame 0]
    v3 = mul v2, p1
    store i64, v0, 0, v3  [frame 0]
    jump b3
b3:
    v4 = load i64, v0, 0  [frame 0]
    ret v4
}
