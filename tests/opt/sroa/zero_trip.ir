; A loop that may not run at all, with a call that writes a cell inside
; it: after the loop the cell is in memory on one way in and a value on
; the other, so it is read again.
fn step(p0: ptr [param 0 read write]) {
b0:
    v0 = load i64, p0, 0  [param 0]
    v1 = add v0, 2
    store i64, p0, 0, v1  [param 0]
    ret
}

fn f(p0: i64) -> i64 {
    frames 8, 8
b0:
    v0 = frame 0
    v1 = frame 1
    jump b1
b1:
    store i64, v0, 0, 1  [frame 0]
    store i64, v1, 0, 0  [frame 1]
    jump b2
b2:
    v2 = load i64, v1, 0  [frame 1]
    v3 = slt v2, p0
    br v3, b3, b4
b3:
    call step(v0)
    v4 = load i64, v1, 0  [frame 1]
    v5 = add v4, 1
    store i64, v1, 0, v5  [frame 1]
    jump b2
b4:
    v6 = load i64, v0, 0  [frame 0]
    v7 = load i64, v0, 0  [frame 0]
    v8 = add v6, v7
    ret v8
}
