fn bump(p0: ptr [param 0 read write], p1: ptr [param 1 read]) {
b0:
    v0 = load i64, p0, 0  [param 0]
    v1 = load i64, p1, 0  [param 1]
    v2 = add v0, v1
    store i64, p0, 0, v2  [param 0]
    ret
}

fn f(p0: i64) -> i64 {
    frames 0, 8, 8
b0:
    v1 = frame 1
    v2 = frame 2
    jump b1
b1:
    store i64, v1, 0, 1  [frame 1]
    store i64, v2, 0, 3  [frame 2]
    jump b2(0, 1)
b2(v13: i64, v14: i64):
    v4 = slt v13, p0
    br v4, b3, b4
b3:
    call bump(v1, v2)
    v5 = load i64, v1, 0  [frame 1]
    v7 = add v5, 3
    callrt print_i64(v7)
    v9 = add v13, 1
    jump b2(v9, v5)
b4:
    v12 = mul v14, 3
    ret v12
}
