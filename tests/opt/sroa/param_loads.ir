; Loads through parameters. Behind `p0` nothing changes (it is only
; read): the loads in the loop take the value of the one before it.
; Behind `p1` a store or a call ends what is known.
fn touch(p0: ptr [param 0 read write]) {
b0:
    store i64, p0, 0, 50  [param 0]
    ret
}

fn f(p0: ptr [param 0 read], p1: ptr [param 1 read write], p2: i64) -> i64 {
    frames 8, 8
b0:
    v0 = frame 0
    v1 = frame 1
    jump b1
b1:
    store i64, v0, 0, 0  [frame 0]
    store i64, v1, 0, 0  [frame 1]
    v2 = load i64, p0, 8  [param 0]
    jump b2
b2:
    v3 = load i64, v1, 0  [frame 1]
    v4 = load i64, p0, 8  [param 0]
    v5 = slt v3, v4
    br v5, b3, b4
b3:
    v6 = load i64, p0, 0  [param 0]
    v7 = load i64, p1, 0  [param 1]
    v8 = load i64, p1, 0  [param 1]
    v9 = add v7, v8
    store i64, p1, 0, v9  [param 1]
    v10 = load i64, p1, 0  [param 1]
    call touch(p1)
    v11 = load i64, p1, 0  [param 1]
    v12 = load i64, v0, 0  [frame 0]
    v13 = add v12, v6
    v14 = add v13, v10
    v15 = add v14, v11
    store i64, v0, 0, v15  [frame 0]
    v16 = load i64, v1, 0  [frame 1]
    v17 = add v16, 1
    store i64, v1, 0, v17  [frame 1]
    jump b2
b4:
    v18 = load i64, v0, 0  [frame 0]
    v19 = add v18, v2
    ret v19
}

fn main(p0: i64) -> i64 {
    frames 16, 8
b0:
    v0 = frame 0
    v1 = frame 1
    store i64, v0, 0, 3  [frame 0]
    store i64, v0, 8, p0  [frame 0]
    store i64, v1, 0, 4  [frame 1]
    v2 = call f(v0, v1, 0) -> i64
    v3 = load i64, v1, 0  [frame 1]
    v4 = add v2, v3
    ret v4
}
