; A `ptr` variable that starts as the address of nothing and a `bool`
; that starts as a constant. No constant may be the address of a `gep`,
; and `xor 0, 1` would be a number: the pointer is read back from its
; cell after the store, the `bool` becomes a `bconst`.
fn f(p0: i64) -> i64 {
    frames 8, 8
b0:
    v0 = frame 0
    v1 = frame 1
    jump b1
b1:
    store ptr, v0, 0, 0  [frame 0]
    store bool, v1, 0, 0  [frame 1]
    v2 = sgt p0, 0
    br v2, b2, b3
b2:
    v3 = callrt alloc(16)
    store i64, v3, 0, p0  [buf(frame 0)]
    store i64, v3, 8, 5  [buf(frame 0)]
    store ptr, v0, 0, v3  [frame 0]
    v4 = load bool, v1, 0  [frame 1]
    v5 = xor v4, 1
    store bool, v1, 0, v5  [frame 1]
    jump b3
b3:
    v6 = load bool, v1, 0  [frame 1]
    br v6, b4, b5
b4:
    v7 = load ptr, v0, 0  [frame 0]
    v8 = gep v7, 1, 8, 0
    v9 = load i64, v8, 0  [buf(frame 0)]
    v10 = load i64, v7, 0  [buf(frame 0)]
    v11 = add v9, v10
    callrt free(v7)
    ret v11
b5:
    v12 = load ptr, v0, 0  [frame 0]
    v13 = eq v12, 0
    v14 = select v13, 1, 2
    ret v14
}
