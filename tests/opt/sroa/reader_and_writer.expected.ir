fn peek(p0: ptr [param 0 read]) -> i64 {
b0:
    v0 = load i64, p0, 0  [param 0]
    v2 = add v0, v0
    ret v2
}

fn poke(p0: ptr [param 0 read write]) {
b0:
    v0 = load i64, p0, 0  [param 0]
    v1 = mul v0, 3
    store i64, p0, 0, v1  [param 0]
    callrt print_i64(v1)
    ret
}

fn f(p0: i64) -> i64 {
    frames 8, 0, 0
b0:
    v0 = frame 0
    jump b1
b1:
    store i64, v0, 0, p0  [frame 0]
    v3 = call peek(v0) -> i64
    call poke(v0)
    v5 = load i64, v0, 0  [frame 0]
    v8 = add v3, p0
    v9 = add v8, v5
    v10 = add v9, 7
    v11 = add v10, p0
    ret v11
}
