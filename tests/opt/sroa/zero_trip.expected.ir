fn step(p0: ptr [param 0 read write]) {
b0:
    v0 = load i64, p0, 0  [param 0]
    v1 = add v0, 2
    store i64, p0, 0, v1  [param 0]
    ret
}

fn f(p0: i64) -> i64 {
    frames 8, 0
b0:
    v0 = frame 0
    jump b1
b1:
    store i64, v0, 0, 1  [frame 0]
    jump b2(0)
b2(v9: i64):
    v3 = slt v9, p0
    br v3, b3, b4
b3:
    call step(v0)
    v5 = add v9, 1
    jump b2(v5)
b4:
    v6 = load i64, v0, 0  [frame 0]
    v8 = add v6, v6
    ret v8
}
