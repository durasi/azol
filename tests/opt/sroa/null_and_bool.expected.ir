fn f(p0: i64) -> i64 {
    frames 8, 0
b0:
    v0 = frame 0
    jump b1
b1:
    store ptr, v0, 0, 0  [frame 0]
    v17 = load ptr, v0, 0  [frame 0]
    v18 = bconst 0
    v2 = sgt p0, 0
    br v2, b2, b3(v18, v17)
b2:
    v3 = callrt alloc(16)
    store i64, v3, 0, p0  [buf(frame 0)]
    store i64, v3, 8, 5  [buf(frame 0)]
    v5 = xor v18, 1
    jump b3(v5, v3)
b3(v15: bool, v16: ptr):
    br v15, b4, b5
b4:
    v8 = gep v16, 1, 8, 0
    v9 = load i64, v8, 0  [buf(frame 0)]
    v10 = load i64, v16, 0  [buf(frame 0)]
    v11 = add v9, v10
    callrt free(v16)
    ret v11
b5:
    v13 = eq v16, 0
    v14 = select v13, 1, 2
    ret v14
}
