; A loop with two ways back to its head: one variable is changed on
; one of them only.
fn f(p0: i64) -> i64 {
    frames 8, 8
b0:
    v0 = frame 0
    v1 = frame 1
    jump b1
b1:
    store i64, v0, 0, 0  [frame 0]
    store i64, v1, 0, 0  [frame 1]
    jump b2
b2:
    v2 = load i64, v1, 0  [frame 1]
    v3 = slt v2, p0
    br v3, b3, b6
b3:
    v4 = load i64, v1, 0  [frame 1]
    v5 = add v4, 1
    store i64, v1, 0, v5  [frame 1]
    v6 = and v4, 1
    v7 = eq v6, 0
    br v7, b4, b5
b4:
    jump b2
b5:
    v8 = load i64, v0, 0  [frame 0]
    v9 = add v8, v4
    store i64, v0, 0, v9  [frame 0]
    jump b2
b6:
    v10 = load i64, v0, 0  [frame 0]
    ret v10
}
