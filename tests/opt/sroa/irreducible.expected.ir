fn f(p0: i64, p1: i64) -> i64 {
    frames 0, 0
b0:
    jump b1
b1:
    v2 = sgt p1, 0
    br v2, b2(p0, 0), b3(p0, 0)
b2(v16: i64, v17: i64):
    v4 = add v16, 1
    v6 = add v17, 1
    v7 = slt v6, 4
    br v7, b3(v4, v6), b4(v4)
b3(v14: i64, v15: i64):
    v9 = mul v14, 2
    v11 = add v15, 1
    v12 = slt v11, 4
    br v12, b2(v9, v11), b4(v9)
b4(v18: i64):
    ret v18
}
