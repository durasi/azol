fn bump(p0: ptr [param 0 read write], p1: i64) {
b0:
    v0 = load i64, p0, 0  [param 0]
    v1 = add v0, p1
    store i64, p0, 0, v1  [param 0]
    ret
}

fn f(p0: i64) -> i64 {
    frames 16
b0:
    v0 = frame 0
    v1 = gep v0, 0, 1, 0
    jump b1
b1:
    store i64, v0, 0, 10  [frame 0]
    store i64, v0, 8, 100  [frame 0]
    call bump(v1, 10)
    v4 = load i64, v0, 0  [frame 0]
    v5 = load i64, v0, 8  [frame 0]
    v7 = add p0, v4
    v8 = add v7, v5
    v9 = add v8, v4
    ret v9
}
