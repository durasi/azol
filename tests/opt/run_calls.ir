; Calls with several results, and recursion: 10! and the 20th
; Fibonacci number.
; run:
; out: => 3628800, 6765, 7, 12
fn fact(p0: i64) -> i64 {
b0:
    v0 = sle p0, 1
    br v0, b1, b2
b1:
    ret 1
b2:
    v1 = sub p0, 1
    v2 = call fact(v1) -> i64
    v3 = mul p0, v2
    ret v3
}

fn fib(p0: i64) -> i64 {
b0:
    v0 = slt p0, 2
    br v0, b1, b2
b1:
    ret p0
b2:
    v1 = sub p0, 1
    v2 = call fib(v1) -> i64
    v3 = sub p0, 2
    v4 = call fib(v3) -> i64
    v5 = add v2, v4
    ret v5
}

fn both(p0: i64, p1: i64) -> i64, i64 {
b0:
    v0 = add p0, p1
    v1 = mul p0, p1
    ret v0, v1
}

fn main() -> i64, i64, i64, i64 {
b0:
    v0 = call fact(10) -> i64
    v1 = call fib(20) -> i64
    v2, v3 = call both(3, 4) -> i64, i64
    ret v0, v1, v2, v3
}
