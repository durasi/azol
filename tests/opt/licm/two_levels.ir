; From the inner loop: what depends on nothing goes in front of both
; loops, what depends on the outer counter in front of the inner one.
fn w(p0: ptr [param 0 read], p1: i64) -> i64 {
b0:
    jump b1(0, 0)
b1(v2: i64, v3: i64):
    v4 = slt v2, p1
    br v4, b2, b4
b2:
    jump b5(0, v3)
b5(v10: i64, v11: i64):
    v12 = slt v10, p1
    br v12, b6, b7
b6:
    v13 = add p1, 3
    v14 = mul v2, v13
    v15 = add v14, v10
    v16 = add v11, v15
    v17 = add v10, 1
    jump b5(v17, v16)
b7:
    v9 = add v2, 1
    jump b1(v9, v11)
b4:
    ret v3
}

fn main(p0: i64, p1: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    v1 = callrt alloc(40)
    store i64, v1, 0, 10  [buf(frame 0)]
    store i64, v1, 8, 20  [buf(frame 0)]
    store i64, v1, 16, 30  [buf(frame 0)]
    store i64, v1, 24, 40  [buf(frame 0)]
    store i64, v1, 32, 50  [buf(frame 0)]
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, p0  [frame 0]
    store i64, v0, 16, 5  [frame 0]
    v2 = call w(v0, p1) -> i64
    callrt free(v1)
    ret v2
}
