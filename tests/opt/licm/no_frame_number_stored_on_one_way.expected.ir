fn w(p0: ptr [param 0 read], p1: i64) -> i64 {
    frames 8
b0:
    v20 = frame 0
    v30 = slt p1, 3
    br v30, b6, b7
b6:
    jump b9(0, 0)
b7:
    store i64, v20, 0, p1  [frame 0]
    jump b9(0, 0)
b9(v32: i64, v33: i64):
    v31 = slt p1, 3
    jump b1(v32, v33)
b1(v2: i64, v3: i64):
    v4 = slt v2, p1
    br v4, b2, b4
b2:
    br v31, b4, b8
b8:
    v10 = load i64, v20, 0  [frame 0]
    v8 = add v3, v10
    v9 = add v2, 1
    jump b1(v9, v8)
b4:
    ret v3
}

fn main(p0: i64, p1: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    v1 = callrt alloc(40)
    store i64, v1, 0, 10  [buf(frame 0)]
    store i64, v1, 8, 20  [buf(frame 0)]
    store i64, v1, 16, 30  [buf(frame 0)]
    store i64, v1, 24, 40  [buf(frame 0)]
    store i64, v1, 32, 50  [buf(frame 0)]
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, p0  [frame 0]
    store i64, v0, 16, 5  [frame 0]
    v2 = call w(v0, p1) -> i64
    callrt free(v1)
    ret v2
}
