; A list's header that comes after a number which is tested as a
; tag: the list may be the field of a variant.
fn w(p0: ptr [param 0 read], p1: i64) -> i64 {
b0:
    jump b1(0, 0)
b1(v2: i64, v3: i64):
    v4 = slt v2, p1
    br v4, b2, b4
b2:
    v13 = load i64, p0, 0  [param 0]
    v14 = eq v13, 1
    br v14, b3, b6(v3)
b3:
    v12 = load ptr, p0, 8  [param 0]
    v6 = gep v12, v2, 8, 0
    v7 = load i64, v6, 0  [buf(param 0)]
    v15 = add v3, v7
    jump b6(v15)
b6(v8: i64):
    v9 = add v2, 1
    jump b1(v9, v8)
b4:
    ret v3
}

fn main(p0: i64, p1: i64) -> i64 {
    frames 32
b0:
    v0 = frame 0
    store i64, v0, 0, p0  [frame 0]
    v1 = callrt alloc(40)
    store i64, v1, 0, 10  [buf(frame 0)]
    store i64, v1, 8, 20  [buf(frame 0)]
    store i64, v1, 16, 30  [buf(frame 0)]
    store i64, v1, 24, 40  [buf(frame 0)]
    store i64, v1, 32, 50  [buf(frame 0)]
    store ptr, v0, 8, v1  [frame 0]
    store i64, v0, 16, 5  [frame 0]
    store i64, v0, 24, 5  [frame 0]
    v2 = call w(v0, p1) -> i64
    callrt free(v1)
    ret v2
}
