fn w(p0: ptr [param 0 read], p1: i64, p2: i64) -> i64 {
b0:
    v0 = load i64, p0, 8  [param 0]
    v1 = load ptr, p0, 0  [param 0]
    v20 = gep v1, p2, 8, 0
    v21 = load i64, v20, 0  [buf(param 0)]
    jump b1(0, v21)
b1(v2: i64, v3: i64):
    v4 = slt v2, p1
    br v4, b2, b4
b2:
    v8 = add v3, v21
    v9 = add v2, 1
    jump b1(v9, v8)
b4:
    ret v3
}

fn main(p0: i64, p1: i64) -> i64 {
    frames 24
b0:
    v0 = frame 0
    v1 = callrt alloc(40)
    store i64, v1, 0, 10  [buf(frame 0)]
    store i64, v1, 8, 20  [buf(frame 0)]
    store i64, v1, 16, 30  [buf(frame 0)]
    store i64, v1, 24, 40  [buf(frame 0)]
    store i64, v1, 32, 50  [buf(frame 0)]
    store ptr, v0, 0, v1  [frame 0]
    store i64, v0, 8, 5  [frame 0]
    store i64, v0, 16, 5  [frame 0]
    v2 = call w(v0, p0, p1) -> i64
    callrt free(v1)
    ret v2
}
