; A function that stores through a parameter it declares `write`.
; run:
; out: => 9, 81
fn square_into(p0: ptr [param 0 read write], p1: i64) {
b0:
    v0 = mul p1, p1
    store i64, p0, 8, v0  [param 0]
    store i64, p0, 0, p1  [param 0]
    ret
}

fn main() -> i64, i64 {
    frames 16
b0:
    v0 = frame 0
    call square_into(v0, 9)
    v1 = load i64, v0, 0  [frame 0]
    v2 = load i64, v0, 8  [frame 0]
    ret v1, v2
}
