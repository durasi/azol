fn main(p0: i64, p1: i64) -> i64 {
    frames 24, 24
b0:
    v0 = frame 0
    v20 = frame 1
    v1 = callrt alloc(80)
    v21 = callrt alloc(80)
    store ptr, v0, 0, v1  [frame 0]
