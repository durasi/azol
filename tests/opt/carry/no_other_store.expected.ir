    store i64, v21, 0, 3  [buf(frame 1)]
    store i64, v1, 8, 101  [buf(frame 0)]
    store i64, v1, 16, 102  [buf(frame 0)]
    store i64, v1, 24, 103  [buf(frame 0)]
    store i64, v1, 32, 104  [buf(frame 0)]
    store i64, v1, 40, 105  [buf(frame 0)]
