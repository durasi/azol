fn main(p0: i64, p1: i64) -> i64 {
b0:
    v1 = slt p0, p1
    br v1, b1, b2
b1:
    v2 = sub p0, p1
    v8 = slt v2, 0
    br v8, b4(5), b5
b2:
    v3 = add p0, p1
    v9 = slt v3, 0
    br v9, b4(6), b5
b3(v4: i64, v5: i64):
    v6 = slt v4, 0
    br v6, b4(v5), b5
b4(v7: i64):
    ret v7
b5:
    ret 0
}
