; A block parameter that gets the same value on every edge is that value.
fn main(p0: i64) -> i64 {
b0:
    v0 = slt p0, 0
    v1 = add p0, 1
    br v0, b1, b2
b1:
    callrt print_i64(1)
    jump b3(v1, 1)
b2:
    callrt print_i64(2)
    jump b3(v1, 2)
b3(v2: i64, v3: i64):
    v4 = add v2, v3
    ret v4
}
