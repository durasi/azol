# From the tests of the first compiler: src/sema.rs, `equality_of_enums_without_values`.
==== 1
---- file a.azl (no newline at end)
enum Kind {
 Ident
 Number
 Plus
}
enum Shape {
 Dot
 Circle(i64)
}
enum Flag[T] {
 On
 Off
}
fn main() {
let s = Dot
let b = s == Dot
}
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0311]: `==` works only on enums whose variants hold no values; use `match` for `Shape`
  --> a.azl:16:9
   |
16 | let b = s == Dot
   |         ^
---- asserted 16:9 `==` works only on enums whose variants hold no values; use `match` for `Shape`
---- run check --json a.azl
---- exit 1
---- stdout
