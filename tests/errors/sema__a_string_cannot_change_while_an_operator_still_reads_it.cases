# From the tests of the first compiler: src/sema.rs, `a_string_cannot_change_while_an_operator_still_reads_it`.
==== 1
---- file a.azl (no newline at end)
fn grow(xs: mut List[str]) -> str {
 xs.push("more")
 return "x"
}
fn set(s: mut str) -> str {
 s = "new"
 return s
}
fn main() {
var xs = ["a"]
let s = xs[0] + grow(mut xs)
}
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0411]: cannot pass `xs` as `mut` here: it is still being read earlier in the same expression
  --> a.azl:11:26
   |
11 | let s = xs[0] + grow(mut xs)
   |                          ^
---- asserted 11:26 cannot pass `xs` as `mut` here: it is still being read earlier in the same expression
---- run check --json a.azl
---- exit 1
---- stdout
