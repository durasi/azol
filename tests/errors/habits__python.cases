# Habits from Python (docs/design/agents.md 1.5, compiler/habits.azl): each is answered with an
# error that names the habit and says the azoL form, and with the edit when it is mechanical.
==== E0224: `print("x", 1)`
---- file a.azl
fn main() {
    print("x", 1)
}
---- run check --json a.azl
---- exit 1
---- reports E0224 2:5
---- apply-fix
---- run check --json a.azl
---- exit 0
==== E0127: `} elif x > 0 {`
---- file a.azl
fn main() {
    let x = 1
    if x > 1 {
        print(1)
    } elif x > 0 {
        print(2)
    }
}
---- run check --json a.azl
---- exit 1
---- reports E0127 5:7
---- apply-fix
---- after-has a.azl
    } else if x > 0 {
---- run check --json a.azl
---- exit 0
