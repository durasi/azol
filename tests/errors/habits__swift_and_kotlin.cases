# Habits from Swift and Kotlin (docs/design/agents.md 1.5, compiler/habits.azl): each is answered with an
# error that names the habit and says the azoL form, and with the edit when it is mechanical.
==== E0125: `let s = Shape.Circle(2)`
---- file a.azl
enum Shape {
    Circle(i64)
    Dot
}
fn main() {
    let s = Shape.Circle(2)
    match s {
        Circle(r) => print(r)
        Dot => print(0)
    }
}
---- run check --json a.azl
---- exit 1
---- reports E0125 6:13
---- apply-fix
---- after-has a.azl
    let s = Circle(2)
---- run check --json a.azl
---- exit 0
==== E0223: `print(p.area())`
---- file a.azl
struct P {
    x: i64
}
fn area(p: P) -> i64 {
    return p.x
}
fn main() {
    let p = P { x: 1 }
    print(p.area())
}
---- run check --json a.azl
---- exit 1
---- reports E0223 9:13
---- apply-fix
---- after-has a.azl
    print(area(p))
---- run check --json a.azl
---- exit 0
