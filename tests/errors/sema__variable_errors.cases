# From the tests of the first compiler: src/sema.rs, `variable_errors`.
==== 1
---- file a.azl (no newline at end)
fn main() {
print(x)
}
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0201]: unknown variable `x`
 --> a.azl:2:7
  |
2 | print(x)
  |       ^
---- asserted 2:7 unknown variable `x`
---- run check --json a.azl
---- exit 1
---- stdout
{"severity":"error","code":"E0201","message":"unknown variable `x`","file":"a.azl","line":2,"column":7,"end_line":2,"end_column":8,"source":"print(x)","rule":"A name must be declared before it is used: as a variable, a parameter, a constant or a variant."}
{"summary":{"errors":1,"files":1}}
==== 2
---- file a.azl (no newline at end)
fn main() {
let a = 1
a = 2
}
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0401]: cannot change `a`: declare it with `var` to make it changeable
 --> a.azl:3:1
  |
3 | a = 2
  | ^
---- asserted 3:1 cannot change `a`: declare it with `var` to make it changeable
---- run check --json a.azl
---- exit 1
---- stdout
{"severity":"error","code":"E0401","message":"cannot change `a`: declare it with `var` to make it changeable","file":"a.azl","line":3,"column":1,"end_line":3,"end_column":2,"source":"a = 2","rule":"A variable declared with `let` never changes; only one declared with `var` can be assigned, grown or passed as `mut`.","help":"Declare the variable with `var` instead of `let`.","fix":{"file":"a.azl","line":2,"column":1,"end_line":2,"end_column":4,"replacement":"var"}}
{"summary":{"errors":1,"files":1}}
