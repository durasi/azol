# From the tests of the first compiler: src/sema.rs, `list_type_errors`.
==== 1
---- file a.azl (no newline at end)
struct Point {
 x: i64
 y: i64
}
struct Bag {
 items: List[i64]
 name: str
}
fn total(xs: List[i64]) -> i64 {
 return 0
}
fn grow(xs: mut List[i64]) {
 xs.push(1)
}
fn make() -> List[i64] {
 return [1, 2]
}
fn main() {
let xs = []
}
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0601]: cannot tell what this empty list holds; give the variable a type, as in `var xs: List[i64] = []`
  --> a.azl:19:10
   |
19 | let xs = []
   |          ^
---- asserted 19:10 cannot tell what this empty list holds; give the variable a type, as in `var xs: List[i64] = []`
---- run check --json a.azl
---- exit 1
---- stdout
{"severity":"error","code":"E0601","message":"cannot tell what this empty list holds; give the variable a type, as in `var xs: List[i64] = []`","file":"a.azl","line":19,"column":10,"end_line":19,"end_column":11,"source":"let xs = []","rule":"The type arguments of a generic type or function come from the values given or from the type expected at that place; when neither settles them they must be written.","help":"Give the variable a type."}
{"summary":{"errors":1,"files":1}}
