# From the tests of the first compiler: src/sema.rs, `enum_declaration_errors`.
==== 1
---- file a.azl (no newline at end)
enum T {
 Leaf
 Node(T)
}
fn main() {
}
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0413]: enum `T` contains itself, so it would have no finite size; put the inner value in a `List`
 --> a.azl:1:6
  |
1 | enum T {
  |      ^
---- asserted 1:6 enum `T` contains itself, so it would have no finite size; put the inner value in a `List`
---- run check --json a.azl
---- exit 1
---- stdout
{"severity":"error","code":"E0413","message":"enum `T` contains itself, so it would have no finite size; put the inner value in a `List`","file":"a.azl","line":1,"column":6,"end_line":1,"end_column":7,"source":"enum T {","rule":"A value is stored inline in its owner, so a type cannot contain itself directly; it can through a `List`."}
{"summary":{"errors":1,"files":1}}
