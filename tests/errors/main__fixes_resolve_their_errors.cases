==== arms missing for variants of an enum
---- file a.azl
enum Shape {
    Circle(i64)
    Square(i64, i64)
    Empty
}

fn main() {
    let s = Empty
    match s {
        Circle(r) => print(r)
    }
}
---- run check --json a.azl
---- exit 1
---- stdout
{"severity":"error","code":"E0501","message":"this `match` does not handle `Square` and `Empty`; add arms for them or a final `_ =>` arm","file":"a.azl","line":9,"column":5,"end_line":9,"end_column":10,"source":"    match s {","rule":"A `match` handles every case: each variant of an enum, both `true` and `false`, or has a final `_ =>` arm.","help":"Add the missing arms.","fix":{"file":"a.azl","line":11,"column":5,"end_line":11,"end_column":5,"replacement":"    Square(_, _) => {}\n        Empty => {}\n    "}}
{"summary":{"errors":1,"files":1}}
---- reports E0501
---- apply-fix
---- after a.azl
enum Shape {
    Circle(i64)
    Square(i64, i64)
    Empty
}

fn main() {
    let s = Empty
    match s {
        Circle(r) => print(r)
        Square(_, _) => {}
        Empty => {}
    }
}
