# From the tests of the first compiler: src/main.rs, `fixes_resolve_their_errors`.
==== `let` must be `var`: assigned
---- file a.azl
fn main() {
    let total = 0
    total = total + 1
}
---- run check --json a.azl
---- exit 1
---- stdout
{"severity":"error","code":"E0401","message":"cannot change `total`: declare it with `var` to make it changeable","file":"a.azl","line":3,"column":5,"end_line":3,"end_column":10,"source":"    total = total + 1","rule":"A variable declared with `let` never changes; only one declared with `var` can be assigned, grown or passed as `mut`.","help":"Declare the variable with `var` instead of `let`.","fix":{"file":"a.azl","line":2,"column":5,"end_line":2,"end_column":8,"replacement":"var"}}
{"summary":{"errors":1,"files":1}}
---- reports E0401
---- apply-fix
---- after a.azl
fn main() {
    var total = 0
    total = total + 1
}
---- after-has a.azl
    var total = 0
---- run check a.azl
---- exit 0
---- stdout (empty)
