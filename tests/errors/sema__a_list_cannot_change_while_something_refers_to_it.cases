# From the tests of the first compiler: src/sema.rs, `a_list_cannot_change_while_something_refers_to_it`.
==== 1
---- file a.azl (no newline at end)
struct Point {
 x: i64
 y: i64
}
struct Bag {
 items: List[i64]
 name: str
}
fn total(xs: List[i64]) -> i64 {
 return 0
}
fn grow(xs: mut List[i64]) {
 xs.push(1)
}
fn make() -> List[i64] {
 return [1, 2]
}
fn main() {
var xs = [1]
for x in xs {
xs.push(x)
}
}
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0408]: cannot change `xs` while a loop is going through it
  --> a.azl:21:1
   |
21 | xs.push(x)
   | ^
---- asserted 21:1 cannot change `xs` while a loop is going through it
---- run check --json a.azl
---- exit 1
---- stdout
{"severity":"error","code":"E0408","message":"cannot change `xs` while a loop is going through it","file":"a.azl","line":21,"column":1,"end_line":21,"end_column":3,"source":"xs.push(x)","rule":"A list cannot be changed while a `for` loop is going through it."}
{"summary":{"errors":1,"files":1}}
