# From the tests of the first compiler: src/main.rs, `a_fix_in_a_later_file_is_placed_inside_that_file`.
==== 1
---- file a.azl
fn main() {
    count()
}
---- file b.azl
fn count() {
    let n = 0
    n = n + 1
}
---- run check --json a.azl b.azl
---- exit 1
---- stdout
{"severity":"error","code":"E0401","message":"cannot change `n`: declare it with `var` to make it changeable","file":"b.azl","line":3,"column":5,"end_line":3,"end_column":6,"source":"    n = n + 1","rule":"A variable declared with `let` never changes; only one declared with `var` can be assigned, grown or passed as `mut`.","help":"Declare the variable with `var` instead of `let`.","fix":{"file":"b.azl","line":2,"column":5,"end_line":2,"end_column":8,"replacement":"var"}}
{"summary":{"errors":1,"files":2}}
---- reports b.azl E0401 3:5
---- fix-at b.azl 2:5-2:8
---- apply-fix
---- after b.azl
fn count() {
    var n = 0
    n = n + 1
}
---- run check a.azl b.azl
---- exit 0
---- stdout (empty)
---- stderr
checked 7 lines in 2 files: no errors
