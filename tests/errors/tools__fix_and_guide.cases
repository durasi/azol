# `azol fix` and `azol guide` (docs/design/agents.md, docs/language.md 16.6 and 16.7).
==== `fix` repairs a program written from the habits of three languages
---- file a.azl
use std::fs;

pub fn total(xs: &Vec<i64>) -> i32 {
    let mut sum = 0;
    for x in xs.iter() {
        sum += x;
    }
    return sum;
}

fn main() {
    let xs: Vec<i64> = vec![1, 2, 3];
    let n = total(&xs);
    println!("total {}", n);
    if n > 3 and not (n == 7) {
        console.log("n = " + n);
    } elif n === 2 {
        print(len(xs));
    }
    let s: String = String::from("abc");
    print(s.length());
    print(xs.clone().size());
}
---- run fix a.azl
---- exit 0
