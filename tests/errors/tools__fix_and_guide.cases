---- after a.azl
fn total(xs: List[i64]) -> i64 {
    var sum = 0
    for x in xs {
        sum += x
    }
    return sum
}

fn main() {
    let xs: List[i64] = [1, 2, 3]
    let n = total(xs)
    print("total {n}")
    if n > 3 && !(n == 7) {
        print("n = " + str(n))
    } else if n == 2 {
        print(xs.len())
    }
    let s: str = "abc"
    print(s.len())
    print(xs.len())
}
