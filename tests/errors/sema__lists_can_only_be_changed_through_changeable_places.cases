# From the tests of the first compiler: src/sema.rs, `lists_can_only_be_changed_through_changeable_places`.
==== 1
---- file a.azl (no newline at end)
struct Point {
 x: i64
 y: i64
}
struct Bag {
 items: List[i64]
 name: str
}
fn total(xs: List[i64]) -> i64 {
 return 0
}
fn grow(xs: mut List[i64]) {
 xs.push(1)
}
fn make() -> List[i64] {
 return [1, 2]
}
fn main() {
let xs = [1]
xs.push(2)
}
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0401]: cannot change `xs`: declare it with `var` to make it changeable
  --> a.azl:20:1
   |
20 | xs.push(2)
   | ^
---- asserted 20:1 cannot change `xs`: declare it with `var` to make it changeable
---- run check --json a.azl
---- exit 1
---- stdout
{"severity":"error","code":"E0401","message":"cannot change `xs`: declare it with `var` to make it changeable","file":"a.azl","line":20,"column":1,"end_line":20,"end_column":3,"source":"xs.push(2)","rule":"A variable declared with `let` never changes; only one declared with `var` can be assigned, grown or passed as `mut`.","help":"Declare the variable with `var` instead of `let`.","fix":{"file":"a.azl","line":19,"column":1,"end_line":19,"end_column":4,"replacement":"var"}}
{"summary":{"errors":1,"files":1}}
