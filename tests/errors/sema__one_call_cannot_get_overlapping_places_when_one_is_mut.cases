# From the tests of the first compiler: src/sema.rs, `one_call_cannot_get_overlapping_places_when_one_is_mut`.
==== 1
---- file a.azl (no newline at end)
struct Point {
 x: i64
 y: i64
}
struct Line {
 from: Point
 to: Point
}
fn swap(a: mut Point, b: mut Point) {
}
fn mix(a: mut Point, b: Point) {
}
fn both(a: Point, b: Point) {
}
fn bump(n: mut i64, by: i64) {
}
fn two(a: mut i64, b: mut i64) {
}
fn id(p: Point) -> Point {
 return p
}
fn touch(p: mut Point) -> i64 {
 return 1
}
fn sum(p: Point, n: i64) -> i64 {
 return n
}
fn main() {
var p = Point { x: 1, y: 2 }
var q = Point { x: 3, y: 4 }
var l = Line { from: p, to: q }
swap(mut p, mut p)
}
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0410]: `p` is passed twice in one call and one of the uses is `mut`; copy it into a variable first
  --> a.azl:32:17
   |
32 | swap(mut p, mut p)
   |                 ^
---- asserted 32:17 `p` is passed twice in one call and one of the uses is `mut`; copy it into a variable first
---- run check --json a.azl
---- exit 1
---- stdout
