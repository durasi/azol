# From the tests of the first compiler: src/sema.rs, `generic_structs`.
==== 1
---- file a.azl (no newline at end)
struct Pair[A, B] {
 first: A
 second: B
}
struct Stack[T] {
 items: List[T]
}
fn main() {
let p = Pair { first: 1, second: "x" }
let q: Pair[str, i64] = p
}
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0301]: expected `Pair[str, i64]` but this is `Pair[i64, str]`
  --> a.azl:10:25
   |
10 | let q: Pair[str, i64] = p
   |                         ^
---- asserted 10:25 expected `Pair[str, i64]` but this is `Pair[i64, str]`
---- run check --json a.azl
---- exit 1
---- stdout
