# From the tests of the first compiler: src/sema.rs, `struct_value_errors`.
==== 1
---- file a.azl (no newline at end)
struct Point {
 x: i64
 y: i64
}
struct Line {
 from: Point
 to: Point
}
fn main() {
let p = Point { x: 1 }
}
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0313]: field `y` of `Point` is missing
  --> a.azl:10:9
   |
10 | let p = Point { x: 1 }
   |         ^
---- asserted 10:9 field `y` of `Point` is missing
---- run check --json a.azl
---- exit 1
---- stdout
{"severity":"error","code":"E0313","message":"field `y` of `Point` is missing","file":"a.azl","line":10,"column":9,"end_line":10,"end_column":14,"source":"let p = Point { x: 1 }","rule":"A struct literal gives every field of the struct exactly once."}
