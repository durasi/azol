# From the tests of the first compiler: src/sema.rs, `string_errors`.
==== 1
---- file a.azl (no newline at end)
fn main() {
let a = str("x")
}
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0308]: `str` turns an `i64` or a `bool` into text but this is `str`
 --> a.azl:2:13
  |
2 | let a = str("x")
  |             ^
---- asserted 2:13 `str` turns an `i64` or a `bool` into text but this is `str`
---- run check --json a.azl
---- exit 1
---- stdout
{"severity":"error","code":"E0308","message":"`str` turns an `i64` or a `bool` into text but this is `str`","file":"a.azl","line":2,"column":13,"end_line":2,"end_column":16,"source":"let a = str(\"x\")","rule":"`print` and `str` work on numbers, `bool`s and (for `print`) strings only."}
