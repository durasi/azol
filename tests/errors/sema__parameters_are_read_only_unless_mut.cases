==== 2
---- file a.azl (no newline at end)
struct Point {
 x: i64
 y: i64
}
struct Line {
 from: Point
 to: Point
}
fn shift(p: mut Point, dx: i64) {
 p.x = p.x + dx
}
fn main() {
var p = Point { x: 1, y: 2 }
shift(p, 3)
}
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0405]: argument 1 of `shift` can be changed by the function, so it must be written `mut <variable>`
  --> a.azl:14:7
   |
14 | shift(p, 3)
   |       ^
---- asserted 14:7 argument 1 of `shift` can be changed by the function, so it must be written `mut <variable>`
