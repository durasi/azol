# From the tests of the first compiler: src/sema.rs, `parameters_are_read_only_unless_mut`.
==== 1
---- file a.azl (no newline at end)
struct Point {
 x: i64
 y: i64
}
struct Line {
 from: Point
 to: Point
}
fn f(p: Point) {
 p.x = 1
}
fn main() {

}
---- run check a.azl
---- exit 1
