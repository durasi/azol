# From the tests of the first compiler: src/main.rs, `a_report_covers_the_whole_expression_or_name`.
==== a name
---- file a.azl
fn main() {
    print(çay)
}
---- run check --json a.azl
---- exit 1
---- stdout
{"severity":"error","code":"E0201","message":"unknown variable `çay`","file":"a.azl","line":2,"column":11,"end_line":2,"end_column":14,"source":"    print(çay)","rule":"A name must be declared before it is used: as a variable, a parameter, a constant or a variant."}
{"summary":{"errors":1,"files":1}}
---- reports * 2:11-2:14
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0201]: unknown variable `çay`
 --> a.azl:2:11
  |
2 |     print(çay)
  |           ^
==== a whole operand, brackets and call included
---- file a.azl
fn f(a: i64) -> bool {
    return true
}

fn main() {
    print(1 + f(2 * (3 + 4)))
}
---- run check --json a.azl
---- exit 1
---- stdout
{"severity":"error","code":"E0302","message":"`+` needs `i64` but this is `bool`","file":"a.azl","line":6,"column":15,"end_line":6,"end_column":29,"source":"    print(1 + f(2 * (3 + 4)))","rule":"An operator, an argument, a field and a list element each need a value of one exact type; nothing is converted silently."}
{"summary":{"errors":1,"files":1}}
---- reports * 6:15-6:29
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0302]: `+` needs `i64` but this is `bool`
 --> a.azl:6:15
  |
6 |     print(1 + f(2 * (3 + 4)))
  |               ^
==== parentheses around the whole of it are not part of the tree
---- file a.azl
fn main() {
    let a: i64 = (1 < 2)
}
---- run check --json a.azl
---- exit 1
---- stdout
{"severity":"error","code":"E0301","message":"expected `i64` but this is `bool`","file":"a.azl","line":2,"column":19,"end_line":2,"end_column":24,"source":"    let a: i64 = (1 < 2)","rule":"A value stored in a variable or a place has exactly the type of that variable or place; nothing is converted silently."}
{"summary":{"errors":1,"files":1}}
