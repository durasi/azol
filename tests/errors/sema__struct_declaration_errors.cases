# From the tests of the first compiler: src/sema.rs, `struct_declaration_errors`.
==== 1
---- file a.azl (no newline at end)
struct A {
 b: B
}
struct B {
 a: A
}
fn main() {
}
---- run check a.azl
---- exit 1
---- stdout (empty)
---- stderr
error[E0413]: struct `A` contains itself, so it would have no finite size
 --> a.azl:1:8
  |
1 | struct A {
  |        ^
---- asserted 1:8 struct `A` contains itself, so it would have no finite size
---- run check --json a.azl
---- exit 1
---- stdout
{"severity":"error","code":"E0413","message":"struct `A` contains itself, so it would have no finite size","file":"a.azl","line":1,"column":8,"end_line":1,"end_column":9,"source":"struct A {","rule":"A value is stored inline in its owner, so a type cannot contain itself directly; it can through a `List`."}
{"summary":{"errors":1,"files":1}}
