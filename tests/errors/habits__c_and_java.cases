# Habits from C, C++ and Java (docs/design/agents.md 1.5, compiler/habits.azl): each is answered with an
# error that names the habit and says the azoL form, and with the edit when it is mechanical.
==== E0120: `let x = 1;`
---- file a.azl
fn main() {
    let x = 1;
    print(x)
}
---- run check --json a.azl
---- exit 1
---- reports E0120 2:14
---- apply-fix
---- after-has a.azl
    let x = 1
---- run check --json a.azl
---- exit 0
==== E0123: `*p = 3`
---- file a.azl
fn main() {
    var p = 1
    *p = 3
    print(p)
}
---- run check --json a.azl
---- exit 1
---- reports E0123 3:5
---- apply-fix
---- after-has a.azl
    p = 3
---- run check --json a.azl
---- exit 0
