    print("{x}")
---- run check a.azl
---- exit 0
==== a numbered value
---- file a.azl
fn main() {
    var x = 1
    let xs = [1, 2]
    print("{0}", x)
    print(x + xs[0])
}
---- run check --json a.azl
---- exit 1
---- reports E1413 4:12
---- no-fix
==== a format after the value
---- file a.azl
fn main() {
    var x = 1
    let xs = [1, 2]
    print("{x:>5}")
    print(x + xs[0])
}
---- run check --json a.azl
---- exit 1
---- reports E1413 4:12
---- no-fix
==== two expressions in one value
---- file a.azl
fn main() {
    var x = 1
    let xs = [1, 2]
    print("{x xs}")
    print(x + xs[0])
}
---- run check --json a.azl
---- exit 1
---- reports E1413 4:15
---- no-fix
==== a constant text holds no values
---- file a.azl
const GREETING = "hello {name}"

fn main() {
    print(GREETING)
}
---- run check --json a.azl
---- exit 1
---- reports E1410 1:25
---- apply-fix
---- after-has a.azl
const GREETING = "hello \{name}"
---- run check a.azl
---- exit 0
==== a pattern is a fixed text
---- file a.azl
fn main() {
    let s = "{}"
    match s {
        "{}" => print(1)
        _ => print(2)
    }
}
---- run check --json a.azl
---- exit 1
---- reports E1411 2:14
---- apply-fix
---- run check --json a.azl
---- exit 1
---- reports E1411 4:10
---- apply-fix
---- after-has a.azl
        "\{}" => print(1)
---- run check a.azl
---- exit 0
