const B = A + 1
const A = 1
const MASK: i64 = (1 << 4) - 1 | 0x100 ^ 0b11 & 'a'
const YES: bool = !false && B >= 2 || A != 1
const NAME: str = "n"
const Q = 7 / 2 * 3 % 5 - -1 >> 1
const SAME = true == YES
fn main() {
let a: i64 = A + B * MASK
let b: bool = YES && SAME
let c: str = NAME + NAME
var xs = [A, B]
xs.push(Q)
if A < B {
 print(NAME)
}
print(A)
print(YES)
}
