fn grow(xs: mut List[str]) -> str {
 xs.push("more")
 return "x"
}
fn set(s: mut str) -> str {
 s = "new"
 return s
}
fn main() {
var xs = ["a"]
let s = grow(mut xs) + xs[0]
}
