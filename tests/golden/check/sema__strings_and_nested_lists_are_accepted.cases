 items: List[i64]
 name: str
}
fn total(xs: List[i64]) -> i64 {
 return 0
}
fn grow(xs: mut List[i64]) {
 xs.push(1)
}
fn make() -> List[i64] {
 return [1, 2]
}
fn main() {
var grid = [[1, 2], [3]]
grid.push([4])
grid[0].push(5)
grid[1][0] = 6
let row = grid.pop()
for line in grid {
for x in line {
print(x + row.len())
}
}
}
