struct Node {
 value: i64
 children: List[Node]
}
fn size(n: Node) -> i64 {
 var total = 1
 for child in n.children {
 total = total + size(child)
 }
 return total
}
fn main() {
 let leaf = Node { value: 1, children: [] }
 let root = Node { value: 0, children: [leaf, leaf] }
 print(size(root))
}
