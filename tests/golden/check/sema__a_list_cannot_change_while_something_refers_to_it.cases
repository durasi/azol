 return 0
}
fn grow(xs: mut List[i64]) {
 xs.push(1)
}
fn make() -> List[i64] {
 return [1, 2]
}
fn main() {
var xs = [1]
var ys = [2]
for x in xs {
ys.push(x + xs.len() + total(xs))
}
xs.push(3)
}
