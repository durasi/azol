# From the tests of the first compiler: src/parser.rs, `multi_line_expressions`.
==== 1
---- file a.azl (no newline at end)
fn t() {
let x = a +
    b
}
---- run parse a.azl
---- exit 0
---- stdout
fn t()
  let x = (+ a b)
---- stderr
parsed 4 lines into 5 nodes
==== 2
