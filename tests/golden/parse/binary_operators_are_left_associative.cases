# From the tests of the first compiler: src/parser.rs, `binary_operators_are_left_associative`.
==== 1
---- file a.azl (no newline at end)
fn t() {
x = a - b - c
}
---- run parse a.azl
---- exit 0
---- stdout
fn t()
