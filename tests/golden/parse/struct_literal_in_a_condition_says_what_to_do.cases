# From the tests of the first compiler: src/parser.rs, `struct_literal_in_a_condition_says_what_to_do`.
==== 1
---- file a.azl (no newline at end)
fn t() {
if a == b {
x = 1
}
}
---- run parse a.azl
---- exit 0
---- stdout
fn t()
