// tokenizer: a lexer over source text.
// Algorithm: split azoL-like source into identifiers, keywords, numbers
// (decimal and hexadecimal), strings, operators of one or two characters
// and line ends; comments are skipped. A compact lexer written for the
// suite, not the compiler's own.
// Sizes: 2,400,000 lines; small: 14,000 lines.
// Output: counts of identifiers, keywords, numbers, strings, operators and
// lines, and the sum of the numbers modulo 1,000,000,007.
// `SMALL` selects the small size; the gate changes that one line.
const SMALL = false

fn size(full: i64, small: i64) -> i64 {
    if SMALL {
        return small
    }
    return full
}

fn is_letter(c: i64) -> bool {
    return c >= 97 && c <= 122 || c >= 65 && c <= 90 || c == 95
}

fn is_digit(c: i64) -> bool {
    return c >= 48 && c <= 57
}

fn hex_value(c: i64) -> i64 {
    if is_digit(c) {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return -1
}

fn source(lines: i64) -> str {
    let snippet = [
        "// Adds the weights of every edge that leaves a node.",
        "fn total_weight(graph: Graph, node: i64) -> i64 {",
        "    var sum = 0",
        "    for edge in graph.edges {",
        "        if edge.source == node && edge.weight >= 10 {",
        "            sum = sum + edge.weight * 3 - 0x1F",
        "        } else if edge.label != \"skip me\" || node << 2 > 4096 {",
        "            sum = sum - 1",
        "        }",
        "    }",
        "    let message = \"total: \" + str(sum)   // shown to the user",
        "    return sum % 1000007",
        "}",
        "",
    ]
    var text = ""
    var n = 0
    while n < lines {
        text = text + snippet[n % snippet.len()]
        text.push(10)
        n = n + 1
    }
    return text
}

fn main() {
    let text = source(size(2400000, 14000))
    let keywords = ["fn", "let", "var", "mut", "const", "struct", "enum", "if", "else", "match", "while", "for", "in", "break", "continue", "return", "true", "false"]
    var identifiers = 0
    var keyword_count = 0
    var numbers = 0
    var strings = 0
    var operators = 0
    var lines = 0
    var sum = 0
    var at = 0
    let end = text.len()
    while at < end {
        let c = text[at]
        if c == 32 {
            at = at + 1
        } else if c == 10 {
            lines = lines + 1
            at = at + 1
        } else if is_letter(c) {
            let start = at
            while at < end && (is_letter(text[at]) || is_digit(text[at])) {
                at = at + 1
            }
            if keywords.contains(text.slice(start, at)) {
                keyword_count = keyword_count + 1
            } else {
                identifiers = identifiers + 1
            }
        } else if is_digit(c) {
            var value = 0
            if c == 48 && at + 1 < end && text[at + 1] == 120 {
                at = at + 2
                while at < end && hex_value(text[at]) >= 0 {
                    value = value * 16 + hex_value(text[at])
                    at = at + 1
                }
            } else {
                while at < end && is_digit(text[at]) {
                    value = value * 10 + text[at] - 48
                    at = at + 1
                }
            }
            numbers = numbers + 1
            sum = (sum + value) % 1000000007
        } else if c == 34 {
            at = at + 1
            while at < end && text[at] != 34 {
                at = at + 1
            }
            at = at + 1
            strings = strings + 1
        } else if c == 47 && at + 1 < end && text[at + 1] == 47 {
            while at < end && text[at] != 10 {
                at = at + 1
            }
        } else {
            var width = 1
            if at + 1 < end {
                let d = text[at + 1]
                if d == 61 && (c == 61 || c == 33 || c == 60 || c == 62) {
                    width = 2
                } else if c == d && (c == 38 || c == 124 || c == 60 || c == 62) {
                    width = 2
                } else if d == 62 && (c == 45 || c == 61) {
                    width = 2
                }
            }
            operators = operators + 1
            at = at + width
        }
    }
    print(str(identifiers) + " " + str(keyword_count) + " " + str(numbers) + " " + str(strings) + " " + str(operators) + " " + str(lines) + " " + str(sum))
}
