// nbody: a floating-point simulation.
// Algorithm: five bodies under gravity, advanced with the symplectic Euler
// step of the classic "n-body" benchmark.
// Sizes: 5,000,000 steps; small: 20,000.
// Output: the energy before and after, times 1,000,000,000 and rounded.
// NOT YET COMPILABLE: azoL has no `f64` yet. This file is the program as it
// will be written once docs/design/floats.md is implemented; the gate skips
// it until then. Rename it to `nbody.azl` when it builds.
// `SMALL` selects the small size; the gate changes that one line.
const SMALL = false

fn size(full: i64, small: i64) -> i64 {
    if SMALL {
        return small
    }
    return full
}

struct Body {
    x: f64
    y: f64
    z: f64
    vx: f64
    vy: f64
    vz: f64
    mass: f64
}

const PI = 3.141592653589793
const SOLAR_MASS = 4.0 * PI * PI
const DAYS = 365.24

fn bodies() -> List[Body] {
    return [
        Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: SOLAR_MASS },
        Body { x: 4.84143144246472090, y: -1.16032004402742839, z: -0.103622044471123109, vx: 0.00166007664274403694 * DAYS, vy: 0.00769901118419740425 * DAYS, vz: -0.0000690460016972063023 * DAYS, mass: 0.000954791938424326609 * SOLAR_MASS },
        Body { x: 8.34336671824457987, y: 4.12479856412430479, z: -0.403523417114321381, vx: -0.00276742510726862411 * DAYS, vy: 0.00499852801234917238 * DAYS, vz: 0.0000230417297573763929 * DAYS, mass: 0.000285885980666130812 * SOLAR_MASS },
        Body { x: 12.8943695621391310, y: -15.1111514016986312, z: -0.223307578892655734, vx: 0.00296460137564761618 * DAYS, vy: 0.00237847173959480950 * DAYS, vz: -0.0000296589568540237556 * DAYS, mass: 0.0000436624404335156298 * SOLAR_MASS },
        Body { x: 15.3796971148509165, y: -25.9193146099879641, z: 0.179258772950371181, vx: 0.00268067772490389322 * DAYS, vy: 0.00162824170038242295 * DAYS, vz: -0.0000951592254519715870 * DAYS, mass: 0.0000515138902046611451 * SOLAR_MASS },
    ]
}

fn offset_momentum(bs: mut List[Body]) {
    var px = 0.0
    var py = 0.0
    var pz = 0.0
    for b in bs {
        px = px + b.vx * b.mass
        py = py + b.vy * b.mass
        pz = pz + b.vz * b.mass
    }
    bs[0].vx = 0.0 - px / SOLAR_MASS
    bs[0].vy = 0.0 - py / SOLAR_MASS
    bs[0].vz = 0.0 - pz / SOLAR_MASS
}

fn energy(bs: List[Body]) -> f64 {
    var e = 0.0
    for i, b in bs {
        e = e + 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
        var j = i + 1
        while j < bs.len() {
            let dx = b.x - bs[j].x
            let dy = b.y - bs[j].y
            let dz = b.z - bs[j].z
            e = e - b.mass * bs[j].mass / (dx * dx + dy * dy + dz * dz).sqrt()
            j = j + 1
        }
    }
    return e
}

fn advance(bs: mut List[Body], dt: f64) {
    var i = 0
    while i < bs.len() {
        var j = i + 1
        while j < bs.len() {
            let dx = bs[i].x - bs[j].x
            let dy = bs[i].y - bs[j].y
            let dz = bs[i].z - bs[j].z
            let squared = dx * dx + dy * dy + dz * dz
            let mag = dt / (squared * squared.sqrt())
            let mi = bs[i].mass
            let mj = bs[j].mass
            bs[i].vx = bs[i].vx - dx * mj * mag
            bs[i].vy = bs[i].vy - dy * mj * mag
            bs[i].vz = bs[i].vz - dz * mj * mag
            bs[j].vx = bs[j].vx + dx * mi * mag
            bs[j].vy = bs[j].vy + dy * mi * mag
            bs[j].vz = bs[j].vz + dz * mi * mag
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < bs.len() {
        bs[i].x = bs[i].x + dt * bs[i].vx
        bs[i].y = bs[i].y + dt * bs[i].vy
        bs[i].z = bs[i].z + dt * bs[i].vz
        i = i + 1
    }
}

fn scaled(x: f64) -> i64 {
    match (x * 1000000000.0).round().to_i64() {
        Some(n) => return n
        None => return 0
    }
}

fn main() {
    let steps = size(5000000, 20000)
    var bs = bodies()
    offset_momentum(mut bs)
    let before = scaled(energy(bs))
    var n = 0
    while n < steps {
        advance(mut bs, 0.01)
        n = n + 1
    }
    print(str(before) + " " + str(scaled(energy(bs))))
}
