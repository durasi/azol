// Measuring program: a recursive tree built from an enum, then walked.

enum Tree {
    Leaf(i64)
    Node(List[Tree])
}

fn build(depth: i64, seed: i64) -> Tree {
    if depth == 0 {
        return Leaf(seed)
    }
    var children: List[Tree] = []
    children.push(build(depth - 1, seed * 2))
    children.push(build(depth - 1, seed * 2 + 1))
    return Node(children)
}

fn sum(tree: Tree) -> i64 {
    match tree {
        Leaf(value) => return value
        Node(children) => {
            var total = 0
            for child in children {
                total = total + sum(child)
            }
            return total
        }
    }
}

fn main() {
    let tree = build(11, 1)
    var total = 0
    var round = 0
    while round < 4 {
        total = total + sum(tree)
        round = round + 1
    }
    print(total)
}
