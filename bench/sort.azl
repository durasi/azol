// Run-time benchmark: the same computation as bench/sort.rs.
// A hand-written quicksort over pseudo-random numbers.

fn quicksort(xs: mut List[i64], low: i64, high: i64) {
    if low >= high { return }
    let pivot = xs[(low + high) / 2]
    var i = low
    var j = high
    while i <= j {
        while xs[i] < pivot {
            i = i + 1
        }
        while xs[j] > pivot {
            j = j - 1
        }
        if i <= j {
            let held = xs[i]
            xs[i] = xs[j]
            xs[j] = held
            i = i + 1
            j = j - 1
        }
    }
    quicksort(mut xs, low, j)
    quicksort(mut xs, i, high)
}

fn main() {
    let count = 2000000
    var xs: List[i64] = []
    var seed = 42
    var n = 0
    while n < count {
        seed = seed * 48271 % 2147483647
        xs.push(seed % 1000000)
        n = n + 1
    }
    quicksort(mut xs, 0, count - 1)
    var checksum = 0
    var k = 0
    while k < count {
        checksum = checksum + xs[k] * (k % 7)
        k = k + 1000
    }
    var ordered = 1
    var m = 1
    while m < count {
        if xs[m - 1] > xs[m] { ordered = 0 }
        m = m + 1
    }
    print(checksum + ordered)
}
