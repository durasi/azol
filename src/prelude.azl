// The part of the standard library that is written in azoL. It is
// compiled together with every program.
//
// A function named `type_method` here becomes the method `method` of the
// type of its first parameter: `str_find` is what `text.find(part)` calls.
// These names are not visible to programs as plain functions.
//
// A function without type parameters is compiled into every program,
// used or not; one with type parameters only into the programs that
// use it, and there can be one such function for each method name.
// That is why most of the methods below take their receiver as a type
// parameter (`s: S` for a string, `n: N` for a number) although they
// work for one type only: a call on any other type is reported as an
// error that names the function. Only what other library functions call
// on a type parameter (`compare`) and the names that lists also use
// (`min`, `max`) are written without one.

// Where `part` first occurs in `s`, as a byte position.
fn str_find(s: str, part: str) -> Option[i64] {
    let n = part.len()
    if n > s.len() {
        return None
    }
    let last = s.len() - n
    var i = 0
    while i <= last {
        var j = 0
        while j < n && s[i + j] == part[j] {
            j = j + 1
        }
        if j == n {
            return Some(i)
        }
        i = i + 1
    }
    return None
}

fn str_contains(s: str, part: str) -> bool {
    match s.find(part) {
        Some(at) => return true
        None => return false
    }
}

fn str_starts_with(s: str, prefix: str) -> bool {
    let n = prefix.len()
    if n > s.len() {
        return false
    }
    var i = 0
    while i < n {
        if s[i] != prefix[i] {
            return false
        }
        i = i + 1
    }
    return true
}

fn str_ends_with(s: str, suffix: str) -> bool {
    let n = suffix.len()
    if n > s.len() {
        return false
    }
    let offset = s.len() - n
    var i = 0
    while i < n {
        if s[offset + i] != suffix[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// `s` without the spaces, tabs and line ends at its two ends.
fn str_trim(s: str) -> str {
    var start = 0
    var end = s.len()
    while start < end {
        let c = s[start]
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        start = start + 1
    }
    while end > start {
        let c = s[end - 1]
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        end = end - 1
    }
    return s.slice(start, end)
}

// The pieces of `s` between occurrences of `separator`. There is always
// at least one piece; an empty separator gives `s` whole.
fn str_split(s: str, separator: str) -> List[str] {
    var parts: List[str] = []
    let n = separator.len()
    var start = 0
    var i = 0
    while n > 0 && i + n <= s.len() {
        var j = 0
        while j < n && s[i + j] == separator[j] {
            j = j + 1
        }
        if j == n {
            parts.push(s.slice(start, i))
            i = i + n
            start = i
        } else {
            i = i + 1
        }
    }
    parts.push(s.slice(start, s.len()))
    return parts
}

// The lines of `s`, without their line ends. A final line end does not
// start one more, empty line.
fn str_lines(s: str) -> List[str] {
    var lines: List[str] = []
    var start = 0
    var i = 0
    while i < s.len() {
        if s[i] == 10 {
            var end = i
            if end > start && s[end - 1] == 13 {
                end = end - 1
            }
            lines.push(s.slice(start, end))
            start = i + 1
        }
        i = i + 1
    }
    if start < s.len() {
        lines.push(s.slice(start, s.len()))
    }
    return lines
}

// The number `s` spells in decimal digits, with an optional `-` in
// front. `None` when it is anything else or does not fit in `i64`.
fn str_to_i64(s: str) -> Option[i64] {
    var i = 0
    var negative = false
    if s.len() > 0 && s[0] == 45 {
        negative = true
        i = 1
    }
    if i == s.len() {
        return None
    }
    var value = 0
    while i < s.len() {
        let digit = s[i] - 48
        if digit < 0 || digit > 9 {
            return None
        }
        if value > (9223372036854775807 - digit) / 10 {
            return None
        }
        value = value * 10 + digit
        i = i + 1
    }
    if negative {
        return Some(-value)
    }
    return Some(value)
}

// The strings of `parts` in one string, with `separator` between them.
fn list_join(parts: List[str], separator: str) -> str {
    var out = ""
    for i, part in parts {
        if i > 0 {
            out = out + separator
        }
        out = out + part
    }
    return out
}

// Whether some item of `items` equals `wanted`.
fn list_contains[T](items: List[T], wanted: T) -> bool {
    for item in items {
        if item == wanted {
            return true
        }
    }
    return false
}

fn list_first[T](items: List[T]) -> Option[T] {
    if items.len() == 0 {
        return None
    }
    return Some(items[0])
}

fn list_last[T](items: List[T]) -> Option[T] {
    if items.len() == 0 {
        return None
    }
    return Some(items[items.len() - 1])
}

// The items of `items` in the opposite order, as a new list.
fn list_reversed[T](items: List[T]) -> List[T] {
    var out: List[T] = []
    var i = items.len()
    while i > 0 {
        i = i - 1
        out.push(items[i])
    }
    return out
}

// -1 when `s` comes before `other` in byte order, 1 when it comes
// after, 0 when they are equal. A string comes after its own beginnings.
fn str_compare(s: str, other: str) -> i64 {
    var n = s.len()
    if other.len() < n {
        n = other.len()
    }
    var i = 0
    while i < n {
        if s[i] != other[i] {
            if s[i] < other[i] {
                return -1
            }
            return 1
        }
        i = i + 1
    }
    if s.len() < other.len() {
        return -1
    }
    if s.len() > other.len() {
        return 1
    }
    return 0
}

// Where `part` first occurs in `s` at byte position `start` or later.
// A `start` below zero counts as zero.
fn str_index_of_from[S](s: S, part: str, start: i64) -> Option[i64] {
    let n = part.len()
    var i = start
    if i < 0 {
        i = 0
    }
    while i + n <= s.len() {
        var j = 0
        while j < n && s[i + j] == part[j] {
            j = j + 1
        }
        if j == n {
            return Some(i)
        }
        i = i + 1
    }
    return None
}

// Where `part` last occurs in `s`, as a byte position.
fn str_last_index_of[S](s: S, part: str) -> Option[i64] {
    let n = part.len()
    var i = s.len() - n
    while i >= 0 {
        var j = 0
        while j < n && s[i + j] == part[j] {
            j = j + 1
        }
        if j == n {
            return Some(i)
        }
        i = i - 1
    }
    return None
}

// `s` with every occurrence of `old` replaced by `new`, looking from
// left to right. An empty `old` gives `s` unchanged.
fn str_replace[S](s: S, old: str, new: str) -> str {
    let n = old.len()
    if n == 0 {
        return s
    }
    var out = ""
    var start = 0
    var i = 0
    while i + n <= s.len() {
        var j = 0
        while j < n && s[i + j] == old[j] {
            j = j + 1
        }
        if j == n {
            out = out + s.slice(start, i)
            out = out + new
            i = i + n
            start = i
        } else {
            i = i + 1
        }
    }
    out = out + s.slice(start, s.len())
    return out
}

// `s` written `count` times in a row; the empty string when `count`
// is zero or less.
fn str_repeat[S](s: S, count: i64) -> str {
    var out = ""
    var i = 0
    while i < count {
        out = out + s
        i = i + 1
    }
    return out
}

// `s` with the letters `a` to `z` turned into `A` to `Z`. Other bytes
// stay as they are.
fn str_to_upper[S](s: S) -> str {
    var out = ""
    var i = 0
    while i < s.len() {
        var c = s[i]
        if c >= 97 && c <= 122 {
            c = c - 32
        }
        out = out + chr(c)
        i = i + 1
    }
    return out
}

// `s` with the letters `A` to `Z` turned into `a` to `z`. Other bytes
// stay as they are.
fn str_to_lower[S](s: S) -> str {
    var out = ""
    var i = 0
    while i < s.len() {
        var c = s[i]
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        out = out + chr(c)
        i = i + 1
    }
    return out
}

// `s` with copies of `fill` put in front until it is at least `width`
// bytes long. An empty `fill` gives `s` unchanged.
fn str_pad_left[S](s: S, width: i64, fill: str) -> str {
    var front = ""
    while fill.len() > 0 && front.len() + s.len() < width {
        front = front + fill
    }
    return front + s
}

// `s` with copies of `fill` put after it until it is at least `width`
// bytes long. An empty `fill` gives `s` unchanged.
fn str_pad_right[S](s: S, width: i64, fill: str) -> str {
    var out = s
    while fill.len() > 0 && out.len() < width {
        out = out + fill
    }
    return out
}

// The bytes of `s`, each a number from 0 to 255.
fn str_bytes[S](s: S) -> List[i64] {
    var out: List[i64] = []
    var i = 0
    while i < s.len() {
        out.push(s[i])
        i = i + 1
    }
    return out
}

// The number `s` spells in one to sixteen hexadecimal digits, in small
// or capital letters; sixteen digits fill all 64 bits. `None` when it
// is anything else.
fn str_parse_hex[S](s: S) -> Option[i64] {
    if s.len() == 0 || s.len() > 16 {
        return None
    }
    var value = 0
    var i = 0
    while i < s.len() {
        let c = s[i]
        var digit = -1
        if c >= 48 && c <= 57 {
            digit = c - 48
        }
        if c >= 97 && c <= 102 {
            digit = c - 87
        }
        if c >= 65 && c <= 70 {
            digit = c - 55
        }
        if digit < 0 {
            return None
        }
        value = (value << 4) | digit
        i = i + 1
    }
    return Some(value)
}

// The string whose bytes are `bytes`. Each must be from 0 to 255;
// the program stops with an error otherwise.
fn list_to_str[T](bytes: List[T]) -> str {
    var out = ""
    for byte in bytes {
        out = out + chr(byte)
    }
    return out
}

// The numbers of `items` added up; zero for an empty list.
fn list_sum[T](items: List[T]) -> i64 {
    var total = 0
    for item in items {
        total = total + item
    }
    return total
}

// Whether `items`, a string or a list, has nothing in it.
fn any_is_empty[T](items: T) -> bool {
    return items.len() == 0
}

// The position of the first item of `items` that equals `wanted`.
fn list_index_of[T](items: List[T], wanted: T) -> Option[i64] {
    for i, item in items {
        if item == wanted {
            return Some(i)
        }
    }
    return None
}

// How many items of `items` equal `wanted`.
fn list_count[T](items: List[T], wanted: T) -> i64 {
    var found = 0
    for item in items {
        if item == wanted {
            found = found + 1
        }
    }
    return found
}

// The first `count` items of `items` as a new list; all of them when
// there are fewer, none when `count` is zero or less.
fn list_take[T](items: List[T], count: i64) -> List[T] {
    var out: List[T] = []
    var i = 0
    while i < count && i < items.len() {
        out.push(items[i])
        i = i + 1
    }
    return out
}

// The items of `items` after the first `count`, as a new list; all of
// them when `count` is zero or less.
fn list_skip[T](items: List[T], count: i64) -> List[T] {
    var out: List[T] = []
    var i = count
    if i < 0 {
        i = 0
    }
    while i < items.len() {
        out.push(items[i])
        i = i + 1
    }
    return out
}

// The smallest item of `items` by `compare`: for numbers and strings.
// The first one when several are equal; `None` for an empty list.
fn list_min[T](items: List[T]) -> Option[T] {
    if items.len() == 0 {
        return None
    }
    var best = 0
    var i = 1
    while i < items.len() {
        if items[i].compare(items[best]) < 0 {
            best = i
        }
        i = i + 1
    }
    return Some(items[best])
}

// The largest item of `items` by `compare`: for numbers and strings.
// The first one when several are equal; `None` for an empty list.
fn list_max[T](items: List[T]) -> Option[T] {
    if items.len() == 0 {
        return None
    }
    var best = 0
    var i = 1
    while i < items.len() {
        if items[i].compare(items[best]) > 0 {
            best = i
        }
        i = i + 1
    }
    return Some(items[best])
}

// The items of `items` from smallest to largest by `compare`, as a new
// list: for numbers and strings. Equal items keep their order. It
// merges runs of 1, 2, 4, ... items, so the work grows as n log n.
fn list_sorted[T](items: List[T]) -> List[T] {
    var from = items
    let n = from.len()
    var width = 1
    while width < n {
        var to: List[T] = []
        var start = 0
        while start < n {
            var middle = start + width
            if middle > n {
                middle = n
            }
            var end = middle + width
            if end > n {
                end = n
            }
            var a = start
            var b = middle
            while a < middle && b < end {
                if from[b].compare(from[a]) < 0 {
                    to.push(from[b])
                    b = b + 1
                } else {
                    to.push(from[a])
                    a = a + 1
                }
            }
            while a < middle {
                to.push(from[a])
                a = a + 1
            }
            while b < end {
                to.push(from[b])
                b = b + 1
            }
            start = end
        }
        from = to
        width = width * 2
    }
    return from
}

// -1 when `n` is less than `other`, 1 when it is greater, 0 when they
// are equal.
fn i64_compare(n: i64, other: i64) -> i64 {
    if n < other {
        return -1
    }
    if n > other {
        return 1
    }
    return 0
}

// `n` without its sign. The smallest `i64` has no positive twin and
// stays as it is.
fn i64_abs[N](n: N) -> i64 {
    if n < 0 {
        return -n
    }
    return n
}

// The smaller of `n` and `other`.
fn i64_min(n: i64, other: i64) -> i64 {
    if other < n {
        return other
    }
    return n
}

// The larger of `n` and `other`.
fn i64_max(n: i64, other: i64) -> i64 {
    if other > n {
        return other
    }
    return n
}

// `n`, or `low` when it is below `low`, or `high` when it is above
// `high`.
fn i64_clamp[N](n: N, low: i64, high: i64) -> i64 {
    if n < low {
        return low
    }
    if n > high {
        return high
    }
    return n
}

// `n` multiplied by itself `exponent` times, wrapping around like all
// arithmetic; 1 when `exponent` is zero or less.
fn i64_pow[N](n: N, exponent: i64) -> i64 {
    var result = 1
    var base = n
    var left = exponent
    while left > 0 {
        if left & 1 == 1 {
            result = result * base
        }
        base = base * base
        left = left >> 1
    }
    return result
}

// The 64 bits of `n` in hexadecimal digits with small letters and no
// zeros in front: 255 gives `ff`, -1 gives sixteen `f`.
fn i64_to_hex[N](n: N) -> str {
    var out = ""
    var shift = 60
    while shift >= 0 {
        let digit = (n >> shift) & 15
        if digit != 0 || out.len() > 0 || shift == 0 {
            if digit < 10 {
                out = out + chr(48 + digit)
            } else {
                out = out + chr(87 + digit)
            }
        }
        shift = shift - 4
    }
    return out
}
